<!doctype html>
<html lang="en-IN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#08080b">
<meta name="color-scheme" content="dark">

<title>Navratri 2026 Ahmedabad Garba Events &amp; Passes | Scenezy</title>
<meta name="description" content="Discover Navratri 2026 Garba events in Ahmedabad. Compare venues, dates, locations and pass prices, save favourite events and book Garba passes with Scenezy.">

<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
<meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
<meta name="author" content="Scenezy">

<link rel="icon" type="image/png" href="/scenezy-logo.png">
<link rel="apple-touch-icon" href="/scenezy-logo.png">

<!-- Social & SEO Meta -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="Scenezy">
<meta property="og:url" content="https://scenezy.in/">
<meta property="og:title" content="Navratri 2026 Ahmedabad Garba Events &amp; Passes | Scenezy">
<meta property="og:description" content="Discover Navratri 2026 Garba events in Ahmedabad. Compare venues, dates, locations and pass prices.">
<meta property="og:image" content="https://scenezy.in/garba_golden_bg.jpg">
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Outfit:wght@300..800&display=swap" rel="stylesheet">

<style>
/* =========================================================
   BASE STYLES (TERA ORIGINAL CSS)
========================================================= */
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
:root {
  --bg: #08080b; --panel: #111116; --panel2: #18181f; --panel3: #202029; --raise: #272731;
  --ink: #f3ecdd; --ink2: #fff9ee; --dim: #aaa4b0; --faint: #716c78;
  --line: rgba(243, 236, 221, .08); --line2: rgba(243, 236, 221, .17);
  --blue: #3157ed; --blue2: #2545c8; --gold: #ddb454;
  --paper: #f1ead9; --paper-ink: #2b251d; --paper-dim: #887e70;
  --serif: "Fraunces", Georgia, serif; --sans: "Outfit", system-ui, sans-serif;
  --safe-top: env(safe-area-inset-top, 0px); --safe-bottom: env(safe-area-inset-bottom, 0px);
}
html, body { width: 100%; height: 100%; }
body { display: flex; justify-content: center; align-items: center; overflow: hidden; overscroll-behavior: none; background: linear-gradient(rgba(4,4,7,.72), rgba(4,4,7,.93)), url("/garba_golden_bg.jpg") center / cover fixed; color: var(--ink); font-family: var(--sans); }
button, input { font: inherit; }
button { border: 0; background: none; color: inherit; cursor: pointer; }
svg { display: block; }
[hidden] { display: none !important; }
.ic { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
.fillIcon { fill: currentColor; stroke: none; }

/* AD BOX STYLING */
.scenezy-ad-box { display: flex; justify-content: center; margin: 18px 0; padding: 8px; background: rgba(255,255,255,0.02); border-radius: 12px; overflow: hidden; width: 100%; min-height: 50px; }

#app { position: relative; width: 100%; max-width: 460px; height: 100dvh; overflow: hidden; isolation: isolate; background: linear-gradient(180deg, rgba(10,10,14,.89), rgba(10,10,14,.97)); }
#app::before { content: ""; position: absolute; inset: 0; z-index: -3; background: url("/garba_golden_bg.jpg") center / cover; opacity: .16; filter: saturate(.9) contrast(1.08); }
#app::after { content: ""; position: absolute; inset: 0; z-index: -2; pointer-events: none; background: radial-gradient(circle at 50% 17%, rgba(52,84,225,.17), transparent 31% ), linear-gradient(180deg, rgba(8,8,11,.15), rgba(8,8,11,.89)); }

/* OTHER APP CSS COMPONENTS (Omitted for brevity, paste your original ones here or keep the external scenezy-ui.css) */
/* (Tujhe bas original index.html ka pura style block yahan rakhna hai, maine social bar aur boxes ke liye CSS upar de diya hai) */

/* SEO & App Layers (Pehle wala logic) */
.seoHomeTitle { position: absolute !important; width: 1px !important; height: 1px !important; padding: 0 !important; margin: -1px !important; overflow: hidden !important; clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; border: 0 !important; }
.scenezyLoader { position: fixed; inset: 0; z-index: 99999; display: grid; place-items: center; background: #050507; transition: opacity .68s ease, visibility 0s .68s; }
.scenezyLoader.hide { opacity: 0; visibility: hidden; pointer-events: none; }
.loaderVideo { width: min(74vw, 300px); height: auto; border-radius: 22px; box-shadow: 0 22px 70px rgba(0,0,0,.36); }
.top { position: relative; z-index: 50; display: flex; align-items: center; gap: 10px; padding: calc(14px + var(--safe-top)) 17px 5px; }
.logo { width: 40px; height: 40px; object-fit: contain; }
.wordmark { font: italic 500 21px/1 var(--serif); letter-spacing: -.025em; }
.grow { flex: 1; }
.iconBtn { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; color: var(--dim); border: 1px solid var(--line2); background: rgba(24,24,31,.72); backdrop-filter: blur(15px); }
.home { position: absolute; inset: 0; display: flex; flex-direction: column; padding-bottom: calc(84px + var(--safe-bottom)); }
.homeIntro { position: relative; z-index: 20; text-align: center; padding: 5px 15px 0; }
.kicker { color: var(--faint); font-size: 9px; font-weight: 700; letter-spacing: .27em; text-transform: uppercase; }
.homeTitleWrap { position: relative; min-height: 78px; display: flex; align-items: center; justify-content: center; margin-top: 3px; }
.homeTitle { color: var(--ink2); font: italic 500 clamp(28px,8.5vw,40px)/.99 var(--serif); text-wrap: balance; }
.stage { position: relative; flex: 1; min-height: 0; margin-top: 4px; touch-action: none; user-select: none; }
.deck { position: absolute; inset: 0; }
.tabbar { position: absolute; left: 50%; bottom: calc(13px + var(--safe-bottom)); z-index: 200; transform: translateX(-50%); display: flex; gap: 4px; padding: 5px; border-radius: 999px; border: 1px solid var(--line2); background: rgba(24,24,31,.91); backdrop-filter: blur(18px); box-shadow: 0 11px 32px rgba(0,0,0,.38); }
.tab { width: 52px; height: 43px; display: grid; place-items: center; border-radius: 999px; color: var(--dim); transition: background .25s; }
.tab.on { color: white; background: linear-gradient(145deg, #3d62f1, #2949ce); }
.tabBadge { position: absolute; right: 5px; top: 4px; display: none; min-width: 14px; height: 14px; border-radius: 999px; background: var(--gold); font-size: 8px; font-weight: 800; color: #171208; }
.tabBadge.show { display: grid; }
.screen { position: absolute; inset: 0; z-index: 140; display: flex; flex-direction: column; visibility: hidden; opacity: 0; transform: translateY(13px); background: linear-gradient(rgba(16,16,21,.94), rgba(16,16,21,.99)); transition: opacity .35s, transform .4s; }
.screen.open { visibility: visible; opacity: 1; transform: none; }
.detail { position: absolute; inset: 0; z-index: 250; display: flex; flex-direction: column; visibility: hidden; transform: translateY(103%); background: var(--panel); transition: transform .55s; }
.detail.open { visibility: visible; transform: none; }
/* ... (Baki saara CSS copy-paste kar lena scenezy-ui.css se) ... */
</style>
</head>

<body>

<div class="scenezyLoader" id="scenezyLoader">
  <video class="loaderVideo" id="loaderVideo" src="/loader-video.mp4" autoplay muted playsinline preload="auto"></video>
</div>

<div id="app">
<div class="cloudPulse" id="cloudPulse">Refreshing events</div>

<!-- HOME -->
<main class="home">
  <header class="top">
    <img class="logo" src="/scenezy-logo.png" alt="Scenezy">
    <div class="wordmark">scenezy</div>
    <div class="grow"></div>
    <button class="iconBtn" id="headerSearch" aria-label="Search events">
      <svg class="ic" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg>
    </button>
  </header>
  <section class="homeIntro">
    <h1 class="seoHomeTitle">Navratri 2026 Ahmedabad Garba Events &amp; Passes</h1>
    <p class="kicker" id="homeKicker"></p>
    <div class="homeTitleWrap"><h2 class="homeTitle" id="homeTitle">—</h2></div>
  </section>
  <section class="stage" id="stage">
    <div class="deck" id="deck"></div>
    <div class="swipeHint" id="swipeHint">swipe · tap to enter</div>
    <div class="deckControls">
      <button class="deckArrow" id="prevBtn"><svg class="ic" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"></path></svg></button>
      <div class="deckDots" id="deckDots"></div>
      <button class="deckArrow" id="nextBtn"><svg class="ic" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg></button>
    </div>
  </section>
</main>

<!-- TAB BAR -->
<nav class="tabbar">
  <button class="tab on" data-tab="home"><svg class="ic" viewBox="0 0 24 24"><path d="M4 11l8-7 8 7"></path><path d="M6 9.5V20h12V9.5"></path></svg></button>
  <button class="tab" data-tab="search"><svg class="ic" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg></button>
  <button class="tab" data-tab="passes"><svg class="ic" viewBox="0 0 24 24"><path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4z"></path><path d="M14 6v12" stroke-dasharray="2 3"></path></svg><span class="tabBadge" id="passBadge"></span></button>
</nav>

<!-- DETAIL VIEW -->
<section class="detail" id="detail">
  <div class="detailButtons">
    <button class="iconBtn detailBackBtn" id="detailBack"><svg class="ic" viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"></path></svg></button>
    <button class="iconBtn shareBtn" id="detailShare"><svg class="ic" viewBox="0 0 24 24"><path d="M12 15V3"></path><path d="M8 7l4-4 4 4"></path><path d="M6 10H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2h-1"></path></svg></button>
  </div>
  <div class="detailBody" id="detailBody">
    <div class="detailPoster" id="detailPoster"></div>
    <div class="detailContent">
      <h2 class="detailTitle" id="detailTitle"></h2>
      <p class="detailTagline" id="detailTagline"></p>
      <div class="facts" id="facts"></div>

      <!-- Detail Ad Slot (Banner 320x50) -->
      <div class="scenezy-ad-box">
          <script type="text/javascript">
            atOptions = { 'key' : '427fd607ee2928a1b0ba64615abf9ae5', 'format' : 'iframe', 'height' : 50, 'width' : 320, 'params' : {} };
          </script>
          <script type="text/javascript" src="//www.highrevenueformat.com/427fd607ee2928a1b0ba64615abf9ae5/invoke.js"></script>
      </div>

      <div class="sectionLabel">choose your night</div>
      <div id="nightArea"></div>
      <div class="sectionLabel">pass type</div>
      <div class="passList" id="passList"></div>
      <div class="sectionLabel">summary</div>
      <div class="summary"><span id="summaryText">—</span><strong id="summaryTotal">—</strong></div>
    </div>
  </div>
  <div class="detailCTA">
    <button class="detailSave" id="detailSave"><svg class="ic" viewBox="0 0 24 24"><path d="M6 4h12v17l-6-4-6 4z"></path></svg><span class="saveLabel" id="detailSaveLabel">Save</span></button>
    <button class="whatsappBtn" id="bookBtn"><span id="bookBtnText">Book on WhatsApp</span></button>
  </div>
</section>

<!-- (Baki Screens jaise Search, Landing, Receipt waise hi rakhein) -->
<!-- Main Script Logic -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
/* =========================================================
   SCENEZY CORE LOGIC (VITAL FUNCTIONS)
========================================================= */
const SCENEZY = { whatsapp: "919265461135", city: "Ahmedabad", season: "Navratri 2026", events: [] };
const SUPABASE_CONFIG = { url: "https://hpvsemxmaesprrnwyuqw.supabase.co", publishableKey: "sb_publishable_zs_CKudUqZNeZmbr3EvXpQ_fn1p1zwf" };
const sb = window.supabase ? window.supabase.createClient(SUPABASE_CONFIG.url, SUPABASE_CONFIG.publishableKey) : null;
const STORAGE = { saved: "scenezy.saved.events.v5", ratings: "scenezy.ratings.v5", pending: "scenezy.pending.booking.v5" };
const state = { position: 0, active: 0, current: null, selectedNight: {}, selectedPass: {}, quantity: {}, saved: new Set(), drag: null, motionId: 0, lastTicket: null };
let EVENTS = []; let TOTAL = 0;

const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];

// LOAD SAVED - Important Fixed function
function loadSaved() {
  try {
    state.saved = new Set(JSON.parse(localStorage.getItem(STORAGE.saved)) || []);
  } catch {
    state.saved = new Set();
  }
  updatePassBadge();
}

function persistSaved() { localStorage.setItem(STORAGE.saved, JSON.stringify([...state.saved])); }
function isSaved(id) { return state.saved.has(id); }
function updatePassBadge() { const b = $("#passBadge"); if(b) { b.textContent = state.saved.size; b.classList.toggle("show", state.saved.size > 0); } }

// DECK BUILDING
function buildDeck() {
  const d = $("#deck"); if(!d) return; d.innerHTML = ""; $("#deckDots").innerHTML = "";
  EVENTS.forEach((ev, i) => {
    const card = document.createElement("article"); card.className = "eventCard"; card.dataset.index = i;
    card.innerHTML = `
      <div class="posterWrap">${posterHTML(ev)}</div>
      <div class="cardBody"><h2 class="cardTitle">${ev.name}</h2><p class="cardPlace">${ev.venue} · ${ev.area}</p></div>
    `;
    d.appendChild(card);
  });
  renderDeck(state.position);
}

function renderDeck(pos) {
  const cards = $$(".eventCard");
  cards.forEach((card, i) => {
    const offset = i - pos;
    card.style.transform = `translate(calc(-50% + ${offset * 105}%), -50%) scale(${1 - Math.abs(offset) * 0.1})`;
    card.style.opacity = 1 - Math.abs(offset) * 0.3;
    card.style.zIndex = 100 - Math.abs(Math.round(offset));
  });
}

function posterHTML(ev) {
  return `<div class="poster" style="background: linear-gradient(145deg, ${ev.poster.a}, ${ev.poster.b});">
    ${ev.image ? `<img src="${ev.image}" class="posterImage">` : ''}
  </div>`;
}

// ROUTING & LANDING (Adsterra Native Ad Integrated)
const SCENEZY_LANDING_ROUTES = { "/gerba-events-ahmedabad": { mode: "events", heading: "Ahmedabad Garba Events", eyebrow: "2026", lead: "Listings", listTitle: "Live events", guideTitle: "Guide", guide: [], faqs: [] } };

function renderLandingPage(path) {
  const route = SCENEZY_LANDING_ROUTES[path]; if(!route) return;
  let html = "";
  EVENTS.forEach((ev, idx) => {
    html += `<a href="#" class="landingEvent" onclick="openDetailById('${ev.id}')"><strong>${ev.name}</strong></a>`;
    // Subtle Native Ad after 2nd event
    if (idx === 1) {
       html += `<div class="scenezy-ad-box" style="border: 1px dashed var(--line2);">
         <script async="async" data-cfasync="false" src="https://pl31603416.profitableratecpmnetwork.com/a3fec00a3136a62c3f64dab87ada59cb/invoke.js"><\/script>
         <div id="container-a3fec00a3136a62c3f64dab87ada59cb"></div>
       </div>`;
    }
  });
  $("#landingResults").innerHTML = html;
  $("#landingScreen").classList.add("open");
}

function openDetail(ev) {
  state.current = ev; $("#detailTitle").textContent = ev.name; $("#detailTagline").textContent = ev.tagline;
  $("#detail").classList.add("open");
}

async function fetchScenezyFromSupabase() {
  if(!sb) return;
  const { data } = await sb.from("events").select("*").eq("visible", true);
  if(data) { EVENTS = data.map(r => ({...r.data, id: r.id})); TOTAL = EVENTS.length; buildDeck(); }
}

function boot() {
  loadSaved(); // Pehle ye call ho raha tha par defined nahi tha
  fetchScenezyFromSupabase();
  $("#homeKicker").textContent = `${SCENEZY.season} · ${SCENEZY.city}`;
}

boot();
</script>

<!-- SOCIAL BAR (SABSE ZYADA REVENUE) -->
<script src="https://pl31603417.profitableratecpmnetwork.com/29/75/b2/2975b2cd772db6eaed57f53f9372892e.js"></script>

</body>
</html>