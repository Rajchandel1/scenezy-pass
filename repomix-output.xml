let adminSyncTimer = null;

let adminSyncInFlight = false;

let adminRealtimeChannel = null;

let adminRealtimeTimer = null;


async function currentAdminSession() {

  if (
    !sbAdmin
  ) {
    return null;
  }


  const {
    data,
    error
  } =
    await sbAdmin.auth.getSession();


  if (
    error
  ) {
    return null;
  }


  return data.session ||
    null;
}


async function syncDatabaseToSupabase() {

  if (
    !sbAdmin ||
    adminSyncInFlight
  ) {
    return false;
  }


  const session =
    await currentAdminSession();


  if (
    !session
  ) {
    return false;
  }


  adminSyncInFlight =
    true;


  setCloudStatus(
    "syncing",
    "Syncing…"
  );


  try {

    const eventRows =
      database.events.map(
        eventToSupabaseRow
      );


    if (
      eventRows.length
    ) {

      const {
        error
      } =
        await sbAdmin
          .from(
            "events"
          )
          .upsert(
            eventRows,
            {
              onConflict:
                "id"
            }
          );


      if (
        error
      ) {
        throw error;
      }

    }


    const {
      error:
        settingsError
    } =
      await sbAdmin
        .from(
          "settings"
        )
        .upsert(
          {
            id:
              "scenezy",

            whatsapp:
              database.settings.whatsapp ||
              "",

            city:
              database.settings.city ||
              "Ahmedabad",

            season:
              database.settings.season ||
              "Navratri 2026",

            updated_at:
              new Date()
                .toISOString()
          },
          {
            onConflict:
              "id"
          }
        );


    if (
      settingsError
    ) {
      throw settingsError;
    }


    if (
      database.leads.length
    ) {

      const {
        error:
          leadsError
      } =
        await sbAdmin
          .from(
            "leads"
          )
          .upsert(
            database.leads.map(
              leadToSupabaseRow
            ),
            {
              onConflict:
                "id"
            }
          );


      if (
        leadsError
      ) {
        throw leadsError;
      }

    }


    if (
      database.activity.length
    ) {

      const {
        error:
          activityError
      } =
        await sbAdmin
          .from(
            "activity_log"
          )
          .upsert(
            database.activity
              .slice(
                0,
                100
              )
              .map(
                activityToSupabaseRow
              ),
            {
              onConflict:
                "id"
            }
          );


      if (
        activityError
      ) {
        throw activityError;
      }

    }


    setCloudStatus(
      "live",
      "Cloud live"
    );


    return true;

  } catch (
    error
  ) {

    console.error(
      "Supabase admin sync failed",
      error
    );


    setCloudStatus(
      "error",
      "Cloud retry"
    );


    toast(
      "Saved locally · cloud sync will retry"
    );


    return false;

  } finally {

    adminSyncInFlight =
      false;

  }

}


function queueSupabaseSync() {

  if (
    !sbAdmin
  ) {
    return;
  }


  clearTimeout(
    adminSyncTimer
  );


  adminSyncTimer =
    setTimeout(
      () => {

        syncDatabaseToSupabase();

      },
      180
    );

}


function saveDatabase({
  sync = true
} = {}) {

  const cached =
    cacheDatabase();


  if (
    !cached
  ) {

    toast(
      "Could not update local cache"
    );

  }


  renderAll();


  if (
    sync
  ) {

    queueSupabaseSync();

  }


  return cached;

}


async function deleteEventFromSupabase(
  id
) {

  if (
    !sbAdmin
  ) {
    return;
  }


  try {

    const {
      error
    } =
      await sbAdmin
        .from(
          "events"
        )
        .delete()
        .eq(
          "id",
          id
        );


    if (
      error
    ) {
      throw error;
    }

  } catch (
    error
  ) {

    console.error(
      "Remote event deletion failed",
      error
    );


    toast(
      "Deleted locally · cloud delete needs retry"
    );

  }

}


async function seedSupabaseIfEmpty() {

  if (
    !sbAdmin
  ) {
    return;
  }


  const {
    count,
    error
  } =
    await sbAdmin
      .from(
        "events"
      )
      .select(
        "id",
        {
          count:
            "exact",
          head:
            true
        }
      );


  if (
    error
  ) {
    throw error;
  }


  if (
    Number(
      count ||
      0
    ) >
    0
  ) {
    return;
  }


  /*
     First cloud launch:
     migrate the CURRENT local cache (including any work
     already done in the prototype), rather than replacing it
     with fresh seed data.
  */

  await migrateInlineImagesToStorage();


  cacheDatabase();


  await syncDatabaseToSupabase();

}


async function hydrateAdminFromSupabase({
  quiet = false
} = {}) {

  if (
    !sbAdmin
  ) {
    return false;
  }


  const session =
    await currentAdminSession();


  if (
    !session
  ) {
    return false;
  }


  if (
    !quiet
  ) {

    setCloudStatus(
      "syncing",
      "Loading…"
    );

  }


  try {

    const [
      eventsResult,
      settingsResult,
      leadsResult,
      activityResult
    ] =
      await Promise.all([

        sbAdmin
          .from(
            "events"
          )
          .select(
            "id,data,visible,admin_notes,sort_order,created_at,updated_at"
          )
          .order(
            "sort_order",
            {
              ascending: true
            }
          ),


        sbAdmin
          .from(
            "settings"
          )
          .select(
            "id,whatsapp,city,season,updated_at"
          )
          .eq(
            "id",
            "scenezy"
          )
          .maybeSingle(),


        sbAdmin
          .from(
            "leads"
          )
          .select(
            "id,event_id,event_name,booking_ref,night,pass_name,quantity,expected_amount,source,status,revenue,clicked_at,converted_at,updated_at"
          )
          .order(
            "clicked_at",
            {
              ascending: false
            }
          ),


        sbAdmin
          .from(
            "activity_log"
          )
          .select(
            "id,type,text,created_at"
          )
          .order(
            "created_at",
            {
              ascending: false
            }
          )
          .limit(
            100
          )

      ]);


    for (
      const result
      of [
        eventsResult,
        settingsResult,
        leadsResult,
        activityResult
      ]
    ) {

      if (
        result.error
      ) {
        throw result.error;
      }

    }


    database =
      normalizeDatabase({

        version: 2,

        settings: {

          whatsapp:
            settingsResult.data
              ?.whatsapp ||
            ADMIN_CONFIG.bookingWhatsapp,

          city:
            settingsResult.data
              ?.city ||
            "Ahmedabad",

          season:
            settingsResult.data
              ?.season ||
            "Navratri 2026"

        },

        events:
          (
            eventsResult.data ||
            []
          )
          .map(
            eventFromSupabaseRow
          ),

        leads:
          (
            leadsResult.data ||
            []
          )
          .map(
            leadFromSupabaseRow
          ),

        activity:
          (
            activityResult.data ||
            []
          )
          .map(
            activityFromSupabaseRow
          ),

        updatedAt:
          Date.now()

      });


    cacheDatabase();

    renderAll();


    setCloudStatus(
      "live",
      "Cloud live"
    );


    return true;

  } catch (
    error
  ) {

    console.error(
      "Supabase hydrate failed",
      error
    );


    setCloudStatus(
      "error",
      "Using cache"
    );


    if (
      !quiet
    ) {

      toast(
        "Cloud unavailable · using local cache"
      );

    }


    return false;

  }

}


function scheduleAdminRealtimeRefresh() {

  clearTimeout(
    adminRealtimeTimer
  );


  adminRealtimeTimer =
    setTimeout(
      () => {

        hydrateAdminFromSupabase({
          quiet: true
        });

      },
      180
    );

}


function startAdminRealtime() {

  if (
    !sbAdmin ||
    adminRealtimeChannel
  ) {
    return;
  }


  adminRealtimeChannel =
    sbAdmin
      .channel(
        "scenezy-admin-live"
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "events"
        },
        scheduleAdminRealtimeRefresh
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "settings"
        },
        scheduleAdminRealtimeRefresh
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "leads"
        },
        scheduleAdminRealtimeRefresh
      )
      .subscribe();

}


function structuredCloneSafe(
  value
) {

  return JSON.parse(
    JSON.stringify(
      value
    )
  );

}


/* =========================================================
   NORMALIZATION
========================================================= */

function normalizeEvent(
  event
) {

  return {

    id:
      event.id ||
      slugify(
        event.name ||
        "event"
      ),

    name:
      event.name ||
      "Untitled Event",

    tagline:
      event.tagline ||
      "",

    venue:
      event.venue ||
      "",

    area:
      event.area ||
      "",

    address:
      event.address ||
      "",

    mapUrl:
      event.mapUrl ||
      "",

    dateLabel:
      event.dateLabel ||
      "",

    startDate:
      event.startDate ||
      null,

    endDate:
      event.endDate ||
      null,

    image:
      event.image ||
      "",

    poster: {
      a:
        event.poster?.a ||
        "#31458f",

      b:
        event.poster?.b ||
        "#141a49",

      ink:
        event.poster?.ink ||
        "#f4ebda"
    },

    defaultPasses:
      (
        event.defaultPasses ||
        []
      )
      .map(
        normalizePass
      ),

    passesByDate:
      Object.fromEntries(

        Object.entries(
          event.passesByDate ||
          {}
        )
        .map(
          (
            [
              date,
              passes
            ]
          ) => [

            date,

            (
              passes ||
              []
            )
            .map(
              normalizePass
            )

          ]
        )
      ),

    visible:
      event.visible !==
      false,

    adminNotes:
      event.adminNotes ||
      "",

    createdAt:
      event.createdAt ||
      Date.now(),

    updatedAt:
      event.updatedAt ||
      Date.now()

  };

}


function normalizePass(
  pass
) {

  return {

    id:
      pass.id ||
      slugify(
        pass.name ||
        "pass"
      ),

    name:
      pass.name ||
      "Regular",

    note:
      pass.note ||
      "",

    price:
      pass.price ===
      null ||
      pass.price ===
      undefined ||
      pass.price ===
      ""
      ?
      null
      :
      Number(
        pass.price
      )

  };

}


/* =========================================================
   GENERAL HELPERS
========================================================= */

function uid() {

  return (
    Date.now()
      .toString(36) +
    Math.random()
      .toString(36)
      .slice(
        2,
        8
      )
  );

}


function slugify(
  value
) {

  return String(
    value ||
    ""
  )
  .trim()
  .toLowerCase()
  .replace(
    /[^a-z0-9]+/g,
    "-"
  )
  .replace(
    /^-+|-+$/g,
    ""
  );

}


function escapeHTML(
  value
) {

  return String(
    value ??
    ""
  )
  .replace(
    /[&<>"']/g,

    character =>
      ({

        "&":
          "&amp;",

        "<":
          "&lt;",

        ">":
          "&gt;",

        '"':
          "&quot;",

        "'":
          "&#39;"

      }[
        character
      ])
  );

}


function money(
  amount
) {

  if (
    amount ===
    null ||
    amount ===
    undefined
  ) {

    return "TBA";

  }


  return (
    "₹" +
    Number(
      amount
    )
    .toLocaleString(
      "en-IN"
    )
  );

}


function formatDateTime(
  timestamp
) {

  if (
    !timestamp
  ) {

    return "—";

  }


  return new Date(
    timestamp
  )
  .toLocaleString(
    "en-IN",
    {
      day:
        "2-digit",

      month:
        "short",

      hour:
        "2-digit",

      minute:
        "2-digit"
    }
  );

}


function toast(
  message
) {

  const element =
    $("#toast");


  element.textContent =
    message;


  element.classList.add(
    "show"
  );


  clearTimeout(
    toast.timer
  );


  toast.timer =
    setTimeout(
      () => {

        element.classList.remove(
          "show"
        );

      },
      2200
    );

}


/* =========================================================
   ACTIVITY
========================================================= */

function addActivity(
  text,
  type = "admin"
) {

  database.activity.unshift({

    id:
      uid(),

    type,

    text,

    createdAt:
      Date.now()

  });


  database.activity =
    database.activity.slice(
      0,
      100
    );

