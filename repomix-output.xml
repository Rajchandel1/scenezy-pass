    null;


  const currentId =
    state.current?.id ||
    null;


  const newActiveIndex =
    activeId
    ?
    EVENTS.findIndex(
      event =>
        event.id ===
        activeId
    )
    :
    -1;


  state.position =
    newActiveIndex >=
    0
    ?
    newActiveIndex
    :
    0;


  state.active =
    newActiveIndex >=
    0
    ?
    newActiveIndex
    :
    0;


  if (
    currentId
  ) {

    const updatedCurrent =
      EVENTS.find(
        event =>
          event.id ===
          currentId
      );


    if (
      updatedCurrent
    ) {

      state.current =
        updatedCurrent;

    } else {

      state.current =
        null;


      $("#detail")
        ?.classList
