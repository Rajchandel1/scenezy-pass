/* =========================================================
   CURRENT PASS
========================================================= */

function currentNight() {

  if (
    !state.current
  ) return null;


  const nights =
    buildNights(
      state.current
    );


  if (
    !nights.length
  ) return null;


  return nights[
    state.selectedNight[
      state.current.id
    ] || 0
  ];

}


function currentPasses() {

  if (
    !state.current
  ) return [];


  return passesForNight(
    state.current,
    currentNight()
  );

}


function currentPass() {

  if (
    !state.current
  ) return null;


  const passes =
    currentPasses();


  if (
    !passes.length
  ) return null;


  const index =
    Math.min(
      state.selectedPass[
        state.current.id
      ] || 0,
      passes.length - 1
    );


  state.selectedPass[
    state.current.id
  ] =
    index;


  return passes[
    index
  ];

}


