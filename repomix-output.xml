          button.dataset.pass
        );


      renderPassTypes();

      syncSummary();

      haptic(5);

    };

}


/* =========================================================
   QUANTITY
========================================================= */

function renderQuantity() {

  $("#qtyValue")
    .textContent =
    state.quantity[
      state.current.id
    ];

}


$("#qtyMinus")
