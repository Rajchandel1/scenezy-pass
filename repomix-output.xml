/* ---------------------------------------------------------
   SMALL LOCAL CACHE
--------------------------------------------------------- */

function readScenezyCache() {

  try {

    const raw =
      localStorage.getItem(
        SCENEZY_USER_CACHE_KEY
      ) ||
      localStorage.getItem(
        SCENEZY_LEGACY_SHARED_KEY
      );


    if (!raw) {
      return null;
    }


    const data =
      JSON.parse(raw);


    if (
      !data ||
      !Array.isArray(
        data.events
      )
    ) {
      return null;
    }


    return data;

  } catch (error) {

    console.warn(
      "Scenezy cache read failed",
      error
    );


    return null;
  }
}


function writeScenezyCache(
  data
) {

  try {

    data.updatedAt =
      Date.now();


    localStorage.setItem(
      SCENEZY_USER_CACHE_KEY,
      JSON.stringify(data)
    );


    return true;

  } catch (error) {

    console.warn(
      "Scenezy cache write failed",
      error
    );


    return false;
  }
}


function createInitialScenezyCache() {

  const now =
    Date.now();


  const database = {

    version: 2,

    settings: {
      whatsapp: SCENEZY.whatsapp,
      city: SCENEZY.city,
      season: SCENEZY.season
    },

    events:
      SCENEZY.events.map(
        event => ({
          ...event,
          visible:
            event.visible !== false,
          mapUrl:
            event.mapUrl || "",
          adminNotes:
            event.adminNotes || "",
          createdAt:
            event.createdAt || now,
          updatedAt:
            event.updatedAt || now
        })
      ),

    updatedAt:
      now

  };


  writeScenezyCache(
    database
  );


  return database;
}


function getScenezyCache() {

  return (
    readScenezyCache() ||
    createInitialScenezyCache()
  );
}


