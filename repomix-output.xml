    "https://hpvsemxmaesprrnwyuqw.supabase.co",

  publishableKey:
    "sb_publishable_zs_CKudUqZNeZmbr3EvXpQ_fn1p1zwf"

};


const SUPABASE_READY =
  Boolean(
    window.supabase &&
    SUPABASE_CONFIG.publishableKey &&
    !SUPABASE_CONFIG.publishableKey.includes(
      "PASTE_SUPABASE"
    )
  );


