function getShareData() {

  const event =
    state.current;


  const night =
    currentNight();


  const pass =
    currentPass();


  let text =
`${event.name}
${event.dateLabel}
${event.venue}, ${event.area}
${event.address}`;


  if (
    night
  ) {

    text +=
`
Night: ${night.day}, ${night.date} 2026`;

  }


  if (
    pass
  ) {

    text +=
`
${pass.name}: ${priceText(pass.price)}`;

  }


  return {

    title:
      event.name,

    text,

    /*
      Avoid sharing file:// as URL.
    */

    url:
      location.protocol ===
      "http:" ||
      location.protocol ===
      "https:"
      ?
      location.href
      :
      ""

  };

}


function openShareFallback() {

  $("#shareOverlay")
    .classList
    .add(
      "open"
    );

}


function closeShareFallback() {

  $("#shareOverlay")
    .classList
    .remove(
      "open"
    );

}


/*
   Main share button:

   1. Try native mobile share sheet.
   2. If browser/iframe blocks it,
      show our custom fallback.
*/

async function handleShare() {

  const data =
    getShareData();


  if (
    navigator.share &&
    window.isSecureContext
  ) {

    try {

      const shareData = {

        title:
          data.title,

        text:
          data.text

      };


      if (
        data.url
      ) {

        shareData.url =
          data.url;

      }


      await navigator.share(
        shareData
      );


      return;

    } catch (
      error
    ) {

      /*
        User simply closed native share sheet.
    */

      if (
        error?.name ===
        "AbortError"
      ) {

        return;

      }

    }

  }


  openShareFallback();

}


$("#detailShare")
  .onclick =
  handleShare;


