function bookingReference(
  event
) {

  const initials =
    event.name
      .split(/\s+/)
      .map(
        word =>
          word[0]
      )
      .join("")
      .toUpperCase()
      .slice(0,3);


  return (
    `SZ-${initials}-` +
    Math.random()
      .toString(36)
      .slice(2,6)
      .toUpperCase()
  );

}


function createBooking() {

  const event =
    state.current;


  const night =
    currentNight();


  const pass =
    currentPass();


  const quantity =
    state.quantity[
      event.id
    ];


  const total =
    currentTotal();


  const reference =
    bookingReference(
      event
    );


  const nightText =
    night
    ?
    `${night.day}, ${night.date} 2026`
    :
    event.dateLabel;


  const message =
`Namaste Scenezy 🙏

I want to book passes:

Event: ${event.name}
Venue: ${event.venue}, ${event.area}
Night: ${nightText}
Pass: ${pass?.name || "To be confirmed"}
Quantity: ${quantity}
Amount: ${priceText(total)}

Booking Ref: ${reference}`;


  return {

    ref:
      reference,

    eventId:
      event.id,

    event:
      event.name,

    venue:
      `${event.venue}, ${event.area}`,

    night:
      nightText,

    pass:
      pass?.name ||
      "TBA",

    qty:
      quantity,

    total,

    message,

    whatsappURL:
      `https://wa.me/${SCENEZY.whatsapp}?text=${encodeURIComponent(message)}`,

    createdAt:
      Date.now()

  };

}


