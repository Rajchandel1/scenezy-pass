/* =========================================================
   RATING WHEEL
========================================================= */

const RATINGS = [

  {
    emoji: "😐",
    label: "Meh"
  },

  {
    emoji: "🙂",
    label: "Okay-ish"
  },

  {
    emoji: "💃",
    label: "Garba ready"
  },

  {
    emoji: "🔥",
    label: "On fire"
  },

  {
    emoji: "👑",
    label: "All-timer"
  }

];


const RATING_STEP =
  360 /
  RATINGS.length;


let wheelRotation =
  -2 *
  RATING_STEP;


let wheelIndex = 2;

let wheelDrag = null;

let wheelItems = [];

const WHEEL_RADIUS = 115;


function loadRatings() {

  try {

    return (
      JSON.parse(
        localStorage.getItem(
          STORAGE.ratings
        )
      ) ||
      {}
    );

  } catch {

    return {};

  }

}


function buildRatingWheel() {

  const disc =
    $("#wheelDisc");


  disc.innerHTML = "";

  wheelItems = [];


  RATINGS.forEach(
    (
      rating,
      index
    ) => {

      const element =
        document.createElement(
          "span"
        );


      element.className =
        "wheelEmoji";


      element.dataset.angle =
        index *
        RATING_STEP;


      element.innerHTML =
        `<b>${rating.emoji}</b>`;


      disc.appendChild(
        element
      );


      wheelItems.push(
        element
      );

    }
  );


  setWheel(
    wheelRotation
  );

}


function setWheel(
  rotation
) {

  wheelRotation =
    rotation;


  $("#wheelDisc")
    .style
    .transform =
    `rotate(${rotation}deg)`;


  wheelItems.forEach(
    element => {

      const angle =
        Number(
          element.dataset.angle
        );


      element.style.transform =
        `
          translate(-50%,-50%)

          rotate(${angle}deg)

          translateY(${-WHEEL_RADIUS}px)

          rotate(${-angle}deg)

          rotate(${-rotation}deg)
        `;


      const world =
        mod(
          angle +
          rotation,
          360
        );


      const distance =
        Math.min(
          world,
          360 -
          world
        );


      const strength =
        Math.max(
          0,
          1 -
          distance /
          85
        );


      element.style.fontSize =
        `${22 + strength * 13}px`;


      element.style.opacity =
        .38 +
        strength *
        .62;


      element
        .firstElementChild
        .style
        .transform =
        `scale(${.84 + strength * .43})`;

    }
  );


  const index =
    mod(
      Math.round(
        -rotation /
        RATING_STEP
      ),
      RATINGS.length
    );


  if (
    index !==
    wheelIndex
  ) {

    wheelIndex =
      index;


    $("#ratingEmoji")
      .textContent =
      RATINGS[index].emoji;


    $("#ratingLabel")
      .textContent =
      RATINGS[index].label;

  }

}


function renderRating() {

  if (
    !state.current
  ) return;


  const saved =
    loadRatings()[
      state.current.id
    ];


  $("#ratingText")
    .textContent =
    saved
    ?
    `${saved.emoji}  ${saved.label}`
    :
    "Spin the vibe wheel";

}


$("#ratingOpen")
  .onclick =
  () => {

    const saved =
      loadRatings()[
        state.current.id
      ];


    wheelIndex =
      saved?.index ??
      2;


    const target =
      -wheelIndex *
      RATING_STEP;


    wheelRotation =
      target +
      160;


    setWheel(
      wheelRotation
    );


    $("#ratingOverlay")
      .classList
      .add(
        "open"
      );


    tween(
      wheelRotation,
      target,
      650,
      value =>
        setWheel(
          value
        )
    );

  };


$("#ratingVeil")
  .onclick =
  () => {

    $("#ratingOverlay")
      .classList
      .remove(
        "open"
      );

  };


const vibeWheel =
  $("#vibeWheel");


vibeWheel.addEventListener(
  "pointerdown",
  pointerEvent => {

    wheelDrag = {

      last:
        pointerEvent.clientX,

      velocity:
        0

    };


    vibeWheel.setPointerCapture(
      pointerEvent.pointerId
    );

  }
);


vibeWheel.addEventListener(
  "pointermove",
  pointerEvent => {

    if (
      !wheelDrag
    ) return;


    const delta =
      pointerEvent.clientX -
      wheelDrag.last;


    wheelDrag.last =
      pointerEvent.clientX;


    const rotation =
      delta *
      .43;


    wheelDrag.velocity =
      wheelDrag.velocity *
      .7 +
      rotation *
      .3;


    setWheel(
      wheelRotation +
      rotation
    );

  }
);


vibeWheel.addEventListener(
  "pointerup",
  () => {

    if (
      !wheelDrag
    ) return;


    const velocity =
      wheelDrag.velocity;


    wheelDrag = null;


    const target =
      Math.round(
        (
          wheelRotation +
          velocity *
          8
        ) /
        RATING_STEP
      ) *
      RATING_STEP;


    tween(
      wheelRotation,
      target,
      500,
      value =>
        setWheel(
          value
        )
    );

  }
);


$("#ratingSave")
  .onclick =
  () => {

    const rating =
