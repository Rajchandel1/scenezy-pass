                style="
                  --event-a:${event.poster.a};
                  --event-b:${event.poster.b};
                "
              >

                ${
                  event.image
                  ?
                  `

                    <img
                      src="${escapeHTML(event.image)}"
                      alt=""
                      onerror="this.remove()"
                    >

                  `
                  :
                  ""
                }

              </div>


              <div class="event-card-copy">

                <div class="event-topline">

                  <strong class="event-name">
                    ${escapeHTML(event.name)}
                  </strong>


                  <span
                    class="
                      status
                      ${
                        event.visible
                        ?
                        "live"
                        :
                        "hidden"
                      }
                    "
                  >

