function landingEventsForMode(
  mode
) {

  const items =
    [...EVENTS];


  if (
    mode === "passes" ||
    mode === "price"
  ) {

    items.sort(
      (a, b) => {

        const ap =
          eventBasePrice(a);

        const bp =
          eventBasePrice(b);


        if (
          ap == null &&
          bp == null
        ) return 0;

        if (
          ap == null
        ) return 1;

        if (
          bp == null
        ) return -1;


        return ap - bp;
      }
    );
  }


  return items;
}


