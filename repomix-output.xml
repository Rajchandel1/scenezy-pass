/* =========================================================
   SUMMARY
========================================================= */

function currentTotal() {

  const pass =
    currentPass();


  if (
    !state.current ||
    !pass ||
    pass.price == null
  ) {

    return null;

  }


  return (
    pass.price *
    state.quantity[
      state.current.id
    ]
  );

}


function syncSummary() {

  const event =
    state.current;


  if (
    !event
  ) return;


  const night =
    currentNight();


  const pass =
    currentPass();


  const quantity =
    state.quantity[
      event.id
    ];


  const total =
    currentTotal();


  $("#summaryText")
    .textContent =
    [

      night
      ?
      `${night.day}, ${night.date}`
      :
      event.dateLabel,

      pass?.name ||
      "Pass TBA",

      `× ${quantity}`

    ]
    .join(
      " · "
    );


  $("#summaryTotal")
    .textContent =
    priceText(
      total
    );


  $("#bookBtnText")
    .textContent =
    total == null
    ?
    "Enquire on WhatsApp"
    :
    `Book on WhatsApp · ${priceText(total)}`;

}


/* =========================================================
   SHARE
========================================================= */

function getShareData() {

  const event =
    state.current;


  const night =
    currentNight();


  const pass =
    currentPass();


  let text =
`${event.name}
${event.dateLabel}
${event.venue}, ${event.area}
${event.address}`;


  if (
    night
  ) {

    text +=
`
Night: ${night.day}, ${night.date} 2026`;

  }


  if (
    pass
  ) {

    text +=
`
${pass.name}: ${priceText(pass.price)}`;

  }


  return {

    title:
      event.name,

    text,

    /*
      Avoid sharing file:// as URL.
    */

    url:
      location.protocol ===
      "http:" ||
      location.protocol ===
      "https:"
      ?
      location.href
      :
      ""

  };

}


function openShareFallback() {

  $("#shareOverlay")
    .classList
    .add(
      "open"
    );

}


function closeShareFallback() {

  $("#shareOverlay")
    .classList
    .remove(
