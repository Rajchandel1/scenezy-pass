   NETWORK FETCH
   Local cache paints first, Supabase refreshes after.
--------------------------------------------------------- */

function setCloudPulse(
  visible,
  text =
    "Refreshing events"
) {

  const indicator =
    $("#cloudPulse");


  if (!indicator) {
    return;
  }


  indicator.textContent =
    text;


  indicator.classList.toggle(
    "show",
    Boolean(
      visible
    )
  );

}


async function fetchScenezyFromSupabase({
  notify = false,
  rebuild = true
} = {}) {

  if (
    !sb
  ) {
    return false;
  }


  setCloudPulse(
    true
  );


  try {

    const [
      eventsResult,
      settingsResult
    ] =
      await Promise.all([

        sb
          .from(
            "events"
          )
          .select(
            "id,data,visible,sort_order,created_at,updated_at"
          )
          .eq(
            "visible",
            true
          )
          .order(
            "sort_order",
            {
              ascending: true
            }
          ),


        sb
          .from(
            "settings"
          )
          .select(
            "id,whatsapp,city,season,updated_at"
          )
          .eq(
            "id",
            "scenezy"
          )
          .maybeSingle()

      ]);


    if (
      eventsResult.error
    ) {
      throw eventsResult.error;
    }


    if (
      settingsResult.error
    ) {
      throw settingsResult.error;
    }


    const database = {

      version: 2,

      settings: {

        whatsapp:
          settingsResult.data
            ?.whatsapp ||
          SCENEZY.whatsapp,

        city:
          settingsResult.data
            ?.city ||
          SCENEZY.city,

        season:
          settingsResult.data
            ?.season ||
          SCENEZY.season

      },

      events:
        (
          eventsResult.data ||
          []
        )
        .map(
          scenezyEventFromRow
        ),

      updatedAt:
        Date.now()

    };


    writeScenezyCache(
      database
    );


    applyScenezyPublicData(
      database
    );


    if (
      rebuild
    ) {

      refreshScenezyUI(
        notify
      );

    }


    return true;

  } catch (error) {

    console.warn(
      "Supabase event refresh failed; using local cache.",
      error
    );


    return false;

  } finally {

    setCloudPulse(
      false
    );

  }

}


