<file path="admin.html">
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
>

<meta name="theme-color" content="#090a0f">

<title>Scenezy Admin</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
  href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Fraunces:ital,wght@0,500;1,500&display=swap"
  rel="stylesheet"
>

<style>
/* =========================================================
   SCENEZY ADMIN
   Mobile-first event operations dashboard
========================================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

:root {
  --bg: #090a0f;
  --surface: #111218;
  --surface-2: #171820;
  --surface-3: #1e202a;
  --surface-4: #262834;

  --ink: #f7f7fb;
  --muted: #a1a4b3;
  --faint: #696c7a;

  --line: rgba(255,255,255,.075);
  --line-2: rgba(255,255,255,.13);

  --blue: #3157ed;
  --blue-2: #2447cd;
  --blue-soft: rgba(49,87,237,.13);

  --green: #39ca88;
  --green-soft: rgba(57,202,136,.12);

  --orange: #f4b253;
  --orange-soft: rgba(244,178,83,.12);

  --red: #ef6c74;
  --red-soft: rgba(239,108,116,.12);

  --purple: #a68cff;
  --purple-soft: rgba(166,140,255,.12);

  --radius: 18px;
  --radius-sm: 13px;

  --safe-bottom: env(safe-area-inset-bottom, 0px);

  --sans: "Outfit", system-ui, sans-serif;
  --serif: "Fraunces", Georgia, serif;
}

html,
body {
  width: 100%;
  min-height: 100%;
}

body {
  background:
    radial-gradient(
      circle at 30% -10%,
      rgba(49,87,237,.13),
      transparent 35%
    ),
    var(--bg);

  color: var(--ink);

  font-family: var(--sans);

  overflow-x: hidden;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  border: 0;
  color: inherit;
  background: none;
  cursor: pointer;
}

input,
textarea,
select {
  width: 100%;

  border: 1px solid var(--line-2);
  outline: none;

  color: var(--ink);
  background: #101117;

  border-radius: 13px;

  transition:
    border-color .18s ease,
    box-shadow .18s ease,
    background .18s ease;
}

input,
select {
  min-height: 46px;

  padding:
    0 13px;
}

textarea {
  min-height: 92px;

  padding: 12px 13px;

  resize: vertical;
}

input:focus,
textarea:focus,
select:focus {
  border-color:
    rgba(92,120,255,.7);

  box-shadow:
    0 0 0 3px
    rgba(49,87,237,.10);

  background: #12131b;
}

input::placeholder,
textarea::placeholder {
  color: #555865;
}

select {
  appearance: none;

  background-image:
    linear-gradient(
      45deg,
      transparent 50%,
      #777b8a 50%
    ),
    linear-gradient(
      135deg,
      #777b8a 50%,
      transparent 50%
    );

  background-position:
    calc(100% - 18px) 19px,
    calc(100% - 13px) 19px;

  background-size:
    5px 5px,
    5px 5px;

  background-repeat:
    no-repeat;
}

svg {
  display: block;
}

[hidden] {
  display: none !important;
}


/* =========================================================
   APP
========================================================= */

.admin-shell {
  min-height: 100dvh;
}

.sidebar {
  display: none;
}

.main {
  min-height: 100dvh;

  padding-bottom:
    calc(94px + var(--safe-bottom));
}


/* =========================================================
   HEADER
========================================================= */

.topbar {
  position: sticky;

  top: 0;

  z-index: 100;

  display: flex;
  align-items: center;

  gap: 12px;

  min-height: 70px;

  padding:
    13px
    15px;

  border-bottom:
    1px solid
    var(--line);

  background:
    rgba(9,10,15,.86);

  backdrop-filter:
    blur(20px);

  -webkit-backdrop-filter:
    blur(20px);
}

.brand-mini {
  width: 38px;
  height: 38px;

  flex: none;

  display: grid;
  place-items: center;

  border-radius: 13px;

  font-size: 15px;
  font-weight: 800;

  background:
    linear-gradient(
      145deg,
      #4064f3,
      #2747c8
    );

  box-shadow:
    0 7px 20px
    rgba(49,87,237,.24);
}

.topbar-copy {
  flex: 1;
  min-width: 0;
}

.topbar-copy small {
  display: block;

  color: var(--faint);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .18em;

  text-transform: uppercase;
}

.topbar-copy h1 {
  margin-top: 2px;

  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;

  font-size: 19px;
  line-height: 1.1;
}

.primary-btn,
.secondary-btn,
.danger-btn,
.soft-btn {
  min-height: 43px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 7px;

  padding:
    0 14px;

  border-radius: 13px;

  font-size: 11px;
  font-weight: 700;

  transition:
    transform .15s ease,
    opacity .15s ease;
}

.primary-btn {
  color: white;

  background:
    linear-gradient(
      145deg,
      #4064f3,
      #2949ce
    );

  box-shadow:
    0 8px 22px
    rgba(49,87,237,.20);
}

.secondary-btn {
  border:
    1px solid
    var(--line-2);

  background: var(--surface-2);
}

.soft-btn {
  min-height: 37px;

  padding:
    0 11px;

  color: #9db0ff;

  background:
    var(--blue-soft);

  border:
    1px solid
    rgba(80,107,235,.18);
}

.danger-btn {
  color: #ff999f;

  background:
    var(--red-soft);

  border:
    1px solid
    rgba(239,108,116,.16);
}

.primary-btn:active,
.secondary-btn:active,
.soft-btn:active,
.danger-btn:active {
  transform: scale(.97);
}


/* =========================================================
   PAGE
========================================================= */

.page {
  display: none;

  padding:
    17px
    14px
    30px;
}

.page.active {
  display: block;
}

.page-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 13px;

  margin-bottom: 17px;
}

.page-heading h2 {
  font-size: 23px;

  letter-spacing: -.03em;
}

.page-heading p {
  max-width: 560px;

  margin-top: 5px;

  color: var(--muted);

  font-size: 11px;
  line-height: 1.5;
}


/* =========================================================
   CARDS
========================================================= */

.panel {
  border:
    1px solid
    var(--line);

  border-radius:
    var(--radius);

  background:
    linear-gradient(
      160deg,
      rgba(25,26,34,.92),
      rgba(16,17,23,.95)
    );

  box-shadow:
    0 14px 36px
    rgba(0,0,0,.14);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding:
    15px 15px 12px;

  border-bottom:
    1px solid
    var(--line);
}

.panel-head h3 {
  font-size: 13px;
}

.panel-head small {
  color: var(--faint);

  font-size: 9px;
}

.panel-body {
  padding: 14px;
}


/* =========================================================
   DASHBOARD STATS
========================================================= */

.stat-grid {
  display: grid;

  grid-template-columns:
    repeat(2,1fr);

  gap: 9px;
}

.stat-card {
  min-height: 116px;

  padding: 14px;

  border:
    1px solid
    var(--line);

  border-radius: 17px;

  background:
    linear-gradient(
      150deg,
      rgba(27,29,39,.96),
      rgba(17,18,25,.96)
    );
}

.stat-icon {
  width: 31px;
  height: 31px;

  display: grid;
  place-items: center;

  border-radius: 10px;

  font-size: 13px;
  font-weight: 800;
}

.stat-card.blue
.stat-icon {
  color: #8fa5ff;

  background:
    var(--blue-soft);
}

.stat-card.green
.stat-icon {
  color: var(--green);

  background:
    var(--green-soft);
}

.stat-card.orange
.stat-icon {
  color: var(--orange);

  background:
    var(--orange-soft);
}

.stat-card.purple
.stat-icon {
  color: var(--purple);

  background:
    var(--purple-soft);
}

.stat-label {
  display: block;

  margin-top: 12px;

  color: var(--muted);

  font-size: 9px;
  font-weight: 600;

  letter-spacing: .04em;
}

.stat-value {
  display: block;

  margin-top: 2px;

  font-size: 24px;
  font-weight: 750;

  letter-spacing: -.04em;
}

.stat-extra {
  display: block;

  margin-top: 3px;

  color: var(--faint);

  font-size: 8px;
}


/* =========================================================
   DASHBOARD CONTENT
========================================================= */

.dashboard-layout {
  display: grid;

  gap: 11px;

  margin-top: 12px;
}

.quick-row {
  display: grid;

  grid-template-columns:
    repeat(2,1fr);

  gap: 8px;
}

.quick-action {
  min-height: 78px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 13px;

  text-align: left;

  border:
    1px solid
    var(--line);

  border-radius: 15px;

  background:
    var(--surface-2);
}

.quick-action b {
  font-size: 11px;
}

.quick-action span {
  color: var(--muted);

  font-size: 9px;
  line-height: 1.35;
}

.activity-list,
.top-event-list {
  display: flex;
  flex-direction: column;

  gap: 8px;
}

.activity-item,
.top-event-item {
  display: flex;
  align-items: center;

  gap: 10px;

  padding:
    10px 11px;

  border-radius: 13px;

  background:
    rgba(255,255,255,.025);
}

.activity-dot {
  width: 8px;
  height: 8px;

  flex: none;

  border-radius: 50%;

  background:
    var(--blue);
}

.activity-copy,
.top-event-copy {
  flex: 1;
  min-width: 0;
}

.activity-copy b,
.top-event-copy b {
  display: block;

  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;

  font-size: 10px;
  font-weight: 600;
}

.activity-copy span,
.top-event-copy span {
  display: block;

  margin-top: 2px;

  color: var(--faint);

  font-size: 8px;
}

.top-event-number {
  flex: none;

  color: #9fb1ff;

  font-size: 11px;
  font-weight: 700;
}


/* =========================================================
   TOOLBAR / FILTERS
========================================================= */

.toolbar {
  display: flex;
  flex-direction: column;

  gap: 8px;

  margin-bottom: 12px;
}

.search-input {
  position: relative;
}

.search-input input {
  padding-left: 39px;
}

.search-input::before {
  content: "⌕";

  position: absolute;

  left: 14px;
  top: 50%;

  z-index: 2;

  color: var(--faint);

  font-size: 20px;

  transform:
    translateY(-54%);
}

.filter-row {
  display: flex;

  gap: 7px;

  overflow-x: auto;

  scrollbar-width: none;
}

.filter-row::-webkit-scrollbar {
  display: none;
}

.filter-chip {
  min-height: 37px;

  flex: none;

  padding:
    0 12px;

  border-radius: 999px;

  color: var(--muted);

  border:
    1px solid
    var(--line);

  background:
    var(--surface);

  font-size: 9px;
  font-weight: 600;
}

.filter-chip.on {
  color: white;

  border-color:
    rgba(74,103,239,.32);

  background:
    var(--blue-soft);
}


/* =========================================================
   EVENT LIST
========================================================= */

.event-list {
  display: grid;

  gap: 10px;
}

.event-admin-card {
  overflow: hidden;

  border:
    1px solid
    var(--line);

  border-radius: 18px;

  background:
    linear-gradient(
      150deg,
      rgba(26,27,35,.95),
      rgba(15,16,22,.96)
    );
}

.event-strip {
  height: 4px;

  background:
    linear-gradient(
      90deg,
      var(--event-a),
      var(--event-b)
    );
}

.event-card-main {
  display: flex;

  gap: 11px;

  padding:
    13px;
}

.event-thumb {
  position: relative;

  width: 72px;
  height: 91px;

  flex: none;

  overflow: hidden;

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      var(--event-a),
      var(--event-b)
    );
}

.event-thumb img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

.event-thumb::after {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      transparent,
      rgba(0,0,0,.34)
    );
}

.event-card-copy {
  flex: 1;
  min-width: 0;
}

.event-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 7px;
}

.event-name {
  display: -webkit-box;

  overflow: hidden;

  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;

  font-size: 14px;
  line-height: 1.15;
}

.status {
  min-height: 24px;

  flex: none;

  display: inline-flex;
  align-items: center;

  padding:
    0 8px;

  border-radius: 999px;

  font-size: 7px;
  font-weight: 700;

  letter-spacing: .07em;

  text-transform: uppercase;
}

.status.live {
  color: var(--green);

  background:
    var(--green-soft);
}

.status.hidden {
  color: var(--faint);

  background:
    rgba(255,255,255,.05);
}

.event-place {
  margin-top: 5px;

  color: var(--muted);

  font-size: 9px;

  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;
}

.event-date {
  margin-top: 3px;

  color: var(--faint);

  font-size: 8px;
}

.mini-metrics {
  display: flex;
  flex-wrap: wrap;

  gap: 5px;

  margin-top: 9px;
}

.mini-metric {
  min-height: 24px;

  display: inline-flex;
  align-items: center;

  padding:
    0 8px;

  border:
    1px solid
    var(--line);

  border-radius: 8px;

  color: var(--muted);

  background:
    rgba(255,255,255,.025);

  font-size: 7.5px;
}

.event-card-bottom {
  display: flex;
  align-items: center;

  gap: 7px;

  padding:
    10px 12px;

  border-top:
    1px solid
    var(--line);
}

.card-action {
  min-height: 36px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding:
    0 11px;

  border:
    1px solid
    var(--line);

  border-radius: 11px;

  color: var(--muted);

  background:
    rgba(255,255,255,.025);

  font-size: 8.5px;
  font-weight: 600;
}

.card-action.primary {
  color: #9db0ff;

  border-color:
    rgba(77,105,238,.18);

  background:
    var(--blue-soft);
}

.card-actions-spacer {
  flex: 1;
}

.icon-action {
  width: 36px;
  height: 36px;

  display: grid;
  place-items: center;

  border:
    1px solid
    var(--line);

  border-radius: 11px;

  color: var(--muted);
}


/* =========================================================
   LEADS
========================================================= */

.lead-list {
  display: grid;

  gap: 9px;
}

.lead-card {
  padding: 13px;

  border:
    1px solid
    var(--line);

  border-radius: 17px;

  background:
    linear-gradient(
      150deg,
      rgba(25,26,34,.94),
      rgba(15,16,22,.96)
    );
}

.lead-head {
  display: flex;
  align-items: flex-start;

  gap: 10px;
}

.lead-number {
  width: 34px;
  height: 34px;

  flex: none;

  display: grid;
  place-items: center;

  border-radius: 11px;

  color: #95a9ff;

  background:
    var(--blue-soft);

  font-size: 10px;
  font-weight: 800;
}

.lead-main {
  flex: 1;
  min-width: 0;
}

.lead-main b {
  display: block;

  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;

  font-size: 12px;
}

.lead-ref {
  display: block;

  margin-top: 2px;

  color: var(--faint);

  font-size: 8px;
}

.lead-status {
  width: 108px;

  flex: none;
}

.lead-status select {
  min-height: 34px;

  padding:
    0 25px 0 9px;

  border-radius: 10px;

  font-size: 8px;

  background-position:
    calc(100% - 14px) 13px,
    calc(100% - 10px) 13px;
}

.lead-details {
  display: flex;
  flex-wrap: wrap;

  gap: 5px;

  margin-top: 11px;
}

.lead-tag {
  min-height: 25px;

  display: inline-flex;
  align-items: center;

  padding:
    0 8px;

  border-radius: 8px;

  color: var(--muted);

  background:
    rgba(255,255,255,.035);

  border:
    1px solid
    var(--line);

  font-size: 7.5px;
}

.lead-footer {
  display: flex;
  align-items: center;

  gap: 8px;

  margin-top: 11px;

  padding-top: 10px;

  border-top:
    1px solid
    var(--line);
}

.lead-time {
  flex: 1;

  color: var(--faint);

  font-size: 8px;
}

.revenue-editor {
  display: flex;
  align-items: center;

  gap: 6px;
}

.revenue-editor span {
  color: var(--muted);

  font-size: 8px;
}

.revenue-editor input {
  width: 90px;
  min-height: 34px;

  padding:
    0 9px;

  border-radius: 9px;

  font-size: 9px;
}


/* =========================================================
   SETTINGS
========================================================= */

.settings-grid {
  display: grid;

  gap: 10px;
}

.setting-block {
  padding: 14px;

  border:
    1px solid
    var(--line);

  border-radius: 17px;

  background:
    var(--surface);
}

.setting-block h3 {
  font-size: 13px;
}

.setting-block p {
  margin-top: 5px;

  color: var(--muted);

  font-size: 9px;
  line-height: 1.5;
}

.setting-actions {
  display: flex;
  flex-wrap: wrap;

  gap: 7px;

  margin-top: 13px;
}

.code-preview {
  max-height: 260px;

  margin-top: 11px;

  overflow: auto;

  padding: 12px;

  border-radius: 13px;

  color: #bac6ff;

  background: #08090d;

  border:
    1px solid
    var(--line);

  font:
    9px/1.55
    monospace;

  white-space: pre-wrap;
}


/* =========================================================
   MOBILE NAV
========================================================= */

.mobile-nav {
  position: fixed;

  left: 50%;
  bottom:
    calc(10px + var(--safe-bottom));

  z-index: 400;

  width:
    min(
      calc(100% - 24px),
      430px
    );

  display: grid;

  grid-template-columns:
    repeat(4,1fr);

  gap: 3px;

  padding: 5px;

  border:
    1px solid
    var(--line-2);

  border-radius: 20px;

  background:
    rgba(24,25,32,.94);

  backdrop-filter:
    blur(20px);

  -webkit-backdrop-filter:
    blur(20px);

  box-shadow:
    0 15px 40px
    rgba(0,0,0,.44);

  transform:
    translateX(-50%);
}

.mobile-nav button {
  min-height: 50px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 3px;

  border-radius: 15px;

  color: var(--faint);

  font-size: 7px;
  font-weight: 600;
}

.mobile-nav button span:first-child {
  font-size: 17px;
}

.mobile-nav button.on {
  color: white;

  background:
    linear-gradient(
      145deg,
      #3d62f1,
      #2949ce
    );
}


/* =========================================================
   EVENT EDITOR SHEET
========================================================= */

.editor-overlay {
  position: fixed;
  inset: 0;

  z-index: 1000;

  visibility: hidden;

  pointer-events: none;
}

.editor-overlay.open {
  visibility: visible;

  pointer-events: auto;
}

.editor-veil {
  position: absolute;
  inset: 0;

  opacity: 0;

  background:
    rgba(3,4,7,.76);

  backdrop-filter:
    blur(5px);

  transition:
    opacity .28s ease;
}

.editor-overlay.open
.editor-veil {
  opacity: 1;
}

.editor-sheet {
  position: absolute;

  inset:
    12px
    0
    0;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  border-radius:
    25px 25px 0 0;

  background:
    #0d0e14;

  border-top:
    1px solid
    var(--line-2);

  transform:
    translateY(102%);

  transition:
    transform
    .42s
    cubic-bezier(.2,.85,.24,1);
}

.editor-overlay.open
.editor-sheet {
  transform: none;
}

.editor-header {
  flex: none;

  display: flex;
  align-items: center;

  gap: 11px;

  padding:
    12px 14px;

  border-bottom:
    1px solid
    var(--line);

  background:
    rgba(13,14,20,.96);
}

.editor-close {
  width: 39px;
  height: 39px;

  flex: none;

  display: grid;
  place-items: center;

  border:
    1px solid
    var(--line);

  border-radius: 12px;

  color: var(--muted);

  background:
    var(--surface);
}

.editor-heading {
  flex: 1;
  min-width: 0;
}

.editor-heading small {
  display: block;

  color: var(--faint);

  font-size: 7px;
  font-weight: 700;

  letter-spacing: .15em;

  text-transform: uppercase;
}

.editor-heading h2 {
  margin-top: 2px;

  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;

  font-size: 16px;
}

.editor-scroll {
  flex: 1;

  overflow-y: auto;

  padding:
    13px
    13px
    110px;

  scrollbar-width: none;
}

.editor-scroll::-webkit-scrollbar {
  display: none;
}

.form-section {
  margin-bottom: 11px;

  overflow: hidden;

  border:
    1px solid
    var(--line);

  border-radius: 18px;

  background:
    var(--surface);
}

.form-section-head {
  padding:
    13px 14px;

  border-bottom:
    1px solid
    var(--line);
}

.form-section-head h3 {
  font-size: 12px;
}

.form-section-head p {
  margin-top: 3px;

  color: var(--faint);

  font-size: 8px;
  line-height: 1.4;
}

.form-section-body {
  padding: 13px;
}

.form-grid {
  display: grid;

  gap: 11px;
}

.field label {
  display: block;

  margin-bottom: 6px;

  color: var(--muted);

  font-size: 8px;
  font-weight: 600;

  letter-spacing: .05em;
}

.field small {
  display: block;

  margin-top: 5px;

  color: var(--faint);

  font-size: 7.5px;
  line-height: 1.4;
}

.two-col {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 8px;
}

.switch-row {
  display: flex;
  align-items: center;

  gap: 12px;

  padding:
    11px;

  border:
    1px solid
    var(--line);

  border-radius: 13px;

  background:
    rgba(255,255,255,.02);
}

.switch-copy {
  flex: 1;
}

.switch-copy b {
  display: block;

  font-size: 10px;
}

.switch-copy span {
  display: block;

  margin-top: 2px;

  color: var(--faint);

  font-size: 7.5px;
}

.switch {
  position: relative;

  width: 43px;
  height: 25px;

  flex: none;

  border-radius: 999px;

  background: #292b35;

  transition:
    background .18s ease;
}

.switch::after {
  content: "";

  position: absolute;

  left: 3px;
  top: 3px;

  width: 19px;
  height: 19px;

  border-radius: 50%;

  background: white;

  transition:
    transform .18s ease;
}

.switch.on {
  background: var(--blue);
}

.switch.on::after {
  transform:
    translateX(18px);
}


/* =========================================================
   MEDIA PREVIEW
========================================================= */

.image-preview {
  position: relative;

  height: 160px;

  overflow: hidden;

  margin-top: 9px;

  border:
    1px solid
    var(--line);

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      var(--preview-a,#542038),
      var(--preview-b,#171326)
    );
}

.image-preview img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

.image-preview::after {
  content: "EVENT ART PREVIEW";

  position: absolute;

  left: 10px;
  bottom: 9px;

  padding:
    5px 7px;

  border-radius: 6px;

  color: white;

  background:
    rgba(0,0,0,.45);

  font-size: 6px;
  font-weight: 700;

  letter-spacing: .12em;
}


/* =========================================================
   PASS EDITOR
========================================================= */

.pass-editor-list {
  display: flex;
  flex-direction: column;

  gap: 7px;
}

.pass-editor-row {
  display: grid;

  grid-template-columns:
    minmax(0,1fr)
    86px
    34px;

  gap: 6px;

  align-items: center;
}

.pass-editor-row
.pass-note {
  grid-column:
    1 / 3;
}

.pass-editor-row input {
  min-height: 40px;

  border-radius: 10px;

  font-size: 9px;
}

.remove-pass {
  width: 34px;
  height: 40px;

  display: grid;
  place-items: center;

  grid-column: 3;
  grid-row:
    1 / span 2;

  border-radius: 10px;

  color: #ff8c94;

  background:
    var(--red-soft);
}

.add-pass-btn {
  width: 100%;

  min-height: 41px;

  margin-top: 8px;

  border:
    1px dashed
    rgba(108,129,239,.30);

  border-radius: 12px;

  color: #91a5ff;

  background:
    rgba(49,87,237,.06);

  font-size: 9px;
  font-weight: 700;
}


/* =========================================================
   DATE PRICING
========================================================= */

.date-pricing-list {
  display: flex;
  flex-direction: column;

  gap: 8px;
}

.date-price-card {
  overflow: hidden;

  border:
    1px solid
    var(--line);

  border-radius: 14px;

  background:
    rgba(255,255,255,.02);
}

.date-price-head {
  display: flex;
  align-items: center;

  gap: 8px;

  padding:
    10px 11px;
}

.date-badge {
  width: 45px;
  height: 45px;

  flex: none;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  color: #aab8ff;

  background:
    var(--blue-soft);
}

.date-badge strong {
  font-size: 13px;
}

.date-badge span {
  margin-top: -1px;

  font-size: 6px;
  font-weight: 700;

  text-transform: uppercase;
}

.date-price-copy {
  flex: 1;
  min-width: 0;
}

.date-price-copy b {
  display: block;

  font-size: 10px;
}

.date-price-copy span {
  display: block;

  margin-top: 2px;

  color: var(--faint);

  font-size: 7.5px;
}

.date-price-actions {
  display: flex;

  gap: 5px;
}

.small-action {
  min-height: 32px;

  padding:
    0 9px;

  border:
    1px solid
    var(--line);

  border-radius: 9px;

  color: var(--muted);

  background:
    var(--surface-2);

  font-size: 7px;
  font-weight: 600;
}

.small-action.blue {
  color: #9eafff;

  background:
    var(--blue-soft);
}

.date-price-custom {
  padding:
    10px;

  border-top:
    1px solid
    var(--line);
}

.date-copy-actions {
  display: flex;
  flex-wrap: wrap;

  gap: 5px;

  margin-top: 8px;
}


/* =========================================================
   EDITOR BOTTOM BAR
========================================================= */

.editor-bottom {
  position: absolute;

  left: 0;
  right: 0;
  bottom: 0;

  z-index: 10;

  display: grid;

  grid-template-columns:
    1fr 1.7fr;

  gap: 8px;

  padding:
    10px
    13px
    calc(10px + var(--safe-bottom));

  border-top:
    1px solid
    var(--line);

  background:
    rgba(13,14,20,.96);

  backdrop-filter:
    blur(18px);
}


/* =========================================================
   MODAL / CONFIRM
========================================================= */

.confirm-overlay {
  position: fixed;
  inset: 0;

  z-index: 1500;

  display: none;
  place-items: center;

  padding: 20px;

  background:
    rgba(4,5,8,.77);

  backdrop-filter:
    blur(5px);
}

.confirm-overlay.open {
  display: grid;
}

.confirm-card {
  width:
    min(
      100%,
      380px
    );

  padding: 18px;

  border:
    1px solid
    var(--line-2);

  border-radius: 20px;

  background:
    #15161e;

  box-shadow:
    0 30px 90px
    rgba(0,0,0,.45);
}

.confirm-card h3 {
  font-size: 17px;
}

.confirm-card p {
  margin-top: 7px;

  color: var(--muted);

  font-size: 10px;
  line-height: 1.5;
}

.confirm-actions {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 7px;

  margin-top: 16px;
}


/* =========================================================
   EMPTY
========================================================= */

.empty-state {
  padding:
    35px 20px;

  text-align: center;

  color: var(--muted);

  border:
    1px dashed
    var(--line-2);

  border-radius: 17px;
}

.empty-state strong {
  display: block;

  color: var(--ink);

  font-size: 13px;
}

.empty-state span {
