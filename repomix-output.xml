function locationIcon() {

  return `

    <svg class="ic" viewBox="0 0 24 24">

      <path
        d="
          M12 21
          s-6.5-5.2-6.5-10
          a6.5 6.5 0 0 1 13 0
          c0 4.8-6.5 10-6.5 10
          z
        "
      ></path>

      <circle
        cx="12"
        cy="10.5"
        r="2.3"
      ></circle>

    </svg>

  `;

}


function eventMapURL(
  event
) {

  const direct =
    String(
      event?.mapUrl ||
      ""
    )
    .trim();


  if (
    /^https?:\/\//i.test(
      direct
    )
  ) {

    return direct;
  }


  const query =
    [
      event?.address,
      event?.venue,
      event?.area,
      SCENEZY.city
    ]
    .filter(
      Boolean
    )
    .join(
      ", "
    );


  return (
    "https://www.google.com/maps/search/?api=1&query=" +
    encodeURIComponent(
      query
    )
  );
}


function openEventMap(
  event
) {

  const url =
    eventMapURL(
      event
    );


  const opened =
    window.open(
      url,
      "_blank",
      "noopener"
    );


  if (
    !opened
  ) {

    window.location.href =
      url;

  }

}


/* =========================================================
   EVENT DETAIL
========================================================= */

function openDetail(
  event,
  {
    syncUrl = true,
    replaceUrl = false,
    hapticFeedback = true
  } = {}
) {

  if (!event) {
    return;
  }


  if (
    syncUrl
  ) {

    const currentPath =
      scenezyCanonicalPath(
        normalizedScenezyPath()
      );


    if (
      !currentPath.startsWith(
        "/events/"
      )
    ) {
      state.returnPath =
        currentPath;
    }


    const method =
      replaceUrl
      ?
      "replaceState"
      :
      "pushState";


    history[method](
      {
        scenezyEvent: true,
        returnPath:
          state.returnPath ||
          "/"
      },
      "",
      eventRoute(event)
    );
  }


  closeLandingScreen();


  state.current =
    event;


  applyEventSEO(
    event
  );


  state.selectedNight[
    event.id
  ] ??= 0;


  state.selectedPass[
    event.id
  ] ??= 0;


  state.quantity[
    event.id
  ] ??= 1;


  $("#detailPoster")
    .innerHTML =
    posterHTML(
      event
    );


  $("#detailTitle")
    .textContent =
    event.name;


  $("#detailTagline")
    .textContent =
    event.tagline;


  $("#facts")
    .innerHTML =
    `

      <div class="fact">

        ${calendarIcon()}

        <small>
          Dates
        </small>

        <strong>

          ${
            escapeHTML(
              event.dateLabel
            )
          }

        </strong>

      </div>


      <div class="fact price">

        ${ticketIcon()}

        <small>
          Entry
        </small>

        <strong>

          ${
            priceText(
              eventBasePrice(
                event
              )
            )
          }

        </strong>

      </div>


      <button
        class="fact full factMap"
        id="factMap"
        type="button"
        aria-label="Open location in Google Maps"
      >

        ${locationIcon()}

        <small>
          Location
        </small>

        <strong>

          ${
            escapeHTML(
              event.address
            )
          }

        </strong>

        <span class="mapCue">
          Open in Maps ↗
        </span>

      </button>

    `;


  $("#factMap")
    ?.addEventListener(
      "click",
      () =>
        openEventMap(
          event
        )
    );


  renderNights();

  renderPassTypes();

  renderQuantity();

  renderRating();

  syncSummary();

  syncSaveUI();


  $("#detail")
    .classList
    .add(
      "open"
    );


  $("#detailBody")
    .scrollTop =
    0;


  if (
    hapticFeedback
  ) {
    haptic(7);
  }

}


$("#detailBack")
