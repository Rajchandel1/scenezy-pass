/* =========================================================
   BARCODE
========================================================= */

function barcode(
  reference,
  height = 14
) {

  let x = 3;

  let result = "";


  const source =
    (
      reference +
      [...reference]
        .reverse()
        .join("")
    )
    .toUpperCase();


  for (
    const character
    of source
  ) {

    const code =
      character.charCodeAt(0);


    const width =
      1 +
      (
        code %
        3
      );


    const gap =
      1 +
      (
        code %
        2
      );


    result += `

      <rect
        x="${x}"
        y="0"
        width="${width}"
        height="${height}"
      ></rect>

    `;


    x +=
      width +
      gap;


    if (
      x >
      215
    ) {

      break;

    }

  }


  return result;

}


