/* ---------------------------------------------------------
   SUPABASE ROW → SCENEZY EVENT
--------------------------------------------------------- */

function scenezyEventFromRow(
  row
) {

  const source =
    row?.data &&
    typeof row.data ===
    "object"
    ?
    row.data
    :
    {};


  return {

    ...source,

    id:
      String(
        row.id ||
        source.id ||
        ""
      ),

    visible:
      row.visible !==
      false,

    mapUrl:
      source.mapUrl ||
      "",

    createdAt:
      row.created_at
      ?
      Date.parse(
        row.created_at
      )
      :
      Date.now(),

    updatedAt:
      row.updated_at
      ?
      Date.parse(
        row.updated_at
      )
      :
      Date.now()

  };
}


