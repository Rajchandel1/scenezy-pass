}


function leadStatusOptions(
  current
) {

  return [
    "New",
    "Contacted",
    "Converted",
    "Lost"
  ]
  .map(
    status => `

      <option
        value="${status}"

        ${
          status ===
          current
          ?
          "selected"
          :
          ""
        }
      >
        ${status}
      </option>

    `
  )
  .join("");

}


function bindLeadActions() {

  $$("[data-lead-status]")
    .forEach(
      select => {

        select.onchange =
          () => {

            updateLeadStatus(
              select.dataset.leadStatus,
              select.value
            );

          };

      }
    );


  $$("[data-lead-revenue]")
    .forEach(
      input => {

        input.onchange =
          () => {

            const lead =
              database.leads.find(
                item =>
                  item.id ===
                  input.dataset.leadRevenue
              );


            if (
              !lead
            ) {

              return;

            }


            lead.revenue =
              Math.max(
                0,
                Number(
                  input.value ||
                  0
                )
              );


            addActivity(
              `Revenue updated for ${lead.eventName}`
            );


            saveDatabase();


            toast(
              "Revenue updated"
            );

          };

      }
    );

}


function updateLeadStatus(
  id,
  status
) {

  const lead =
    database.leads.find(
      item =>
        item.id ===
        id
    );


  if (
    !lead
  ) {

    return;

  }


  lead.status =
    status;


  if (
    status ===
    "Converted"
  ) {

    lead.convertedAt ??=
      Date.now();


    if (
      lead.revenue ===
      null ||
      lead.revenue ===
      undefined
    ) {

      lead.revenue =
        Number(
          lead.expectedAmount ||
          0
        );

    }

  } else {

    lead.convertedAt =
      null;

  }


  addActivity(
    `${lead.eventName} lead → ${status}`
  );


  saveDatabase();


  toast(
    `Lead marked ${status}`
  );

}


