/* =========================================================
   WHATSAPP BOOKING
========================================================= */

function bookingReference(
  event
) {

  const initials =
    event.name
      .split(/\s+/)
      .map(
        word =>
          word[0]
      )
      .join("")
      .toUpperCase()
      .slice(0,3);


  return (
    `SZ-${initials}-` +
    Math.random()
      .toString(36)
      .slice(2,6)
      .toUpperCase()
  );

}


function createBooking() {

  const event =
    state.current;


  const night =
    currentNight();


  const pass =
    currentPass();


  const quantity =
    state.quantity[
      event.id
    ];


  const total =
    currentTotal();


  const reference =
    bookingReference(
      event
    );


  const nightText =
    night
    ?
    `${night.day}, ${night.date} 2026`
    :
    event.dateLabel;


  const message =
`Namaste Scenezy 🙏

I want to book passes:

Event: ${event.name}
Venue: ${event.venue}, ${event.area}
Night: ${nightText}
Pass: ${pass?.name || "To be confirmed"}
Quantity: ${quantity}
Amount: ${priceText(total)}

Booking Ref: ${reference}`;


  return {

    ref:
      reference,

    eventId:
      event.id,

    event:
      event.name,

    venue:
      `${event.venue}, ${event.area}`,

    night:
      nightText,

    pass:
      pass?.name ||
      "TBA",

    qty:
      quantity,

    total,

    message,

    whatsappURL:
      `https://wa.me/${SCENEZY.whatsapp}?text=${encodeURIComponent(message)}`,

    createdAt:
      Date.now()

  };

}


let bookingRedirectTimer;


$("#bookBtn")
  .onclick =
  () => {

    if (
      !state.current
    ) {
      return;
    }


    const button =
      $("#bookBtn");


    if (
      button.disabled
    ) {
      return;
    }


    const booking =
      createBooking();


    booking.receiptShown =
      true;


    state.lastTicket =
      booking;


    /*
       1. Lead is queued instantly.
       2. Receipt prints on Scenezy.
       3. Only after the print animation do we hand off
          to WhatsApp.
    */

    registerWhatsAppLead(
      booking
    );


    try {

      sessionStorage.setItem(

        STORAGE.pending,

        JSON.stringify(
          booking
        )

      );

    } catch {}


    button.disabled =
      true;


    $("#bookBtnText")
      .textContent =
      "Printing your receipt…";


    showPrintedTicket(
      booking,
      true
    );


    toast(
      "Receipt ready · opening WhatsApp next"
    );


    clearTimeout(
      bookingRedirectTimer
    );


    bookingRedirectTimer =
      setTimeout(
        () => {

          $("#bookBtnText")
            .textContent =
            "Opening WhatsApp…";


          /*
             Same-tab handoff is deliberate:
             delayed window.open() is commonly blocked
             by mobile browsers after an animation.
          */

          window.location.href =
            booking.whatsappURL;

        },
        2200
      );

  };


/* =========================================================
   RETURN FROM WHATSAPP
========================================================= */

let returnHandled =
  false;


function getPendingBooking() {

  try {

    const value =
      sessionStorage.getItem(
        STORAGE.pending
      );


    return (
      value
      ?
      JSON.parse(
        value
      )
      :
      null
    );

  } catch {

    return null;

  }

}


function handleReturn() {

  const booking =
    getPendingBooking();


  if (
    !booking ||
    returnHandled
  ) {
    return;
  }


  /*
     Ignore focus noise while the receipt is still printing.
  */

  if (
    Date.now() -
    booking.createdAt <
    2300
  ) {
    return;
  }


  returnHandled =
    true;


  sessionStorage.removeItem(
    STORAGE.pending
  );


  state.lastTicket =
    booking;


  /*
     The receipt animation already ran BEFORE WhatsApp.
     On return we restore it without replaying the printer.
  */

  showPrintedTicket(
    booking,
    false
  );


  const button =
    $("#bookBtn");


  if (
    button
  ) {

    button.disabled =
      false;

  }


  $("#bookBtnText")
    .textContent =
    "Book on WhatsApp";


  setTimeout(
    () => {

      returnHandled =
        false;

    },
    1000
  );

}


document.addEventListener(
  "visibilitychange",
  () => {

    if (
      document.visibilityState ===
      "visible"
    ) {

      setTimeout(
        handleReturn,
        300
      );

    }

  }
);


window.addEventListener(
  "focus",
  () => {

    setTimeout(
      handleReturn,
      350
    );

  }
);


window.addEventListener(
  "pageshow",
  () => {

    setTimeout(
      handleReturn,
      250
    );

  }
);


/* =========================================================
   RECEIPT
========================================================= */

function showPrintedTicket(
  ticket,
  animate = true
) {

  const event =
    EVENTS.find(
      event =>
        event.id ===
        ticket.eventId
    );


  $("#ticketArt")
    .innerHTML =
    event
    ?
    posterHTML(
      event
    )
    :
    "";


  $("#ticketEvent")
    .textContent =
    ticket.event;


  $("#ticketVenue")
    .textContent =
    ticket.venue;


  $("#ticketNight")
    .textContent =
    ticket.night;


  $("#ticketPass")
    .textContent =
    ticket.pass;


  $("#ticketQty")
    .textContent =
    ticket.qty;


  $("#ticketRef")
    .textContent =
    ticket.ref;


  $("#ticketTotal")
    .textContent =
    priceText(
      ticket.total
    );


  $("#ticketBarcode")
    .innerHTML =
    barcode(
      ticket.ref,
      34
    );


  $("#ticketScreen")
    .classList
    .add(
      "open"
    );


  $("#ticketBody")
    .scrollTop =
    0;


  const paper =
    $("#ticketPaper");


  const printer =
    $("#printer");


  paper.classList.remove(
    "printing"
  );


  printer.classList.remove(
    "printing"
  );


  void paper.offsetWidth;


  if (
    animate
  ) {

    paper.classList.add(
      "printing"
    );


    printer.classList.add(
      "printing"
    );


    setTimeout(
      () => {

        printer.classList.remove(
          "printing"
        );


        confettiBurst();

      },
      1900
    );

  }

}


function closeReceipt() {

  $("#ticketScreen")
    .classList
    .remove(
      "open"
    );

}


$("#ticketClose")
  .onclick =
  closeReceipt;


$("#ticketDone")
  .onclick =
  closeReceipt;


$("#ticketWhatsApp")
  .onclick =
  () => {

    if (
      state.lastTicket
    ) {

      window.open(
        state.lastTicket.whatsappURL,
        "_blank"
      );

    }

  };


/* =========================================================
   CONFETTI
========================================================= */

const confettiCanvas =
  $("#confetti");


const ctx =
  confettiCanvas.getContext(
    "2d"
  );


let particles = [];

let confettiFrame;


function confettiBurst() {

  confettiCanvas.width =
    innerWidth;


  confettiCanvas.height =
    innerHeight;


  const colours = [

    "#3157ed",

    "#f4eddf",

    "#ddb454",

    "#93a7ff",

    "#ffffff"

  ];


  function spawn(
    x,
    y,
    direction
  ) {

    for (
      let i = 0;
      i < 90;
      i++
    ) {

      const angle =
        direction +
        (
          Math.random() -
          .5
        ) *
        .95;


      const speed =
        8 +
        Math.random() *
        8;


      particles.push({

        x,

        y,

        vx:
          Math.cos(angle) *
          speed,

        vy:
          Math.sin(angle) *
          speed,

        gravity:
          .22 +
          Math.random() *
          .09,

        size:
          4 +
          Math.random() *
          5,

        rotation:
          Math.random() *
          Math.PI,

        rotationVelocity:
          (
            Math.random() -
            .5
          ) *
          .3,

        colour:
          colours[
            Math.floor(
              Math.random() *
              colours.length
            )
          ],

        life:
          1

      });

    }

  }


  spawn(
    0,
    confettiCanvas.height *
    .74,
    -Math.PI / 3
  );


  spawn(
    confettiCanvas.width,
    confettiCanvas.height *
    .74,
    -Math.PI +
    Math.PI / 3
  );


  cancelAnimationFrame(
    confettiFrame
  );


  function animate() {

    ctx.clearRect(
      0,
      0,
      confettiCanvas.width,
      confettiCanvas.height
    );


    particles =
      particles.filter(
        particle =>
          particle.life > 0
      );


    particles.forEach(
      particle => {

        particle.vy +=
          particle.gravity;


        particle.vx *=
          .988;


        particle.x +=
          particle.vx;


        particle.y +=
          particle.vy;


        particle.rotation +=
          particle.rotationVelocity;


        particle.life -=
          .009;


        ctx.save();


        ctx.globalAlpha =
          Math.max(
            0,
            particle.life
          );


        ctx.translate(
          particle.x,
          particle.y
        );


        ctx.rotate(
          particle.rotation
        );


        ctx.fillStyle =
          particle.colour;


        ctx.fillRect(

          -particle.size / 2,

          -particle.size / 2,

          particle.size,

          particle.size * .62

        );


        ctx.restore();

      }
    );


    if (
      particles.length
    ) {

      confettiFrame =
        requestAnimationFrame(
          animate
        );

    } else {

      ctx.clearRect(
        0,
        0,
        confettiCanvas.width,
        confettiCanvas.height
      );

    }

  }


  animate();

}


/* =========================================================
   KEYBOARD
========================================================= */

window.addEventListener(
  "keydown",
  keyboardEvent => {

    if (
      keyboardEvent.key ===
      "Escape"
    ) {

      if (
        $("#shareOverlay")
          .classList
          .contains(
            "open"
          )
      ) {

        closeShareFallback();

        return;

      }


      if (
        $("#ratingOverlay")
          .classList
          .contains(
            "open"
          )
      ) {

        $("#ratingOverlay")
          .classList
          .remove(
            "open"
          );

        return;

      }


      if (
        $("#detail")
          .classList
          .contains(
            "open"
          )
      ) {

        $("#detail")
          .classList
          .remove(
            "open"
          );

        return;

      }


      closeScreens();

    }


    if (
      $("#detail")
        .classList
        .contains(
          "open"
        ) ||
      $(".screen.open")
    ) {

      return;

    }


    if (
      keyboardEvent.key ===
      "ArrowRight"
    ) {

      moveDeck(1);

    }


    if (
      keyboardEvent.key ===
      "ArrowLeft"
    ) {

      moveDeck(-1);

    }

  }
);


/* =========================================================
   RESIZE
========================================================= */

let resizeTimer;


window.addEventListener(
  "resize",
  () => {

    clearTimeout(
      resizeTimer
    );


    resizeTimer =
      setTimeout(
        () => {

          resizeDeck();

          renderDeck(
            state.position
          );

        },
        50
      );

  }
);


/* =========================================================
   BOOT
========================================================= */

function boot() {

  /*
     Lightning-fast first paint:
     cached/fallback data renders immediately.
  */

  loadEventsFromLocalStorage();


  $("#homeKicker")
    .textContent =
    `${SCENEZY.season} · ${SCENEZY.city}`;


  loadSaved();


  if (
    TOTAL >
    0
  ) {

    buildDeck();

  } else {

    showNoLiveEvents();

  }


  buildRatingWheel();

  renderSearch();

  updatePassBadge();


  /*
     Network work starts after the UI is interactive.
  */

  setTimeout(
    () => {

      if (
        sb
      ) {

        fetchScenezyFromSupabase({
          rebuild: true,
          notify: false
        });


        startScenezyRealtime();

        flushLeadOutbox();

        reconcileSavedEvents();

      }

    },
    0
  );

}


/*
   Legacy local testing support:
   if an older Admin tab still writes scenezy.shared.v1,
   refresh from that cache without breaking production mode.
*/

window.addEventListener(
  "storage",
  event => {

    if (
      event.key !==
      SCENEZY_LEGACY_SHARED_KEY
    ) {
      return;
    }


    if (
      sb
    ) {
      return;
    }


    const legacy =
      readScenezyCache();


    if (
      legacy
    ) {

      applyScenezyPublicData(
        legacy
      );


      refreshScenezyUI(
        true
      );

    }

  }
);

boot();
</script>

