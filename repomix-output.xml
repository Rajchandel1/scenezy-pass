  height: 45px;

  flex: none;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  color: #aab8ff;

  background:
    var(--blue-soft);
}

.date-badge strong {
  font-size: 13px;
}

.date-badge span {
  margin-top: -1px;

  font-size: 6px;
  font-weight: 700;

  text-transform: uppercase;
}

.date-price-copy {
  flex: 1;
  min-width: 0;
}

.date-price-copy b {
  display: block;

  font-size: 10px;
}

.date-price-copy span {
  display: block;

  margin-top: 2px;

  color: var(--faint);

  font-size: 7.5px;
}

.date-price-actions {
  display: flex;

  gap: 5px;
}

.small-action {
  min-height: 32px;

  padding:
    0 9px;

  border:
    1px solid
    var(--line);

  border-radius: 9px;

  color: var(--muted);

  background:
    var(--surface-2);

  font-size: 7px;
  font-weight: 600;
}

.small-action.blue {
  color: #9eafff;

  background:
    var(--blue-soft);
}

.date-price-custom {
  padding:
    10px;

  border-top:
    1px solid
    var(--line);
}

.date-copy-actions {
  display: flex;
  flex-wrap: wrap;

  gap: 5px;

  margin-top: 8px;
}


/* =========================================================
   EDITOR BOTTOM BAR
========================================================= */

.editor-bottom {
  position: absolute;

  left: 0;
  right: 0;
  bottom: 0;

  z-index: 10;

  display: grid;

  grid-template-columns:
    1fr 1.7fr;

  gap: 8px;

  padding:
    10px
    13px
    calc(10px + var(--safe-bottom));

  border-top:
    1px solid
    var(--line);

  background:
    rgba(13,14,20,.96);

  backdrop-filter:
    blur(18px);
}


/* =========================================================
   MODAL / CONFIRM
========================================================= */

.confirm-overlay {
  position: fixed;
  inset: 0;

  z-index: 1500;

  display: none;
  place-items: center;

  padding: 20px;

  background:
    rgba(4,5,8,.77);

  backdrop-filter:
    blur(5px);
}

.confirm-overlay.open {
  display: grid;
}

.confirm-card {
  width:
    min(
      100%,
      380px
    );

  padding: 18px;

  border:
    1px solid
    var(--line-2);

  border-radius: 20px;

  background:
    #15161e;

  box-shadow:
    0 30px 90px
    rgba(0,0,0,.45);
}

.confirm-card h3 {
  font-size: 17px;
}

.confirm-card p {
  margin-top: 7px;

  color: var(--muted);

  font-size: 10px;
  line-height: 1.5;
}

.confirm-actions {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 7px;

  margin-top: 16px;
}


/* =========================================================
   EMPTY
========================================================= */

.empty-state {
  padding:
    35px 20px;

  text-align: center;

  color: var(--muted);

  border:
    1px dashed
    var(--line-2);

  border-radius: 17px;
}

.empty-state strong {
  display: block;

  color: var(--ink);

  font-size: 13px;
}

.empty-state span {
  display: block;

  max-width: 320px;

  margin:
    5px auto 0;

  font-size: 9px;
  line-height: 1.5;
}


/* =========================================================
   TOAST
========================================================= */

.toast {
  position: fixed;

  left: 50%;
  bottom:
    calc(86px + var(--safe-bottom));

  z-index: 2000;

  max-width:
    calc(100% - 30px);

  padding:
    10px 14px;

  border:
    1px solid
    var(--line-2);

  border-radius: 999px;

  color: var(--ink);

  background:
    rgba(40,42,53,.97);

  box-shadow:
    0 10px 30px
    rgba(0,0,0,.3);

  font-size: 9px;

  opacity: 0;

  pointer-events: none;

  transform:
    translate(-50%,12px);

  transition:
    opacity .22s ease,
    transform .22s ease;
}

.toast.show {
  opacity: 1;

  transform:
    translate(-50%,0);
}


