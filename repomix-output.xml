}


function startScenezyRealtime() {

  if (
    !sb ||
    publicRealtimeChannel
  ) {
    return;
  }


  publicRealtimeChannel =
    sb
      .channel(
        "scenezy-public-live"
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "events"
        },
        schedulePublicRefresh
      )
      .on(
        "postgres_changes",
        {
          event: "*",
          schema: "public",
          table: "settings"
        },
        schedulePublicRefresh
      )
      .subscribe();

}


/* ---------------------------------------------------------
   BOOKING LEAD OUTBOX

   WhatsApp is never blocked by a slow network.
   The lead is queued locally, then flushed to Supabase.
--------------------------------------------------------- */

function readLeadOutbox() {

  try {

    const value =
      JSON.parse(
        localStorage.getItem(
          SCENEZY_LEAD_OUTBOX_KEY
        )
      );


    return Array.isArray(
      value
    )
    ?
    value
    :
    [];

  } catch {

    return [];

  }

}


function writeLeadOutbox(
  leads
) {

  try {

    localStorage.setItem(
      SCENEZY_LEAD_OUTBOX_KEY,
      JSON.stringify(
        leads
      )
    );

  } catch {}

}


function bookingToLead(
  booking
) {

  return {

    id:
      "lead_" +
      Date.now()
        .toString(36) +
      "_" +
      Math.random()
        .toString(36)
        .slice(
          2,
          7
        ),

    eventId:
      booking.eventId,

    eventName:
      booking.event,

    ref:
      booking.ref,

    night:
      booking.night,

    passName:
      booking.pass,

    quantity:
      booking.qty,

    expectedAmount:
      booking.total,

    source:
      "WhatsApp CTA",

    status:
      "New",

    revenue:
      null,

    clickedAt:
      Date.now(),

    convertedAt:
      null

  };
}


function leadToSupabaseRow(
  lead
) {

  return {

    id:
      lead.id,

    event_id:
      lead.eventId,

    event_name:
      lead.eventName,

    booking_ref:
      lead.ref,

    night:
      lead.night,

    pass_name:
      lead.passName,

    quantity:
      lead.quantity,

    expected_amount:
      lead.expectedAmount,

    source:
      lead.source ||
      "WhatsApp CTA",

    status:
      lead.status ||
      "New",

    revenue:
      lead.revenue,

    clicked_at:
      new Date(
        lead.clickedAt ||
        Date.now()
      )
      .toISOString(),

    converted_at:
      lead.convertedAt
      ?
      new Date(
        lead.convertedAt
      )
      .toISOString()
      :
      null,

    updated_at:
      new Date()
        .toISOString()

  };
}


let leadOutboxFlushing =
  false;


async function flushLeadOutbox() {

  if (
    !sb ||
    leadOutboxFlushing
  ) {
    return;
  }


  const pending =
    readLeadOutbox();


  if (
    !pending.length
  ) {
    return;
  }


  leadOutboxFlushing =
    true;


  const remaining =
    [];


  try {

    for (
      const lead
      of pending
    ) {

      try {

        const {
          error
        } =
          await sb
            .from(
              "leads"
            )
            .insert(
              leadToSupabaseRow(
                lead
              )
            );


        /*
           If a retry reaches Supabase after the original
           insert already succeeded, a duplicate primary key
           means the lead is safely stored and can leave the
           outbox.
        */

        if (
          error &&
          error.code !==
          "23505"
        ) {
          throw error;
        }

      } catch (
        error
      ) {

        console.warn(
          "Lead sync queued for retry",
          error
        );


        remaining.push(
          lead
        );

      }

    }


    writeLeadOutbox(
      remaining
    );

  } finally {

    leadOutboxFlushing =
      false;

  }

}


function registerWhatsAppLead(
  booking
) {

  const lead =
    bookingToLead(
      booking
    );


  const pending =
    readLeadOutbox();


  pending.unshift(
    lead
  );


  writeLeadOutbox(
    pending
  );


  flushLeadOutbox();


  return lead;
}


/* ---------------------------------------------------------
   SAVED EVENTS
   Local-first = instant.
   Supabase = lightweight anonymous device backup.
--------------------------------------------------------- */

function getScenezyDeviceId() {

  let id =
    localStorage.getItem(
      SCENEZY_DEVICE_KEY
    );


  if (
    !id
  ) {

    id =
      "dev_" +
      Date.now()
        .toString(36) +
      "_" +
      Math.random()
        .toString(36)
        .slice(
          2,
          10
        );


    try {

      localStorage.setItem(
        SCENEZY_DEVICE_KEY,
        id
      );

    } catch {}

  }


  return id;
}


async function syncSavedEventRemote(
  eventId,
  saved
) {

  if (
    !sb
  ) {
    return;
  }


  const deviceId =
    getScenezyDeviceId();


  try {

    if (
      saved
    ) {

      const {
        error
      } =
        await sb
          .from(
            "saved_events"
          )
          .upsert(
            {
              device_id:
                deviceId,

              event_id:
                eventId
            },
            {
              onConflict:
                "device_id,event_id"
            }
          );


      if (
        error
      ) {
        throw error;
      }

    } else {

      const {
        error
      } =
        await sb
          .from(
            "saved_events"
          )
          .delete()
          .eq(
            "device_id",
            deviceId
          )
          .eq(
            "event_id",
            eventId
          );


      if (
        error
      ) {
        throw error;
      }

    }

  } catch (error) {

    console.warn(
      "Saved-event cloud sync skipped",
      error
    );

  }

}


async function reconcileSavedEvents() {

  if (
    !sb
  ) {
    return;
  }


  const hadLocalSnapshot =
    localStorage.getItem(
      STORAGE.saved
    ) !==
    null;


  const deviceId =
    getScenezyDeviceId();


  try {

    const {
      data,
      error
    } =
      await sb
        .from(
          "saved_events"
        )
        .select(
          "event_id"
        )
        .eq(
          "device_id",
          deviceId
        );


    if (
      error
    ) {
      throw error;
    }


    const remoteIds =
      new Set(
        (
          data ||
          []
        )
        .map(
          row =>
            row.event_id
        )
      );


    if (
      !hadLocalSnapshot &&
      remoteIds.size
    ) {

      state.saved =
        remoteIds;


      persistSaved();

      syncSaveUI();

      updatePassBadge();


      return;
    }


    const localIds =
      new Set(
        state.saved
      );


    const missingRemote =
      [
        ...localIds
      ]
      .filter(
        id =>
          !remoteIds.has(
            id
          )
      );


    if (
      missingRemote.length
    ) {

      const {
        error:
          insertError
      } =
        await sb
          .from(
            "saved_events"
          )
          .upsert(
            missingRemote.map(
              eventId => ({
                device_id:
                  deviceId,

                event_id:
                  eventId
              })
            ),
            {
              onConflict:
                "device_id,event_id"
            }
          );


      if (
        insertError
      ) {
        throw insertError;
      }

    }


    const staleRemote =
      [
        ...remoteIds
      ]
      .filter(
        id =>
          !localIds.has(
            id
          )
      );


    if (
      staleRemote.length
    ) {

      const {
        error:
          deleteError
      } =
        await sb
          .from(
            "saved_events"
          )
          .delete()
          .eq(
            "device_id",
            deviceId
          )
          .in(
            "event_id",
            staleRemote
          );


      if (
        deleteError
      ) {
        throw deleteError;
      }

    }

  } catch (error) {

    console.warn(
      "Saved events remain available locally.",
      error
    );

  }

}


