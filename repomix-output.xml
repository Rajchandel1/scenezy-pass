/* =========================================================
   DECK MOVEMENT
========================================================= */

function settleDeck(
  target
) {

  $("#swipeHint")
    .classList
    .add(
      "hide"
    );


  const oldIndex =
    state.active;


  const rounded =
    Math.round(
      state.position
    );


  let adjusted =
    target;


  if (
    target >=
    0 &&
    target <
    TOTAL
  ) {

    const current =
      mod(
        rounded,
        TOTAL
      );


    let difference =
      target -
      current;


    if (
      difference >
      TOTAL /
      2
    ) {

      difference -=
        TOTAL;

    }


    if (
      difference <
      -TOTAL /
      2
    ) {

      difference +=
        TOTAL;

    }


    adjusted =
      rounded +
      difference;

  }


  const motion =
    ++state.motionId;


  tween(
    state.position,
    adjusted,
    480,

    value => {

      if (
        motion !==
        state.motionId
      ) return;


      state.position =
        value;


      renderDeck(
        value
      );

    },

    () => {

      if (
        motion !==
        state.motionId
      ) return;


      state.position =
        adjusted;


      renderDeck(
        adjusted
      );


      const newIndex =
        mod(
          Math.round(
            adjusted
          ),
          TOTAL
        );


      syncHome(
        newIndex ===
        oldIndex
      );

    }
  );


  haptic(5);

}


function moveDeck(
  direction
) {

  settleDeck(
    Math.round(
      state.position
    ) +
    direction
  );

}


$("#prevBtn")
  .onclick =
  () =>
    moveDeck(-1);


$("#nextBtn")
  .onclick =
  () =>
    moveDeck(1);


/* =========================================================
   DECK SWIPE
========================================================= */

stage.addEventListener(
  "pointerdown",
  pointerEvent => {

    if (
      pointerEvent.target.closest(
        ".deckControls"
      ) ||
      pointerEvent.target.closest(
        ".cardSave"
      )
    ) {

      return;

    }


    ++state.motionId;


    state.drag = {

      startX:
        pointerEvent.clientX,

      startY:
        pointerEvent.clientY,

      lastX:
        pointerEvent.clientX,

      lastTime:
        performance.now(),

      base:
        state.position,

      velocity:
        0,

      moved:
        false,

      card:
        pointerEvent.target.closest(
          ".eventCard"
        )

    };


    stage.setPointerCapture(
      pointerEvent.pointerId
    );

  }
);


stage.addEventListener(
  "pointermove",
  pointerEvent => {

    if (
      !state.drag
    ) return;


    const drag =
      state.drag;


    const dx =
      pointerEvent.clientX -
      drag.startX;


    const dy =
      pointerEvent.clientY -
      drag.startY;


    if (
      Math.hypot(
        dx,
        dy
      ) >
      6
    ) {

      drag.moved = true;

    }


    const now =
      performance.now();


    const delta =
      Math.max(
        1,
        now -
        drag.lastTime
      );


    const instant =
      (
        pointerEvent.clientX -
        drag.lastX
      ) /
      delta;


    drag.velocity =
      drag.velocity *
      .72 +
      instant *
      .28;


    drag.lastX =
      pointerEvent.clientX;


    drag.lastTime =
      now;


    state.position =
      drag.base -
      dx /
      245;


    renderDeck(
      state.position,
      dx,
      dy
    );

  }
);


function finishDeckDrag() {

  const drag =
    state.drag;


  if (
    !drag
  ) return;


  state.drag = null;


  if (
    !drag.moved
  ) {

    if (
      drag.card
    ) {

      const index =
        Number(
          drag.card.dataset.index
        );


      const current =
        mod(
          Math.round(
            state.position
          ),
          TOTAL
        );


      if (
        index !==
        current
      ) {

        settleDeck(
          index
        );

      } else {

        openDetail(
          EVENTS[index]
        );

      }

    }


    return;

  }


  let target =
    Math.round(
      state.position -
      drag.velocity *
      .5
    );


  const base =
    Math.round(
      drag.base
    );


  if (
    Math.abs(
      target -
      base
    ) >
    1
  ) {

    target =
      base +
      Math.sign(
        target -
        base
      );

  }


  settleDeck(
    target
  );

}


stage.addEventListener(
  "pointerup",
  finishDeckDrag
);


stage.addEventListener(
  "pointercancel",
  finishDeckDrag
);


