function refreshScenezyUI(
  notify = false
) {

  const activeId =
    EVENTS[
      state.active
    ]?.id ||
    null;


  const currentId =
    state.current?.id ||
    null;


  const newActiveIndex =
    activeId
    ?
    EVENTS.findIndex(
      event =>
        event.id ===
        activeId
    )
    :
    -1;


  state.position =
    newActiveIndex >=
    0
    ?
    newActiveIndex
    :
    0;


  state.active =
    newActiveIndex >=
    0
    ?
    newActiveIndex
    :
    0;


  if (
    currentId
  ) {

    const updatedCurrent =
      EVENTS.find(
        event =>
          event.id ===
          currentId
      );


    if (
      updatedCurrent
    ) {

      state.current =
        updatedCurrent;

    } else {

      state.current =
        null;


      $("#detail")
        ?.classList
        .remove(
          "open"
        );

    }

  }


  const kicker =
    $("#homeKicker");


  if (kicker) {

    kicker.textContent =
      `${SCENEZY.season} · ${SCENEZY.city}`;

  }


  const prev =
    $("#prevBtn");


  const next =
    $("#nextBtn");


  if (
    TOTAL >
    0
  ) {

    if (prev) prev.hidden = false;
    if (next) next.hidden = false;


    buildDeck();

  } else {

    showNoLiveEvents();

  }


  renderSearch(
    $("#searchInput")
      ?.value ||
    ""
  );


  if (
    $("#passesScreen")
      ?.classList
      .contains(
        "open"
      )
  ) {

    renderMyPasses();

  }


  updatePassBadge();


  if (
    notify
  ) {

    toast(
      "Fresh event data loaded"
    );

  }

}


