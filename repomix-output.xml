function updatePassDots() {

  const track =
    $("#passTrack");


  if (
    !track ||
    !track.children.length
  ) return;


  const step =
    track.firstElementChild.offsetWidth +
    17;


  const active =
    Math.max(
      0,
      Math.min(
        track.children.length - 1,
        Math.round(
          track.scrollLeft /
          step
        )
      )
    );


  $$("#passDots i")
    .forEach(
      (
        dot,
        index
      ) => {

        dot.classList.toggle(
          "on",
          active === index
        );

      }
    );

}


$("#passTrack")
