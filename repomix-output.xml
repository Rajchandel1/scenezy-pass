/* =========================================================
   LOCAL IMAGE UPLOAD
   JS ITSELF ADDS THE FILE INPUT TO EXISTING ADMIN UI
========================================================= */

function compressScenezyImage(
  file,
  maxDimension = 900,
  quality = .72
) {

  return new Promise(
    (
      resolve,
      reject
    ) => {

      const reader =
        new FileReader();


      reader.onload =
        () => {

          const image =
            new Image();


          image.onload =
            () => {

              let width =
                image.naturalWidth ||
                image.width;


              let height =
                image.naturalHeight ||
                image.height;


              if (
                width >
                maxDimension ||
                height >
                maxDimension
              ) {

                const scale =
                  Math.min(

                    maxDimension /
                    width,

                    maxDimension /
                    height

                  );


                width =
                  Math.round(
                    width *
                    scale
                  );


                height =
                  Math.round(
                    height *
                    scale
                  );

              }


              const canvas =
                document.createElement(
                  "canvas"
                );


              canvas.width =
                width;


              canvas.height =
                height;


              const context =
                canvas.getContext(
                  "2d"
                );


              context.drawImage(

                image,

                0,
                0,

                width,
                height

              );


              let output;


              try {

                output =
                  canvas.toDataURL(
                    "image/webp",
                    quality
                  );

              } catch {

                output =
                  reader.result;

              }


              resolve(
                output
              );

            };


          image.onerror =
            () => {

              reject(
                new Error(
                  "Could not read image"
                )
              );

            };


          image.src =
            reader.result;

        };


      reader.onerror =
        () => {

          reject(
            new Error(
              "Could not read image"
            )
          );

        };


      reader.readAsDataURL(
        file
      );

    }
  );

}


/* ---------------------------------------------------------
   INSTALL UPLOAD UI
--------------------------------------------------------- */

function installScenezyImageUploader() {

  if (
    $("#scenezyLocalImageUpload")
  ) {

    return;

  }


  const imageInput =
    $("#fImage");


  if (
    !imageInput
  ) {

    return;

  }


  const imageField =
    imageInput.closest(
      ".field"
    );


  if (
    !imageField
  ) {

    return;

  }


  const uploadField =
    document.createElement(
      "div"
    );


  uploadField.className =
    "field";


  uploadField.innerHTML =
    `

      <label>
        Upload Event Image
      </label>


      <input
        id="scenezyLocalImageUpload"
        type="file"
        accept="image/jpeg,image/png,image/webp,image/*"
      >


      <small>
        Testing mode · image is compressed and saved
        inside browser localStorage.
      </small>

    `;


  imageField.insertAdjacentElement(
    "afterend",
    uploadField
  );


  $(
    "#scenezyLocalImageUpload"
  )
  .addEventListener(
    "change",
    async event => {

      const file =
        event.target.files?.[
          0
        ];


      if (
        !file
      ) {

        return;

      }


      if (
        !file.type.startsWith(
          "image/"
        )
      ) {

        toast(
          "Please select an image"
        );


        event.target.value =
          "";


        return;

      }


      toast(
        "Optimising image..."
      );


      try {

        const imageData =
          await compressScenezyImage(
            file
          );


        /*
           LocalStorage gets uncomfortable with huge Base64.
        */

        if (
          imageData.length >
          1200000
        ) {

          toast(
            "Image is large · a smaller image is recommended"
          );

        }


        $("#fImage").value =
          imageData;


        if (
          eventDraft
        ) {

          eventDraft.image =
            imageData;

        }


        updateImagePreview();


        toast(
          "Image saved locally"
        );

      } catch (
        error
      ) {

        console.error(
          error
        );


        toast(
          "Could not process image"
        );

      }


      event.target.value =
        "";

    }
  );

}


/* =========================================================
   LIVE USER → ADMIN SYNC

   When user clicks WhatsApp in another tab,
   lead instantly arrives here.
========================================================= */

window.addEventListener(
  "storage",
  event => {

    if (
      event.key !==
      ADMIN_CONFIG.storageKey
    ) {

      return;

    }


    if (
      !event.newValue
    ) {

      return;

    }


    try {

      const oldLeadCount =
        database.leads?.length ||
        0;


      const incoming =
        normalizeDatabase(
          JSON.parse(
            event.newValue
          )
        );


      database =
        incoming;


      renderAll();


      const newLeadCount =
        database.leads.length;


      if (
        newLeadCount >
        oldLeadCount
      ) {

        toast(
          "New WhatsApp lead received"
        );

      }

    } catch (
      error
    ) {

      console.error(
        "Live Scenezy sync failed",
        error
      );

    }

  }
);


/* =========================================================
   BOOT
========================================================= */

boot();


installScenezyImageUploader();
</script>

