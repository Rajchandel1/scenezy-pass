function renderSelectedNight() {

  const event =
    state.current;


  const nights =
    buildNights(
      event
    );


  if (
    !nights.length
  ) return;


  const night =
    nights[
      state.selectedNight[
        event.id
      ]
    ];


  const passes =
    passesForNight(
      event,
      night
    );


  const prices =
    passes
      .map(
        pass =>
          pass.price
      )
      .filter(
        price =>
          price !== null &&
          price !== undefined
      );


  const price =
    prices.length
    ?
    Math.min(...prices)
    :
    null;


  $("#selectedNight")
    .innerHTML =
    `

      <div class="selectedNightIcon">

        ${calendarIcon()}

      </div>


