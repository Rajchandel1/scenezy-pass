   REALTIME EVENT UPDATES
--------------------------------------------------------- */

function schedulePublicRefresh() {

  clearTimeout(
    remoteRefreshTimer
  );


  remoteRefreshTimer =
    setTimeout(
      () => {

        fetchScenezyFromSupabase({
          notify: true,
          rebuild: true
        });

