/* =========================================================
   TWEEN
========================================================= */

function tween(
  from,
  to,
  duration,
  update,
  complete
) {

  const start =
    performance.now();


  function frame(
    now
  ) {

    const raw =
      Math.min(
        1,
        (
          now -
          start
        ) /
        duration
      );


    const easing =
      1 -
      Math.pow(
        1 - raw,
        4
      );


    update(
      from +
      (
        to -
        from
      ) *
      easing
    );


    if (
      raw <
      1
    ) {

      requestAnimationFrame(
        frame
      );

    } else {

      complete?.();

    }

  }


  requestAnimationFrame(
    frame
  );

}


/* =========================================================
   ANIMATED EVENT NAME
========================================================= */

function animatedText(
  element,
  value
) {

  if (
    element.textContent ===
    value
  ) {

    return;

  }


  element.classList.remove(
    "textEnter",
    "textExit"
  );


  element.classList.add(
    "textExit"
  );


  setTimeout(
    () => {

      element.textContent =
        value;


      element.classList.remove(
        "textExit"
      );


      void element.offsetWidth;


      element.classList.add(
        "textEnter"
      );

    },
    140
  );

}


