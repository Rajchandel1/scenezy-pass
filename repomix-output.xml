/* =========================================================
   EVENT ANALYTICS
========================================================= */

function leadsForEvent(
  eventId
) {

  return database.leads.filter(
    lead =>
      lead.eventId ===
      eventId
  );

}


function eventClicks(
  eventId
) {

  return leadsForEvent(
    eventId
  ).length;

}


function eventConversions(
  eventId
) {

  return leadsForEvent(
    eventId
  )
  .filter(
    lead =>
      lead.status ===
      "Converted"
  )
  .length;

}


function eventRevenue(
  eventId
) {

  return leadsForEvent(
    eventId
  )
  .filter(
    lead =>
      lead.status ===
      "Converted"
  )
  .reduce(
    (
      total,
      lead
    ) =>
      total +
      Number(
        lead.revenue ||
        0
      ),
    0
  );

}


function minEventPrice(
  event
) {

  const prices =
    [];


  (
    event.defaultPasses ||
    []
  )
  .forEach(
    pass => {

      if (
        pass.price !==
        null
      ) {

        prices.push(
          Number(
            pass.price
          )
        );

      }

    }
  );


  Object.values(
    event.passesByDate ||
    {}
  )
  .flat()
  .forEach(
    pass => {

      if (
        pass.price !==
        null
      ) {

        prices.push(
          Number(
            pass.price
          )
        );

      }

    }
  );


  return prices.length
  ?
  Math.min(
    ...prices
  )
  :
  null;

}


function customNightCount(
  event
) {

  return Object.keys(
    event.passesByDate ||
    {}
  ).length;

}


