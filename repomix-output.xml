  }

  .mandala {
    animation: none;
  }
}


/* =========================================================
   SCENEZY UX PATCH
   1. Deck moves slightly upward
   2. Navigation arrows become clearly visible
   3. Search / My Passes get isolated Navratri background
   4. Remove redundant home price/date line if still present
========================================================= */


/* =========================================================
   HOME — REMOVE REDUNDANT PRICE / DATE ABOVE CARD
========================================================= */

.homeMeta {
    display: none !important;
}


/* =========================================================
   DECK POSITION
   Move ticket slightly upward so controls get breathing room
========================================================= */

.eventCard {
    top: 44.5% !important;
}


/* =========================================================
   DECK CONTROLS

   IMPORTANT:
   Cards previously had z-index ~80 while controls were ~55,
   so arrows could literally sit BEHIND the ticket.

   Controls now always live above the deck.
========================================================= */

.deckControls {
    z-index: 130 !important;

    bottom: 2px !important;

    pointer-events: none;
}


/* arrows themselves stay clickable */

.deckArrow {
    pointer-events: auto;

    width: 46px !important;
    height: 46px !important;

    color: #ffffff !important;

    background:
        linear-gradient(
            145deg,
            rgba(38, 59, 151, .96),
            rgba(22, 30, 67, .96)
        ) !important;

    border:
        1px solid
        rgba(124, 148, 255, .65) !important;

    box-shadow:
        0 8px 25px
        rgba(0, 0, 0, .42),

        0 0 0 3px
        rgba(49, 87, 237, .08),

        0 0 22px
        rgba(49, 87, 237, .27) !important;

    backdrop-filter:
        blur(16px);

    -webkit-backdrop-filter:
        blur(16px);

    transition:
        transform .18s ease,
        box-shadow .22s ease,
        border-color .22s ease !important;
}


.deckArrow .ic {
    width: 20px;
    height: 20px;

    stroke-width: 2.15;
}


.deckArrow:active {
    transform:
        scale(.89) !important;
}


/* subtle attention animation on first impression */

.deckArrow:first-child {
    animation:
        scenezyArrowLeft
        2.4s
        ease-in-out
        infinite;
}


.deckArrow:last-child {
    animation:
        scenezyArrowRight
        2.4s
        ease-in-out
        infinite;
}





/*
   Keep pagination dots visible between arrows.
*/

.deckDots {
    pointer-events: auto;

    padding:
        7px
        9px;

    border-radius: 999px;

    background:
        rgba(13, 13, 18, .66);

    border:
        1px solid
        rgba(255, 255, 255, .07);

    backdrop-filter:
        blur(12px);

    -webkit-backdrop-filter:
        blur(12px);
}


.deckDots button {
    background:
        rgba(255, 255, 255, .38) !important;
}


.deckDots button.on {
    background:
        #4a6cff !important;

    box-shadow:
        0 0 10px
        rgba(74, 108, 255, .48);
}


/* =========================================================
   SWIPE HINT
   Bring hint slightly higher so it doesn't fight arrows
========================================================= */

.swipeHint {
    bottom: 62px !important;

    z-index: 125 !important;

    padding:
        7px
        11px;

    border-radius: 999px;

    background:
        rgba(9, 9, 13, .48);

    backdrop-filter:
        blur(10px);

    -webkit-backdrop-filter:
        blur(10px);
}


/* =========================================================
   SEARCH + MY PASSES

   DO NOT show home cards through these screens.

   This recreates the SAME Scenezy atmosphere:
   garba image + blue glow + deep fade.
========================================================= */

#searchScreen,
#passesScreen {

    background:

        radial-gradient(
            circle at 50% 16%,
            rgba(52, 84, 225, .15),
            transparent 32%
        ),

        linear-gradient(
            180deg,
            rgba(8, 8, 12, .78) 0%,
            rgba(9, 9, 13, .89) 40%,
            rgba(8, 8, 11, .98) 100%
        ),

        url("./garba_golden_bg.jpg")
        center center /
        cover
        no-repeat !important;

    isolation:
        isolate;

    opacity: 1;
}


/*
   Extra atmospheric veil.
   Because this belongs INSIDE the overlay,
   the home ticket can no longer bleed through.
*/

#searchScreen::before,
#passesScreen::before {

    content: "";

    position: absolute;
    inset: 0;

    z-index: -1;

    pointer-events: none;

    background:

        linear-gradient(
            180deg,
            rgba(8, 8, 11, .10),
            rgba(8, 8, 11, .55)
        ),

        radial-gradient(
            circle at 50% 27%,
            rgba(49, 87, 237, .10),
            transparent 36%
        );
}


/* =========================================================
   SCREEN HEADER
   Make it feel like it belongs to the same app
========================================================= */

#searchScreen .screenHeader,
#passesScreen .screenHeader {

    position: relative;

    z-index: 5;

    background:
        linear-gradient(
            180deg,
            rgba(8, 8, 12, .72),
            rgba(8, 8, 12, 0)
        );
}


/* =========================================================
   SEARCH CONTENT
========================================================= */

#searchScreen .searchContent {

    position: relative;

    z-index: 3;
}


/*
   Search results get slightly more separation from artwork.
*/

#searchScreen .result {

    padding:
        12px
        11px;

    margin-bottom:
        7px;

    border:
        1px solid
        rgba(255, 255, 255, .07);

    border-radius:
        17px;

    background:
        rgba(20, 20, 27, .72);

    backdrop-filter:
        blur(13px);

    -webkit-backdrop-filter:
        blur(13px);
}


/* remove old separator because card has border */

#searchScreen .result {
    border-bottom:
        1px solid
        rgba(255, 255, 255, .07);
}


/* =========================================================
   MY PASSES
========================================================= */

#passesScreen .passWallet,
#passesScreen .passEmpty {

    position: relative;

    z-index: 3;
}


/*
   Darken area directly behind physical tickets slightly.
   Ticket still feels like a physical object floating
   over the Navratri world.
*/

#passesScreen .passTrack {

    background:

        radial-gradient(
            ellipse at center,
            rgba(0, 0, 0, .07),
            transparent 65%
        );
}


/* =========================================================
   SMALL MOBILE SCREENS
========================================================= */

@media (max-height: 760px) {

    .eventCard {
        top: 43.5% !important;
    }

    .deckArrow {
        width: 43px !important;
        height: 43px !important;
    }

    .swipeHint {
        bottom: 57px !important;
    }
}


/* =========================================================
   ACCESSIBILITY
   Don't keep arrow movement running when user disables motion
========================================================= */

@media (prefers-reduced-motion: reduce) {

    .deckArrow:first-child,
    .deckArrow:last-child {
        animation: none !important;
    }

}
</style>


