    );

}


/*
   Main share button:

   1. Try native mobile share sheet.
   2. If browser/iframe blocks it,
      show our custom fallback.
*/

async function handleShare() {

  const data =
    getShareData();


  if (
    navigator.share &&
    window.isSecureContext
  ) {

    try {

      const shareData = {

        title:
          data.title,

        text:
          data.text

      };


      if (
        data.url
      ) {

        shareData.url =
          data.url;

      }


      await navigator.share(
        shareData
      );


      return;

    } catch (
