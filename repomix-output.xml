      "Navratri 2026";

  }


  if (
    eventDraft.startDate &&
    eventDraft.endDate &&
    eventDraft.endDate <
    eventDraft.startDate
  ) {

    toast(
      "End date cannot be before start date"
    );


    return;

  }


  /*
     Keep only overrides which are still
     inside the active date range.
  */

  const validDates =
    new Set(
      datesForEvent(
        eventDraft
      )
      .map(
        item =>
          item.iso
      )
    );


  if (
    validDates.size
  ) {

    Object.keys(
      eventDraft.passesByDate
    )
    .forEach(
      date => {

        if (
          !validDates.has(
            date
          )
        ) {

          delete eventDraft.passesByDate[
            date
          ];

        }

      }
    );

  }


  eventDraft.updatedAt =
    Date.now();


  if (
    editingEventId
  ) {

    const index =
      database.events.findIndex(
        event =>
          event.id ===
          editingEventId
      );


    if (
      index ===
      -1
    ) {

      return;

    }


    const idChanged =
      eventDraft.id !==
      editingEventId;


    if (
      idChanged &&
      database.events.some(
        event =>
          event.id ===
          eventDraft.id
      )
    ) {

      toast(
        "That Event ID already exists"
      );


      return;

    }


    /*
       Preserve event analytics if ID changes.
    */

    if (
      idChanged
    ) {

      deleteEventFromSupabase(
        editingEventId
      );


      database.leads.forEach(
        lead => {

          if (
            lead.eventId ===
            editingEventId
          ) {

            lead.eventId =
              eventDraft.id;


            lead.eventName =
              eventDraft.name;

          }

        }
      );

    }


    database.events[
      index
    ] =
      normalizeEvent(
        eventDraft
      );


    addActivity(
      `Updated ${eventDraft.name}`
    );

  } else {

    if (
      database.events.some(
        event =>
          event.id ===
          eventDraft.id
      )
    ) {

      eventDraft.id =
        uniqueEventId(
          eventDraft.id
        );

    }


    eventDraft.createdAt =
      Date.now();


    database.events.unshift(
      normalizeEvent(
        eventDraft
      )
    );


    addActivity(
      `Created ${eventDraft.name}`
    );

  }


  saveDatabase();

  closeEventEditor();


  toast(
    wasEditing
    ?
    "Event updated"
    :
    "Event created"
  );

}


function uniqueEventId(
  base
) {

  let id =
    slugify(
      base
    ) ||
    "event";


  let counter =
    2;


  while (
    database.events.some(
      event =>
        event.id ===
        id
    )
  ) {

    id =
      `${slugify(base)}-${counter}`;


    counter++;

  }


  return id;

}


