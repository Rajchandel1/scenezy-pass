function getShareData() {

  const event =
    state.current;


  const night =
    currentNight();


  const pass =
    currentPass();


  let text =
`${event.name}
${event.dateLabel}
${event.venue}, ${event.area}
${event.address}`;


  if (
    night
  ) {

    text +=
`
