<file path="scenezy-ui.css">
[hidden]{display:none!important}
.mark, #gate .mark, .tBrand .mark{background:transparent;border-radius:0;object-fit:contain;flex-shrink:0}
button:disabled{cursor:wait;opacity:.65}
select.pill{font-family:inherit;cursor:pointer;max-width:125px;padding-right:8px}
select.pill option{background:#1a1a21;color:#f1ead9}
select.pill:disabled{opacity:.5;cursor:wait}
#eventHeading{flex-shrink:0}
.evActions{display:flex;flex-direction:column;gap:6px;flex-shrink:0}
button[aria-busy="true"]{display:inline-flex;align-items:center;justify-content:center;gap:10px}
.loading-orbit{display:inline-block;width:18px;height:18px;border:1px solid currentColor;border-right-color:transparent;border-radius:50%;animation:orbit 1.2s linear infinite;flex-shrink:0}
.scene-state{position:absolute;inset:0;z-index:120;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:28px;text-align:center;background:radial-gradient(ellipse at 50% 40%,#252334 0%,#121217 65%);color:var(--ink)}
.scene-state h3{font:italic 500 27px var(--serif)}
.scene-state p{font-size:13px;line-height:1.7;color:var(--dim);max-width:280px}
.scene-state button{padding:12px 24px;border:1px solid var(--line2);border-radius:999px}
.scene-emblem{width:100px;height:100px;position:relative;display:grid;place-items:center}
.scene-emblem img{width:58px;height:70px;object-fit:contain;animation:breathe 2.4s ease-in-out infinite}
.scene-emblem:before,.scene-emblem:after{content:'';position:absolute;inset:0;border:1px dashed #dfb54d66;border-radius:50%;animation:orbit 14s linear infinite}
.scene-emblem:after{inset:-12px;border-style:solid;border-color:transparent #dfb54d44;animation-direction:reverse}
@keyframes orbit{to{transform:rotate(360deg)}}
@keyframes breathe{50%{opacity:.55;transform:translateY(-4px)}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;scroll-behavior:auto!important;transition:none!important}}
/* ══════════════════════════════════════════════════════════════
   RESPONSIVE PATCH · scenezy-ui.css ke SABSE END me paste karo
   (sirf overrides — existing kuch nahi tootta)
   ══════════════════════════════════════════════════════════════ */

/* ── 0 · base hardening ── */
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
button{touch-action:manipulation}                 /* double-tap zoom off */
.list,.dBody,.tBody,.pTrack{overscroll-behavior:contain;-webkit-overflow-scrolling:touch}

/* 100dvh fallback (purane iOS Safari) */
#app{height:100vh}
@supports (height:100dvh){#app{height:100dvh}}

/* safe-area — notch / home-indicator ke peeche na chipke */
.home{padding-bottom:calc(86px + env(safe-area-inset-bottom))}
.tabbar{bottom:calc(14px + env(safe-area-inset-bottom))}
.toast{bottom:calc(88px + env(safe-area-inset-bottom))}
.pDots{padding:10px 0 calc(98px + env(safe-area-inset-bottom))}
.dCta{padding-left:max(18px,env(safe-area-inset-left));padding-right:max(18px,env(safe-area-inset-right))}
.tBody{padding-left:max(18px,env(safe-area-inset-left));padding-right:max(18px,env(safe-area-inset-right))}

/* iOS: input font <16px pe focus me page zoom karta hai — guard */
@media (pointer:coarse){
  .sInput input{font-size:16px}
  .step{width:42px;height:42px}
  .qty{width:38px}
}

/* hover effects sirf mouse walo ke liye — touch pe sticky-hover nahi */
@media (hover:hover){
  .iconBtn:hover,.ctlBtn:hover{border-color:rgba(241,234,217,.4)}
  .tab:hover{color:var(--ink)}
  .row:hover{background:rgba(241,234,217,.03)}
}

/* logo ab <img> hai — fit theek, radius inherit */
img.mark{object-fit:contain;border-radius:inherit}
/* agar tumhara logo apne colours wala hai to blue background hata do: */
/* img.mark{background:transparent} */

/* fluid type — heading chhoti screen pe khud squeeze */
.dTitle{font-size:clamp(26px,8.5vw,34px)}
.tTop h3{font-size:clamp(23px,7vw,30px)}
.tHero h2{font-size:clamp(27px,8vw,36px)}
.ptName{font-size:clamp(19px,6vw,22px)}
.rateTitle{font-size:clamp(22px,7vw,26px)}

/* ── 1 · chhote phones (320–360px: iPhone SE, Android compact) ── */
@media (max-width:360px){
  .top{padding:14px 14px 4px;gap:9px}
  .iconBtn{width:36px;height:36px}
  .wordmark{font-size:19px}
  .evSub{gap:7px;font-size:11px}
  .stage{margin-top:8px}
  .cardHead{padding:9px 8px 8px}
  .cardHead h3{font-size:18px}
  .cardHead p{font-size:9px}
  .deckCtl{gap:10px}
  .ctlBtn{width:38px;height:38px}
  .pticket{flex-basis:88%}
  .ptArt{height:128px}
  .tArt{height:112px}
  .tGrid b{font-size:12px}
  .banner{height:184px}
}

/* ── 2 · chhoti HEIGHT (chhota phone ya landscape) ── */
@media (max-height:700px){
  .kicker{margin-top:6px}
  .evName,.evMeta,.evSub{margin-top:4px}
  .stage{min-height:240px;margin-top:8px}
  .hint{bottom:58px}
}
@media (max-height:620px){
  .evSub{display:none}                /* teesri line hatao — card ko jagah do */
  .stage{min-height:210px}
  .cardHead{padding:8px 8px 7px}
  .cardHead h3{font-size:16.5px}
  .banner{height:158px}
}

/* landscape phone — sabse tight case */
@media (max-height:480px) and (orientation:landscape){
  .kicker,.evSub{display:none}
  .evName{font-size:22px;margin-top:2px}
  .evMeta{margin-top:2px;font-size:11px}
  .stage{min-height:180px;margin-top:4px}
  .home{padding-bottom:calc(70px + env(safe-area-inset-bottom))}
}

/* ── 3 · tablet / desktop — centered phone frame hi identity hai ── */
@media (min-width:768px){
  #app{max-width:448px}
  body::after{opacity:.04}
}

/* ════════════════════════════════════════════════
   BG IMAGE PATCH · scenezy-bg.jpg (local file)
   ════════════════════════════════════════════════ */

/* 1) body layer — full-screen image (iOS-safe: fixed pseudo-element,
      background-attachment:fixed jaan-bujh ke use nahi kiya) */
body::before{
  content:"";position:fixed;inset:-24px;z-index:-1;
  background:url('./garba_golden_bg.jpg') center/cover no-repeat;
  transform:translateZ(0);
  filter:saturate(.85) brightness(.82);   /* image ko thoda dark/mute — text readable rahe */
}

/* 2) app glass — home screen ke through image halki jhalke */
#app{background:rgba(18,18,23,.66)}

/* 3) home pe flat scrim — header/title text ke padhne ke liye
      (flat overlay hai, decorative gradient nahi) */
.home::before{
  content:"";position:absolute;inset:0;z-index:-1;
  background:rgba(8,8,11,.45);pointer-events:none;
}

/* 4) desktop pe frame ko thoda aur mohalla do */
@media (min-width:480px){
  #app{box-shadow:0 40px 90px rgba(0,0,0,.55)}
}

/* ════════ long-name + controls fixes ════════ */
/* arrows/hint card ke upar — double safety */
.deckCtl{z-index:120}
.hint{z-index:120}

/* header: max 2 line, lamba naam = chhota font, meta 1 line ellipsis */
.evName{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.evName.xl{font-size:clamp(20px,6.4vw,27px)}
.evMeta{max-width:92%;margin-left:auto;margin-right:auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* ticket card: naam max 2 line, length ke hisaab se font */
.cardHead h3{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.cardHead.lg h3{font-size:17px}
.cardHead.xl h3{font-size:15px;line-height:1.18}
.cardHead p{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}

/* detail title + receipt + my-passes: max 2 line, overflow nahi */
.dTitle{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.dTitle.xl{font-size:clamp(24px,7vw,28px)}
.tTop h3{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ptName{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
