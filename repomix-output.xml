/* =========================================================
   BARCODE
========================================================= */

function barcode(
  reference,
  height = 14
) {

  let x = 3;

  let result = "";


  const source =
    (
      reference +
      [...reference]
        .reverse()
        .join("")
    )
    .toUpperCase();


  for (
    const character
    of source
  ) {

    const code =
      character.charCodeAt(0);


    const width =
      1 +
      (
        code %
        3
      );


    const gap =
      1 +
      (
        code %
        2
      );


    result += `

      <rect
        x="${x}"
        y="0"
        width="${width}"
        height="${height}"
      ></rect>

    `;


    x +=
      width +
      gap;


    if (
      x >
      215
    ) {

      break;

    }

  }


  return result;

}


/* =========================================================
   SAVED EVENTS
========================================================= */

function loadSaved() {

  try {

    state.saved =
      new Set(

        JSON.parse(
          localStorage.getItem(
            STORAGE.saved
          )
        ) ||
        []

      );

  } catch {

    state.saved =
      new Set();

  }


  updatePassBadge();

}


function persistSaved() {

  try {

    localStorage.setItem(

      STORAGE.saved,

      JSON.stringify(
        [...state.saved]
      )

    );

  } catch {}

}


function isSaved(
  eventId
) {

  return state.saved.has(
    eventId
  );

}


function toggleSaved(
  event
) {

  const willBeSaved =
    !isSaved(
      event.id
    );


  if (
    willBeSaved
  ) {

    state.saved.add(
      event.id
    );


    toast(
      "Saved · now in My Passes"
    );


    haptic(12);

  } else {

    state.saved.delete(
      event.id
    );


    toast(
      "Removed from My Passes"
    );

  }


  /*
     Instant local write first.
     Cloud backup happens silently afterwards.
  */

  persistSaved();

  syncSaveUI();

  updatePassBadge();


  syncSavedEventRemote(
    event.id,
    willBeSaved
  );


  if (
    $("#passesScreen")
      .classList
      .contains(
        "open"
      )
  ) {

    renderMyPasses();

  }

}


function updatePassBadge() {

  const badge =
    $("#passBadge");


  badge.textContent =
    state.saved.size;


  badge.classList.toggle(
    "show",
    state.saved.size > 0
  );

}


function syncSaveUI() {

  cardElements.forEach(
    (
      card,
      index
    ) => {

      card
        .querySelector(
          ".cardSave"
        )
        ?.classList
        .toggle(

          "on",

          isSaved(
            EVENTS[index].id
          )

        );

    }
  );


  if (
    state.current
  ) {

    const saved =
      isSaved(
        state.current.id
      );


    $("#detailSave")
      .classList
      .toggle(
        "on",
        saved
      );


    const label =
      $("#detailSaveLabel");


    if (
      label
    ) {

      label.textContent =
        saved
        ?
        "Saved"
        :
        "Save";

