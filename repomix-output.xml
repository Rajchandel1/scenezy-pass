/* =========================================================
   NIGHTS
========================================================= */

function renderNights() {

  const event =
    state.current;


  const nights =
    buildNights(
      event
    );


  if (
    !nights.length
  ) {

    $("#nightArea")
      .innerHTML =
      `

        <div class="tbaBox">
          Night-wise dates are yet to be announced.
        </div>

      `;


    return;

  }


  state.selectedNight[
    event.id
  ] =
    Math.min(
      state.selectedNight[
        event.id
      ] || 0,
      nights.length - 1
    );


  $("#nightArea")
    .innerHTML =
    `

      <div
        class="nightScroller"
        id="nightScroller"
      >

        ${
          nights
            .map(
              (
                night,
                index
              ) => `

                <button
                  class="
                    nightChip
                    ${
                      state.selectedNight[
                        event.id
                      ] ===
                      index
                      ?
                      "on"
                      :
                      ""
                    }
                  "

                  data-night="${index}"
                >

                  <small>
                    Night ${index + 1}
                  </small>


                  <strong>

                    ${
                      escapeHTML(
                        night.day
                      )
                    }

                  </strong>


                  <span>

                    ${
                      escapeHTML(
                        night.date
                      )
                    }

                  </span>

                </button>

              `
            )
            .join("")
        }

      </div>


      <div
        class="selectedNight"
        id="selectedNight"
      ></div>

    `;


  $("#nightScroller")
    .onclick =
    clickEvent => {

      const button =
        clickEvent.target.closest(
          "[data-night]"
        );


      if (
        !button
      ) return;


      state.selectedNight[
        event.id
      ] =
        Number(
          button.dataset.night
        );


      state.selectedPass[
        event.id
      ] =
        0;


      $$("#nightScroller .nightChip")
        .forEach(
          chip => {

            chip.classList.toggle(
              "on",
              chip === button
            );

          }
        );


      const scroller =
        $("#nightScroller");

      if (scroller) {
        const targetLeft =
          button.offsetLeft -
          (
            scroller.clientWidth -
            button.offsetWidth
          ) / 2;

        scroller.scrollTo({
          left:
            Math.max(
              0,
              targetLeft
            ),
          behavior:
            "smooth"
        });
      }


      renderSelectedNight();

      renderPassTypes();

      syncSummary();

      haptic(5);

    };


  renderSelectedNight();

}


function renderSelectedNight() {

  const event =
    state.current;


  const nights =
    buildNights(
      event
    );


  if (
    !nights.length
  ) return;


  const night =
    nights[
      state.selectedNight[
        event.id
      ]
    ];


  const passes =
    passesForNight(
      event,
      night
    );


  const prices =
    passes
      .map(
        pass =>
          pass.price
      )
      .filter(
        price =>
          price !== null &&
          price !== undefined
      );


  const price =
    prices.length
    ?
    Math.min(...prices)
    :
    null;


  $("#selectedNight")
    .innerHTML =
    `

      <div class="selectedNightIcon">

        ${calendarIcon()}

      </div>


      <div class="selectedNightCopy">

        <small>
          Selected night
        </small>


        <strong>

          ${
            escapeHTML(
              night.day
            )
          }

          ·

          ${
            escapeHTML(
              night.date
            )
          }

          2026

        </strong>

      </div>


      <div class="selectedNightPrice">

        ${
          priceText(
            price
          )
        }

      </div>

    `;

}


/* =========================================================
   CURRENT PASS
========================================================= */

function currentNight() {

  if (
    !state.current
  ) return null;


  const nights =
    buildNights(
      state.current
    );


  if (
    !nights.length
  ) return null;


  return nights[
    state.selectedNight[
      state.current.id
    ] || 0
  ];

}


function currentPasses() {

  if (
    !state.current
  ) return [];


  return passesForNight(
    state.current,
    currentNight()
  );

}


function currentPass() {

  if (
    !state.current
  ) return null;


  const passes =
    currentPasses();


  if (
    !passes.length
  ) return null;


  const index =
    Math.min(
      state.selectedPass[
        state.current.id
      ] || 0,
      passes.length - 1
    );


  state.selectedPass[
    state.current.id
  ] =
    index;


  return passes[
    index
  ];

}


/* =========================================================
   PASS TYPES
========================================================= */

function renderPassTypes() {

  const event =
    state.current;


  const passes =
    currentPasses();


  if (
    !passes.length
  ) {

    $("#passList")
      .innerHTML =
      `

        <div class="tbaBox">
          Pass types will be announced soon.
        </div>

      `;


    return;

  }


  const selected =
    Math.min(
      state.selectedPass[
        event.id
      ] || 0,
      passes.length - 1
    );


  state.selectedPass[
    event.id
  ] =
    selected;


  $("#passList")
    .innerHTML =
    passes
      .map(
        (
          pass,
          index
        ) => `

          <button
            class="
              passOption
              ${
                selected ===
                index
                ?
                "on"
                :
                ""
              }
            "

            data-pass="${index}"
          >

            <span class="passRadio"></span>


            <span class="passMain">

              <b>

                ${
                  escapeHTML(
                    pass.name
                  )
                }

              </b>


              <small>

                ${
                  escapeHTML(
                    pass.note ||
                    "Event entry"
                  )
                }

              </small>

            </span>


            <span class="passPrice">

              ${
                priceText(
                  pass.price
                )
              }

            </span>

          </button>

        `
      )
      .join("");


  $("#passList")
    .onclick =
    clickEvent => {

      const button =
        clickEvent.target.closest(
          "[data-pass]"
        );


      if (
        !button
      ) return;


      state.selectedPass[
        event.id
      ] =
