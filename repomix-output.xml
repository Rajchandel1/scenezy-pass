  $("#ticketNight")
    .textContent =
    ticket.night;


  $("#ticketPass")
    .textContent =
    ticket.pass;


  $("#ticketQty")
    .textContent =
    ticket.qty;


  $("#ticketRef")
    .textContent =
    ticket.ref;


  $("#ticketTotal")
    .textContent =
    priceText(
      ticket.total
    );


  $("#ticketBarcode")
    .innerHTML =
    barcode(
      ticket.ref,
      34
    );


  $("#ticketScreen")
    .classList
    .add(
      "open"
    );


  $("#ticketBody")
    .scrollTop =
    0;


  const paper =
    $("#ticketPaper");


  const printer =
    $("#printer");


  paper.classList.remove(
    "printing"
  );


  printer.classList.remove(
    "printing"
  );


  void paper.offsetWidth;


  if (
    animate
  ) {

    paper.classList.add(
      "printing"
    );


    printer.classList.add(
      "printing"
    );


    setTimeout(
      () => {

        printer.classList.remove(
          "printing"
        );


        confettiBurst();

      },
      1900
    );

  }

}


function closeReceipt() {

  $("#ticketScreen")
    .classList
    .remove(
      "open"
    );

}


$("#ticketClose")
  .onclick =
  closeReceipt;


$("#ticketDone")
  .onclick =
  closeReceipt;


$("#ticketWhatsApp")
  .onclick =
  () => {

    if (
      state.lastTicket
    ) {

      window.open(
        state.lastTicket.whatsappURL,
        "_blank"
      );

    }

  };


/* =========================================================
   CONFETTI
========================================================= */

const confettiCanvas =
  $("#confetti");


const ctx =
  confettiCanvas.getContext(
    "2d"
  );


let particles = [];

let confettiFrame;


function confettiBurst() {

  confettiCanvas.width =
    innerWidth;


  confettiCanvas.height =
    innerHeight;


  const colours = [

    "#3157ed",

    "#f4eddf",

    "#ddb454",

    "#93a7ff",

    "#ffffff"

  ];


  function spawn(
    x,
    y,
    direction
  ) {

    for (
      let i = 0;
      i < 90;
      i++
    ) {

      const angle =
        direction +
        (
          Math.random() -
          .5
        ) *
        .95;


      const speed =
        8 +
        Math.random() *
        8;


      particles.push({

        x,

        y,

        vx:
          Math.cos(angle) *
          speed,

        vy:
          Math.sin(angle) *
          speed,

        gravity:
          .22 +
          Math.random() *
          .09,

        size:
          4 +
          Math.random() *
          5,

        rotation:
          Math.random() *
          Math.PI,

        rotationVelocity:
          (
            Math.random() -
            .5
          ) *
          .3,

        colour:
          colours[
            Math.floor(
              Math.random() *
              colours.length
            )
          ],

        life:
          1

      });

    }

  }


  spawn(
    0,
    confettiCanvas.height *
    .74,
    -Math.PI / 3
  );


  spawn(
    confettiCanvas.width,
    confettiCanvas.height *
    .74,
    -Math.PI +
    Math.PI / 3
  );


  cancelAnimationFrame(
    confettiFrame
  );


  function animate() {

    ctx.clearRect(
      0,
      0,
      confettiCanvas.width,
      confettiCanvas.height
    );


    particles =
      particles.filter(
        particle =>
          particle.life > 0
      );


    particles.forEach(
      particle => {

        particle.vy +=
          particle.gravity;


        particle.vx *=
          .988;


        particle.x +=
          particle.vx;


        particle.y +=
          particle.vy;


        particle.rotation +=
          particle.rotationVelocity;


        particle.life -=
          .009;


        ctx.save();


        ctx.globalAlpha =
          Math.max(
            0,
            particle.life
          );


        ctx.translate(
          particle.x,
          particle.y
        );


        ctx.rotate(
          particle.rotation
        );


        ctx.fillStyle =
          particle.colour;


        ctx.fillRect(

          -particle.size / 2,

          -particle.size / 2,

          particle.size,

          particle.size * .62

        );


        ctx.restore();

      }
    );


    if (
      particles.length
    ) {

      confettiFrame =
        requestAnimationFrame(
          animate
        );

    } else {

      ctx.clearRect(
        0,
        0,
        confettiCanvas.width,
        confettiCanvas.height
      );

    }

  }


  animate();

}


/* =========================================================
   KEYBOARD
========================================================= */

window.addEventListener(
  "keydown",
  keyboardEvent => {

    if (
      keyboardEvent.key ===
      "Escape"
    ) {

      if (
        $("#shareOverlay")
          .classList
          .contains(
            "open"
          )
      ) {

        closeShareFallback();

        return;

      }


      if (
        $("#ratingOverlay")
          .classList
          .contains(
            "open"
          )
      ) {

        $("#ratingOverlay")
          .classList
          .remove(
            "open"
          );

        return;

      }


      if (
        $("#detail")
          .classList
          .contains(
            "open"
          )
      ) {

        $("#detail")
          .classList
          .remove(
            "open"
          );

        return;

      }


      closeScreens();

    }


    if (
      $("#detail")
        .classList
        .contains(
          "open"
        ) ||
      $(".screen.open")
    ) {

      return;

    }


    if (
      keyboardEvent.key ===
      "ArrowRight"
    ) {

      moveDeck(1);

    }


    if (
      keyboardEvent.key ===
      "ArrowLeft"
    ) {

      moveDeck(-1);

    }

  }
);


/* =========================================================
   RESIZE
========================================================= */

let resizeTimer;


window.addEventListener(
  "resize",
  () => {

    clearTimeout(
      resizeTimer
    );


    resizeTimer =
      setTimeout(
        () => {

          resizeDeck();

          renderDeck(
            state.position
          );

        },
        50
      );

  }
);


/* =========================================================
   BOOT
========================================================= */

function boot() {

  /*
     Lightning-fast first paint:
     cached/fallback data renders immediately.
  */

  loadEventsFromLocalStorage();


  $("#homeKicker")
    .textContent =
    `${SCENEZY.season} · ${SCENEZY.city} Garba Events`;


  loadSaved();


  if (
    TOTAL >
    0
  ) {

    buildDeck();

  } else {

    showNoLiveEvents();

  }


  buildRatingWheel();

  renderSearch();

  updatePassBadge();


  syncScenezyRoute();


  /*
     Network work starts after the UI is interactive.
  */

  setTimeout(
    () => {

      if (
        sb
      ) {

        fetchScenezyFromSupabase({
          rebuild: true,
          notify: false
        });


        startScenezyRealtime();

        flushLeadOutbox();

        reconcileSavedEvents();

      }

    },
    0
  );

}


/*
   Legacy local testing support:
   if an older Admin tab still writes scenezy.shared.v1,
   refresh from that cache without breaking production mode.
*/

window.addEventListener(
  "storage",
  event => {

    if (
      event.key !==
      SCENEZY_LEGACY_SHARED_KEY
    ) {
      return;
    }


    if (
      sb
    ) {
      return;
    }


    const legacy =
      readScenezyCache();


    if (
      legacy
    ) {

      applyScenezyPublicData(
        legacy
      );


      refreshScenezyUI(
        true
      );

    }

  }
);

window.addEventListener(
  "popstate",
  () => {
    closeScreens();
    syncScenezyRoute();
  }
);


boot();
</script>

