            const date =
              button.dataset.removeDatePass;


            const index =
              Number(
                button.dataset.removeDateIndex
              );


            eventDraft.passesByDate[
              date
            ].splice(
              index,
              1
            );


            renderDatePricing();

          };

      }
    );


  $$("[data-add-date-pass]")
    .forEach(
      button => {

        button.onclick =
          () => {

            const date =
              button.dataset.addDatePass;


            eventDraft.passesByDate[
              date
            ].push({

              id:
                `pass-${eventDraft.passesByDate[date].length + 1}`,

              name:
                "",

              note:
                "",

              price:
                null

            });


            renderDatePricing();

          };

      }
    );


  $$("[data-copy-defaults]")
    .forEach(
      button => {

        button.onclick =
          () => {

            const date =
              button.dataset.copyDefaults;


            eventDraft.passesByDate[
              date
            ] =
              structuredCloneSafe(
                eventDraft.defaultPasses
              );


            renderDatePricing();


            toast(
              "Default passes copied"
            );

          };

      }
    );


  $$("[data-copy-forward]")
    .forEach(
      button => {

        button.onclick =
          () => {

            const sourceDate =
              button.dataset.copyForward;


            const sourcePasses =
              eventDraft.passesByDate[
                sourceDate
              ];


            const dates =
              datesForEvent(
                eventDraft
              );


            const sourceIndex =
              dates.findIndex(
                item =>
                  item.iso ===
                  sourceDate
              );


            dates
              .slice(
                sourceIndex +
                1
              )
              .forEach(
                date => {

                  eventDraft.passesByDate[
                    date.iso
                  ] =
                    structuredCloneSafe(
                      sourcePasses
                    );

                }
              );


            renderDatePricing();


            toast(
              "Pricing applied to remaining nights"
            );

          };

      }
    );

}


