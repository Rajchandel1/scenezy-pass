/* =========================================================
   DATE RANGE
========================================================= */

function datesForEvent(
  event
) {

  if (
    !event.startDate ||
    !event.endDate
  ) {

    return [];

  }


  const start =
    new Date(
      `${event.startDate}T12:00:00`
    );


  const end =
    new Date(
      `${event.endDate}T12:00:00`
    );


  if (
    Number.isNaN(
      start.getTime()
    ) ||
    Number.isNaN(
      end.getTime()
    ) ||
    end <
    start
  ) {

    return [];

  }


  const dates =
    [];


  const cursor =
    new Date(
      start
    );


  let safety =
    0;


  while (
    cursor <=
    end &&
    safety <
    90
  ) {

    dates.push({

      iso:
        cursor
          .toISOString()
          .slice(
            0,
            10
          ),

      day:
        cursor
          .toLocaleDateString(
            "en-US",
            {
              weekday:
                "short"
            }
          ),

      date:
        cursor
          .toLocaleDateString(
            "en-US",
            {
              day:
                "numeric",

              month:
                "short"
            }
          ),

      dayNumber:
        cursor
          .toLocaleDateString(
            "en-US",
            {
              day:
                "2-digit"
            }
          ),

      month:
        cursor
          .toLocaleDateString(
            "en-US",
            {
              month:
                "short"
            }
          )

    });


    cursor.setDate(
      cursor.getDate() +
      1
    );


    safety++;

  }


  return dates;

}


function autoDateLabel(
  start,
  end
) {

  if (
    !start ||
    !end
  ) {

    return "";

  }


  const startDate =
    new Date(
      `${start}T12:00:00`
    );


  const endDate =
    new Date(
      `${end}T12:00:00`
    );


  if (
    Number.isNaN(
      startDate.getTime()
    ) ||
    Number.isNaN(
      endDate.getTime()
    )
  ) {

    return "";

  }


  const startText =
    startDate
      .toLocaleDateString(
        "en-US",
        {
          day:
            "numeric",

          month:
            "short"
        }
      );


  const endText =
    endDate
      .toLocaleDateString(
        "en-US",
        {
          day:
            "numeric",

          month:
            "short"
        }
      );


  return `${startText} – ${endText}`;

}


