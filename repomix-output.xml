function renderDatePricing() {

  syncEditorFields();


  const container =
    $("#datePricingList");


  const dates =
    datesForEvent(
      eventDraft
    );


  if (
    !dates.length
  ) {

    container.innerHTML =
      `

        <div class="empty-state">

          <strong>
            Select start & end dates
          </strong>

          <span>
            Scenezy will then create each night here
            automatically.
          </span>

        </div>

      `;


    return;

  }


  container.innerHTML =
    dates.map(
      (
        date,
        index
      ) => {

        const custom =
          Array.isArray(
            eventDraft.passesByDate[
              date.iso
            ]
          );


        const passes =
          custom
          ?
          eventDraft.passesByDate[
            date.iso
          ]
          :
          eventDraft.defaultPasses;


        const priceText =
          pricingSummary(
            passes
          );


        return `

          <div
            class="date-price-card"
            data-date-card="${date.iso}"
          >

            <div class="date-price-head">

              <div class="date-badge">

                <strong>
                  ${date.dayNumber}
                </strong>

                <span>
                  ${date.month}
                </span>

              </div>


              <div class="date-price-copy">

                <b>
                  Night ${index + 1} · ${date.day}
                </b>

                <span>

                  ${
                    custom
                    ?
                    `Custom · ${priceText}`
                    :
                    `Using defaults · ${priceText}`
                  }

                </span>

              </div>


              <div class="date-price-actions">

                ${
                  custom
                  ?
                  `

                    <button
                      class="small-action"
                      data-use-default="${date.iso}"
                    >
                      Reset
                    </button>

                  `
                  :
                  `

                    <button
                      class="small-action blue"
                      data-customize-date="${date.iso}"
                    >
                      Customize
                    </button>

                  `
                }

              </div>

            </div>


            ${
              custom
              ?
              renderCustomDatePasses(
                date.iso,
                eventDraft.passesByDate[
                  date.iso
                ]
              )
              :
              ""
            }

          </div>

        `;

      }
    )
    .join("");


  bindDatePricingActions();

}


function pricingSummary(
  passes
) {

  const realPrices =
    (
      passes ||
      []
    )
    .map(
      pass =>
        pass.price
    )
    .filter(
      price =>
        price !==
        null &&
        price !==
        undefined
    );


  if (
    !realPrices.length
  ) {

    return "Price TBA";

  }


  return (
    "from " +
    money(
      Math.min(
        ...realPrices
      )
    )
  );

}


