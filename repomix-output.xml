/* =========================================================
   SUMMARY
========================================================= */

function currentTotal() {

  const pass =
    currentPass();


  if (
    !state.current ||
    !pass ||
    pass.price == null
  ) {

    return null;

  }


  return (
    pass.price *
    state.quantity[
      state.current.id
    ]
  );

}


