function loadSaved() {

  try {

    state.saved =
      new Set(

        JSON.parse(
          localStorage.getItem(
            STORAGE.saved
          )
        ) ||
        []

      );

  } catch {

    state.saved =
      new Set();

  }


  updatePassBadge();

}


function persistSaved() {

  try {

    localStorage.setItem(

      STORAGE.saved,

      JSON.stringify(
        [...state.saved]
      )

    );

  } catch {}

}


function isSaved(
  eventId
) {

  return state.saved.has(
    eventId
  );

}


function toggleSaved(
  event
) {

  const willBeSaved =
    !isSaved(
      event.id
    );


  if (
    willBeSaved
  ) {

    state.saved.add(
      event.id
    );


    toast(
      "Saved · now in My Passes"
    );


    haptic(12);

  } else {

    state.saved.delete(
      event.id
    );


    toast(
      "Removed from My Passes"
    );

  }


  /*
     Instant local write first.
     Cloud backup happens silently afterwards.
  */

  persistSaved();

  syncSaveUI();

  updatePassBadge();


  syncSavedEventRemote(
    event.id,
    willBeSaved
  );


  if (
    $("#passesScreen")
      .classList
      .contains(
        "open"
      )
  ) {

    renderMyPasses();

  }

}


