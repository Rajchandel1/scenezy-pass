/* =========================================================
   DATES
========================================================= */

function buildNights(
  event
) {

  if (
    !event.startDate ||
    !event.endDate
  ) {

    return [];

  }


  const start =
    new Date(
      event.startDate +
      "T12:00:00"
    );


  const end =
    new Date(
      event.endDate +
      "T12:00:00"
    );


  const result = [];


  const cursor =
    new Date(start);


  while (
    cursor <=
    end
  ) {

    result.push({

      iso:
        cursor
          .toISOString()
          .slice(0,10),

      day:
        cursor
          .toLocaleDateString(
            "en-US",
            {
              weekday: "short"
            }
          ),

      date:
        cursor
          .toLocaleDateString(
            "en-US",
            {
              day: "numeric",
              month: "short"
            }
          )

    });


    cursor.setDate(
      cursor.getDate() +
      1
    );

  }


  return result;

}


