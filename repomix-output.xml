/* =========================================================
   MOBILE NAV
========================================================= */

.mobile-nav {
  position: fixed;

  left: 50%;
  bottom:
    calc(10px + var(--safe-bottom));

  z-index: 400;

  width:
    min(
      calc(100% - 24px),
      430px
    );

  display: grid;

  grid-template-columns:
    repeat(4,1fr);

  gap: 3px;

  padding: 5px;

  border:
    1px solid
    var(--line-2);

  border-radius: 20px;

  background:
    rgba(24,25,32,.94);

  backdrop-filter:
    blur(20px);

  -webkit-backdrop-filter:
    blur(20px);

  box-shadow:
    0 15px 40px
    rgba(0,0,0,.44);

  transform:
    translateX(-50%);
}

.mobile-nav button {
  min-height: 50px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 3px;

  border-radius: 15px;

  color: var(--faint);

  font-size: 7px;
  font-weight: 600;
}

.mobile-nav button span:first-child {
  font-size: 17px;
}

.mobile-nav button.on {
  color: white;

  background:
    linear-gradient(
      145deg,
      #3d62f1,
      #2949ce
    );
}


/* =========================================================
   EVENT EDITOR SHEET
========================================================= */

.editor-overlay {
  position: fixed;
  inset: 0;

  z-index: 1000;

  visibility: hidden;

  pointer-events: none;
}

.editor-overlay.open {
  visibility: visible;

  pointer-events: auto;
}

.editor-veil {
  position: absolute;
  inset: 0;

  opacity: 0;

  background:
    rgba(3,4,7,.76);

  backdrop-filter:
    blur(5px);

  transition:
    opacity .28s ease;
}

.editor-overlay.open
.editor-veil {
  opacity: 1;
}

.editor-sheet {
  position: absolute;

  inset:
    12px
    0
    0;

  display: flex;
  flex-direction: column;

  overflow: hidden;

  border-radius:
    25px 25px 0 0;

  background:
    #0d0e14;

  border-top:
    1px solid
    var(--line-2);

  transform:
    translateY(102%);

  transition:
    transform
    .42s
    cubic-bezier(.2,.85,.24,1);
}

.editor-overlay.open
.editor-sheet {
  transform: none;
}

.editor-header {
  flex: none;

  display: flex;
  align-items: center;

  gap: 11px;

  padding:
    12px 14px;

  border-bottom:
    1px solid
    var(--line);

  background:
    rgba(13,14,20,.96);
}

.editor-close {
  width: 39px;
  height: 39px;

  flex: none;

  display: grid;
  place-items: center;

  border:
    1px solid
    var(--line);

  border-radius: 12px;

  color: var(--muted);

  background:
    var(--surface);
}

.editor-heading {
  flex: 1;
  min-width: 0;
}

.editor-heading small {
  display: block;

  color: var(--faint);

  font-size: 7px;
  font-weight: 700;

  letter-spacing: .15em;

  text-transform: uppercase;
}

.editor-heading h2 {
  margin-top: 2px;

  overflow: hidden;

  white-space: nowrap;
  text-overflow: ellipsis;

  font-size: 16px;
}

.editor-scroll {
  flex: 1;

  overflow-y: auto;

  padding:
    13px
    13px
    110px;

  scrollbar-width: none;
}

.editor-scroll::-webkit-scrollbar {
  display: none;
}

.form-section {
  margin-bottom: 11px;

  overflow: hidden;

  border:
    1px solid
    var(--line);

  border-radius: 18px;

  background:
    var(--surface);
}

.form-section-head {
  padding:
    13px 14px;

  border-bottom:
    1px solid
    var(--line);
}

.form-section-head h3 {
  font-size: 12px;
}

.form-section-head p {
  margin-top: 3px;

  color: var(--faint);

  font-size: 8px;
  line-height: 1.4;
}

.form-section-body {
  padding: 13px;
}

.form-grid {
  display: grid;

  gap: 11px;
}

.field label {
  display: block;

  margin-bottom: 6px;

  color: var(--muted);

  font-size: 8px;
  font-weight: 600;

  letter-spacing: .05em;
}

.field small {
  display: block;

  margin-top: 5px;

  color: var(--faint);

  font-size: 7.5px;
  line-height: 1.4;
}

.two-col {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 8px;
}

.switch-row {
  display: flex;
  align-items: center;

  gap: 12px;

  padding:
    11px;

  border:
    1px solid
    var(--line);

  border-radius: 13px;

  background:
    rgba(255,255,255,.02);
}

.switch-copy {
  flex: 1;
}

.switch-copy b {
  display: block;

  font-size: 10px;
}

.switch-copy span {
  display: block;

  margin-top: 2px;

  color: var(--faint);

  font-size: 7.5px;
}

.switch {
  position: relative;

  width: 43px;
  height: 25px;

  flex: none;

  border-radius: 999px;

  background: #292b35;

  transition:
    background .18s ease;
}

.switch::after {
  content: "";

  position: absolute;

  left: 3px;
  top: 3px;

  width: 19px;
  height: 19px;

  border-radius: 50%;

  background: white;

  transition:
    transform .18s ease;
}

.switch.on {
  background: var(--blue);
}

.switch.on::after {
  transform:
    translateX(18px);
}


/* =========================================================
   MEDIA PREVIEW
========================================================= */

.image-preview {
  position: relative;

  height: 160px;

  overflow: hidden;

  margin-top: 9px;

  border:
    1px solid
    var(--line);

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      var(--preview-a,#542038),
      var(--preview-b,#171326)
    );
}

.image-preview img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

.image-preview::after {
  content: "EVENT ART PREVIEW";

  position: absolute;

  left: 10px;
  bottom: 9px;

  padding:
    5px 7px;

  border-radius: 6px;

  color: white;

  background:
    rgba(0,0,0,.45);

  font-size: 6px;
  font-weight: 700;

  letter-spacing: .12em;
}


/* =========================================================
   PASS EDITOR
========================================================= */

.pass-editor-list {
  display: flex;
  flex-direction: column;

  gap: 7px;
}

.pass-editor-row {
  display: grid;

  grid-template-columns:
    minmax(0,1fr)
    86px
    34px;

  gap: 6px;

  align-items: center;
}

.pass-editor-row
.pass-note {
  grid-column:
    1 / 3;
}

.pass-editor-row input {
  min-height: 40px;

  border-radius: 10px;

  font-size: 9px;
}

.remove-pass {
  width: 34px;
  height: 40px;

  display: grid;
  place-items: center;

  grid-column: 3;
  grid-row:
    1 / span 2;

  border-radius: 10px;

  color: #ff8c94;

  background:
    var(--red-soft);
}

.add-pass-btn {
  width: 100%;

  min-height: 41px;

  margin-top: 8px;

  border:
    1px dashed
    rgba(108,129,239,.30);

  border-radius: 12px;

  color: #91a5ff;

  background:
    rgba(49,87,237,.06);

  font-size: 9px;
  font-weight: 700;
}


/* =========================================================
   DATE PRICING
========================================================= */

.date-pricing-list {
  display: flex;
  flex-direction: column;

  gap: 8px;
}

.date-price-card {
  overflow: hidden;

  border:
    1px solid
    var(--line);

  border-radius: 14px;

  background:
    rgba(255,255,255,.02);
}

.date-price-head {
  display: flex;
  align-items: center;

  gap: 8px;

  padding:
    10px 11px;
}

.date-badge {
