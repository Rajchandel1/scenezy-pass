/* =========================================================
   SETTINGS
========================================================= */

.settings-grid {
  display: grid;

  gap: 10px;
}

.setting-block {
  padding: 14px;

  border:
    1px solid
    var(--line);

  border-radius: 17px;

  background:
    var(--surface);
}

.setting-block h3 {
  font-size: 13px;
}

.setting-block p {
  margin-top: 5px;

  color: var(--muted);

  font-size: 9px;
  line-height: 1.5;
}

.setting-actions {
  display: flex;
  flex-wrap: wrap;

  gap: 7px;

  margin-top: 13px;
}

.code-preview {
