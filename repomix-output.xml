                    min="0"

                    value="${
                      lead.revenue ??
                      lead.expectedAmount ??
                      0
                    }"

                    data-lead-revenue="${lead.id}"
                  >

                </div>

              `
              :
              ""
            }

          </div>

        </article>

      `
