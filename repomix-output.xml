/* =========================================================
   WHATSAPP BOOKING
========================================================= */

function bookingReference(
  event
) {

  const initials =
    event.name
      .split(/\s+/)
      .map(
        word =>
          word[0]
      )
      .join("")
      .toUpperCase()
      .slice(0,3);


  return (
    `SZ-${initials}-` +
    Math.random()
      .toString(36)
      .slice(2,6)
      .toUpperCase()
  );

}


function createBooking() {

  const event =
    state.current;


  const night =
    currentNight();


  const pass =
    currentPass();


  const quantity =
    state.quantity[
      event.id
    ];


  const total =
    currentTotal();


  const reference =
    bookingReference(
      event
    );


  const nightText =
    night
    ?
    `${night.day}, ${night.date} 2026`
    :
    event.dateLabel;


  const message =
`Namaste Scenezy 🙏

I want to book passes:

Event: ${event.name}
Venue: ${event.venue}, ${event.area}
Night: ${nightText}
Pass: ${pass?.name || "To be confirmed"}
Quantity: ${quantity}
Amount: ${priceText(total)}

Booking Ref: ${reference}`;


  return {

    ref:
      reference,

    eventId:
      event.id,

    event:
      event.name,

    venue:
      `${event.venue}, ${event.area}`,

    night:
      nightText,

    pass:
      pass?.name ||
      "TBA",

    qty:
      quantity,

    total,

    message,

    whatsappURL:
      `https://wa.me/${SCENEZY.whatsapp}?text=${encodeURIComponent(message)}`,

    createdAt:
      Date.now()

  };

}


let bookingRedirectTimer;


$("#bookBtn")
  .onclick =
  () => {

    if (
      !state.current
    ) {
      return;
    }


    const button =
      $("#bookBtn");


    if (
      button.disabled
    ) {
      return;
    }


    const booking =
      createBooking();


    booking.receiptShown =
      true;


    state.lastTicket =
      booking;


    /*
       1. Lead is queued instantly.
       2. Receipt prints on Scenezy.
       3. Only after the print animation do we hand off
          to WhatsApp.
    */

    registerWhatsAppLead(
      booking
    );


    try {

      sessionStorage.setItem(

        STORAGE.pending,

        JSON.stringify(
          booking
        )

      );

    } catch {}


    button.disabled =
      true;


    $("#bookBtnText")
      .textContent =
      "Printing your receipt…";


    showPrintedTicket(
      booking,
      true
    );


    toast(
      "Receipt ready · opening WhatsApp next"
    );


    clearTimeout(
      bookingRedirectTimer
    );


    bookingRedirectTimer =
      setTimeout(
        () => {

          $("#bookBtnText")
            .textContent =
            "Opening WhatsApp…";


          /*
             Same-tab handoff is deliberate:
             delayed window.open() is commonly blocked
             by mobile browsers after an animation.
          */

          window.location.href =
            booking.whatsappURL;

        },
        2200
      );

  };


/* =========================================================
   RETURN FROM WHATSAPP
========================================================= */

let returnHandled =
  false;


function getPendingBooking() {

  try {

    const value =
      sessionStorage.getItem(
        STORAGE.pending
      );


    return (
      value
      ?
      JSON.parse(
        value
      )
      :
      null
    );

  } catch {

    return null;

  }

}


function handleReturn() {

  const booking =
    getPendingBooking();


  if (
    !booking ||
    returnHandled
  ) {
    return;
  }


  /*
     Ignore focus noise while the receipt is still printing.
  */

  if (
    Date.now() -
    booking.createdAt <
    2300
  ) {
    return;
  }


  returnHandled =
    true;


  sessionStorage.removeItem(
    STORAGE.pending
  );


  state.lastTicket =
    booking;


  /*
     The receipt animation already ran BEFORE WhatsApp.
     On return we restore it without replaying the printer.
  */

  showPrintedTicket(
    booking,
    false
  );


  const button =
    $("#bookBtn");


  if (
    button
  ) {

    button.disabled =
      false;

  }


  $("#bookBtnText")
    .textContent =
    "Book on WhatsApp";


  setTimeout(
    () => {

      returnHandled =
        false;

    },
    1000
  );

}


document.addEventListener(
  "visibilitychange",
  () => {

    if (
      document.visibilityState ===
      "visible"
    ) {

      setTimeout(
        handleReturn,
        300
      );

    }

  }
);


window.addEventListener(
  "focus",
  () => {

    setTimeout(
      handleReturn,
      350
    );

  }
);


window.addEventListener(
  "pageshow",
  () => {

    setTimeout(
      handleReturn,
      250
    );

  }
);


