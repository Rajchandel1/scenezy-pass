function normalizeDatabase(
  data
) {

  const db =
    data &&
    typeof data ===
    "object"
    ?
    data
    :
    {};


  db.version ??=
    2;


  db.settings ??=
    {};


  db.settings.whatsapp ??=
    ADMIN_CONFIG.bookingWhatsapp;


  if (
    !String(db.settings.whatsapp || "").replace(/\D/g, "") ||
    String(db.settings.whatsapp).replace(/\D/g, "") === "919999999999"
  ) {

    db.settings.whatsapp =
      ADMIN_CONFIG.bookingWhatsapp;

  }


  db.settings.city ??=
    "Ahmedabad";


  db.settings.season ??=
    "Navratri 2026";


  db.events =
    Array.isArray(
      db.events
    )
    ?
    db.events.map(
      normalizeEvent
    )
    :
    [];


  db.leads =
    Array.isArray(
      db.leads
    )
    ?
    db.leads.map(
      lead => ({

        id:
          lead.id ||
          uid(),

        eventId:
          lead.eventId ||
          "",

        eventName:
          lead.eventName ||
          lead.event ||
          "Unknown Event",

        ref:
          lead.ref ||
          "",

        night:
          lead.night ||
          "",

        passName:
          lead.passName ||
          lead.pass ||
          "",

        quantity:
          Number(
            lead.quantity ??
            lead.qty ??
            1
          ),

        expectedAmount:
          lead.expectedAmount ===
          null ||
          lead.expectedAmount ===
          undefined
          ?
          (
            lead.total ??
            null
          )
          :
          Number(
            lead.expectedAmount
          ),

        source:
          lead.source ||
          "WhatsApp CTA",

        status:
          [
            "New",
            "Contacted",
            "Converted",
            "Lost"
          ]
          .includes(
            lead.status
          )
          ?
          lead.status
          :
          "New",

        revenue:
          lead.revenue ===
          null ||
          lead.revenue ===
          undefined
          ?
          null
          :
          Number(
            lead.revenue
          ),

        clickedAt:
          Number(
            lead.clickedAt ||
            lead.createdAt ||
            lead.ts ||
            Date.now()
          ),

        convertedAt:
          lead.convertedAt
          ?
          Number(
            lead.convertedAt
          )
          :
          null

      }))
    :
    [];


  db.activity =
    Array.isArray(
      db.activity
    )
    ?
    db.activity
    :
    [];


  db.updatedAt ??=
    Date.now();


  return db;

}


function loadDatabase() {

  try {

    const keys = [

      ADMIN_CONFIG.storageKey,

      ADMIN_CONFIG.legacyStorageKey,

      ADMIN_CONFIG.olderLegacyStorageKey

    ];


    for (
      const key
      of keys
    ) {

      const raw =
        localStorage.getItem(
          key
        );


      if (
        !raw
      ) {
        continue;
      }


      const loaded =
        normalizeDatabase(
          JSON.parse(
            raw
          )
        );


      localStorage.setItem(
        ADMIN_CONFIG.storageKey,
        JSON.stringify(
          loaded
        )
      );


      return loaded;

    }


    const fresh =
      defaultDatabase();


    localStorage.setItem(
      ADMIN_CONFIG.storageKey,
      JSON.stringify(
        fresh
      )
    );


    return fresh;

  } catch (
    error
  ) {

    console.error(
      "Scenezy admin cache load failed",
      error
    );


    return defaultDatabase();

  }

}


function cacheDatabase() {

  database =
    normalizeDatabase(
      database
    );


  database.updatedAt =
    Date.now();


  try {

    localStorage.setItem(
      ADMIN_CONFIG.storageKey,
      JSON.stringify(
        database
      )
    );


    return true;

  } catch (
    error
  ) {

    console.error(
      "Scenezy cache save failed",
      error
    );


    return false;

  }

}


