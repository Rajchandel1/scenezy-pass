function normalizedScenezyPath(
  value = window.location.pathname
) {

  let path =
    String(value || "/")
      .split("?")[0]
      .split("#")[0]
      .replace(/\/{2,}/g, "/");


  if (
    path.length > 1
  ) {
    path =
      path.replace(/\/+$/, "");
  }


  return path || "/";
}


function scenezyCanonicalPath(
  path = normalizedScenezyPath()
) {

  return (
    SCENEZY_ROUTE_ALIASES[path] ||
    path
  );
}


