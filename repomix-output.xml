  if (
    query
  ) {

    leads =
      leads.filter(
        lead =>
          [
            lead.eventName,
            lead.ref,
            lead.night,
            lead.passName
          ]
          .join(" ")
          .toLowerCase()
          .includes(
            query
          )
      );

  }


  leads.sort(
    (
      a,
      b
    ) =>
      Number(
        b.clickedAt
      ) -
      Number(
        a.clickedAt
      )
  );


  if (
    !leads.length
