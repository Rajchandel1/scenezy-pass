/* =========================================================
   RETURN FROM WHATSAPP
========================================================= */

let returnHandled =
  false;


function getPendingBooking() {

  try {

    const value =
      sessionStorage.getItem(
        STORAGE.pending
      );


    return (
      value
      ?
      JSON.parse(
        value
      )
      :
      null
    );

  } catch {

    return null;

  }

}


function handleReturn() {

  const booking =
    getPendingBooking();


  if (
    !booking ||
    returnHandled
  ) return;


  if (
    Date.now() -
    booking.createdAt <
    900
  ) return;


  returnHandled = true;


  sessionStorage.removeItem(
    STORAGE.pending
  );


  state.lastTicket =
    booking;


  showPrintedTicket(
    booking,
    true
  );


  setTimeout(
    () => {

      returnHandled = false;

    },
    1000
  );

}


document.addEventListener(
  "visibilitychange",
  () => {

    if (
      document.visibilityState ===
      "visible"
    ) {

      setTimeout(
        handleReturn,
        300
      );

    }

  }
);


window.addEventListener(
  "focus",
  () => {

    setTimeout(
      handleReturn,
      350
    );

  }
);


