function eventMapURL(
  event
) {

  const direct =
    String(
      event?.mapUrl ||
      ""
    )
    .trim();


  if (
    /^https?:\/\//i.test(
      direct
    )
  ) {

    return direct;
  }


  const query =
    [
      event?.address,
      event?.venue,
      event?.area,
      SCENEZY.city
    ]
    .filter(
      Boolean
    )
    .join(
      ", "
    );


  return (
    "https://www.google.com/maps/search/?api=1&query=" +
    encodeURIComponent(
      query
    )
  );
}


function openEventMap(
  event
) {

  const url =
    eventMapURL(
      event
    );


  const opened =
    window.open(
      url,
      "_blank",
      "noopener"
    );


  if (
    !opened
  ) {

    window.location.href =
      url;

  }

}


