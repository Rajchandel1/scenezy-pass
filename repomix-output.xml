/* =========================================================
   DECK MOVEMENT
========================================================= */

function settleDeck(
  target
) {

  $("#swipeHint")
    .classList
    .add(
      "hide"
    );


  const oldIndex =
    state.active;


  const rounded =
    Math.round(
      state.position
    );


  let adjusted =
    target;


  if (
    target >=
    0 &&
    target <
    TOTAL
  ) {

    const current =
      mod(
        rounded,
        TOTAL
      );


    let difference =
      target -
      current;


    if (
      difference >
      TOTAL /
      2
    ) {

      difference -=
        TOTAL;

    }


    if (
      difference <
      -TOTAL /
      2
    ) {

      difference +=
        TOTAL;

    }


    adjusted =
      rounded +
      difference;

  }


  const motion =
    ++state.motionId;


  tween(
    state.position,
    adjusted,
    480,

    value => {

      if (
        motion !==
        state.motionId
      ) return;


      state.position =
        value;


      renderDeck(
        value
      );

    },

    () => {

      if (
        motion !==
        state.motionId
      ) return;


      state.position =
        adjusted;


      renderDeck(
        adjusted
      );


      const newIndex =
        mod(
          Math.round(
            adjusted
          ),
          TOTAL
        );


      syncHome(
        newIndex ===
        oldIndex
      );

    }
  );


  haptic(5);

}


function moveDeck(
  direction
) {

  settleDeck(
    Math.round(
      state.position
    ) +
    direction
  );

}


$("#prevBtn")
