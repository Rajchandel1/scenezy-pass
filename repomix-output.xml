/* =========================================================
   ONE-TIME LOCAL IMAGE MIGRATION

   If the prototype stored an uploaded image as a Base64 data
   URL, the first authenticated cloud seed moves it into
   Supabase Storage automatically.
========================================================= */

function scenezyDataURLToBlob(
  dataURL
) {

  const [
    header,
    payload
  ] =
    String(
      dataURL
    )
    .split(
      ","
    );


  const mime =
    header
      .match(
        /data:([^;]+)/
      )?.[1] ||
    "image/webp";


  const binary =
    atob(
      payload
    );


  const bytes =
    new Uint8Array(
      binary.length
    );


  for (
    let index = 0;
    index < binary.length;
    index++
  ) {

    bytes[
      index
    ] =
      binary.charCodeAt(
        index
      );

  }


  return new Blob(
    [
      bytes
    ],
    {
      type:
        mime
    }
  );

}


async function migrateInlineImagesToStorage() {

  if (
    !sbAdmin ||
    !await currentAdminSession()
  ) {
    return;
  }


  const inlineEvents =
    database.events.filter(
      event =>
        String(
          event.image ||
          ""
        )
        .startsWith(
          "data:image/"
        )
    );


  if (
    !inlineEvents.length
  ) {
    return;
  }


  setCloudStatus(
    "syncing",
    "Moving images…"
  );


  for (
    const event
    of inlineEvents
  ) {

    try {

      const blob =
        scenezyDataURLToBlob(
          event.image
        );


      const extension =
        blob.type ===
        "image/png"
        ?
        "png"
        :
        blob.type ===
        "image/jpeg"
        ?
        "jpg"
        :
        "webp";


      const path =
        `events/${slugify(event.id || event.name)}/${Date.now()}-${Math.random()
          .toString(36)
          .slice(2,8)}.${extension}`;


      const {
        error
      } =
        await sbAdmin
          .storage
          .from(
            "event-images"
          )
          .upload(
            path,
            blob,
            {
              contentType:
                blob.type ||
                "image/webp",

              cacheControl:
                "31536000",

              upsert:
                false
            }
          );


      if (
        error
      ) {
        throw error;
      }


      const {
        data
      } =
        sbAdmin
          .storage
          .from(
            "event-images"
          )
          .getPublicUrl(
            path
          );


      event.image =
        data.publicUrl;


      event.updatedAt =
        Date.now();


    } catch (
      error
    ) {

      console.warn(
        `Could not migrate image for ${event.name}`,
        error
      );

    }

  }

}


