      }

    ],


    updatedAt:
      now

  };

}


/* ---------------------------------------------------------
   NORMALIZE WHOLE DATABASE
--------------------------------------------------------- */

function normalizeDatabase(
  data
) {

  const database =
    data &&
    typeof data ===
    "object"
    ?
    data
    :
    {};


  database.version ??=
    1;


  database.settings ??=
    {};


  database.settings.whatsapp ??=
    ADMIN_CONFIG.bookingWhatsapp;


  database.settings.city ??=
    "Ahmedabad";


  database.settings.season ??=
    "Navratri 2026";


  database.events =
    Array.isArray(
      database.events
    )
    ?
    database.events.map(
      normalizeEvent
    )
    :
    [];


  database.events.forEach(
    event => {

      event.visible =
        event.visible !==
        false;


      event.mapUrl ??=
        "";


      event.adminNotes ??=
        "";


      event.createdAt ??=
        Date.now();


      event.updatedAt ??=
        Date.now();

    }
  );


  database.leads =
    Array.isArray(
      database.leads
    )
    ?
    database.leads
    :
    [];


  database.leads =
    database.leads.map(
      lead => ({

        id:
          lead.id ||
          uid(),


        eventId:
          lead.eventId ||
          "",


        eventName:
          lead.eventName ||
          lead.event ||
          "Unknown Event",


        ref:
          lead.ref ||
          "",


        night:
          lead.night ||
          "",


        passName:
          lead.passName ||
          lead.pass ||
          "",


        quantity:
          Number(
            lead.quantity ??
            lead.qty ??
            1
          ),


        expectedAmount:

          lead.expectedAmount ===
          null ||
          lead.expectedAmount ===
          undefined
          ?
          (
            lead.total ??
            null
          )
          :
          lead.expectedAmount,


        source:
          lead.source ||
          "WhatsApp CTA",


        status:
          [
            "New",
            "Contacted",
            "Converted",
            "Lost"
          ]
          .includes(
            lead.status
          )
          ?
          lead.status
          :
          "New",


        revenue:

          lead.revenue ===
          undefined
          ?
          null
          :
          lead.revenue,


        clickedAt:
          lead.clickedAt ||
          lead.createdAt ||
          lead.ts ||
          Date.now(),


        convertedAt:
          lead.convertedAt ||
          null

      })
    );


  database.activity =
    Array.isArray(
      database.activity
    )
    ?
    database.activity
    :
    [];


  database.updatedAt ??=
    Date.now();


  return database;

}


/* ---------------------------------------------------------
   LOAD DATABASE

   Priority:
   1. shared storage
   2. old admin storage migration
   3. seed database
--------------------------------------------------------- */

function loadDatabase() {

  try {

    /* SHARED STORE */

    const shared =
      localStorage.getItem(
        ADMIN_CONFIG.storageKey
      );


    if (
      shared
    ) {

      return normalizeDatabase(
        JSON.parse(
          shared
        )
      );

    }


    /* OLD ADMIN STORE MIGRATION */

    const legacy =
      localStorage.getItem(
        ADMIN_CONFIG.legacyStorageKey
      );


    if (
      legacy
    ) {

      const migrated =
        normalizeDatabase(
          JSON.parse(
            legacy
          )
        );


      localStorage.setItem(

        ADMIN_CONFIG.storageKey,

        JSON.stringify(
          migrated
        )

      );


      return migrated;

    }


    /* BRAND NEW */

    const fresh =
      defaultDatabase();


    localStorage.setItem(

      ADMIN_CONFIG.storageKey,

      JSON.stringify(
        fresh
      )

    );


    return fresh;

  } catch (
    error
  ) {

    console.error(
      "Scenezy database load failed",
      error
    );


    return defaultDatabase();

  }

}


/* ---------------------------------------------------------
   SAVE DATABASE
--------------------------------------------------------- */

function saveDatabase() {

  database =
    normalizeDatabase(
      database
    );


  database.updatedAt =
    Date.now();


  try {

    localStorage.setItem(

      ADMIN_CONFIG.storageKey,

      JSON.stringify(
        database
      )

    );

  } catch (
    error
  ) {

    console.error(
      "Scenezy save failed",
      error
    );


    toast(
      "Storage full · try a smaller event image"
    );


    return false;

  }


  renderAll();


  return true;

}

function structuredCloneSafe(
  value
) {

  return JSON.parse(
    JSON.stringify(
      value
    )
  );

}


/* =========================================================
   NORMALIZATION
========================================================= */

function normalizeEvent(
  event
) {

  return {

    id:
      event.id ||
      slugify(
        event.name ||
        "event"
      ),

    name:
      event.name ||
      "Untitled Event",

    tagline:
      event.tagline ||
      "",

    venue:
      event.venue ||
      "",

    area:
      event.area ||
      "",

    address:
      event.address ||
      "",

    mapUrl:
      event.mapUrl ||
      "",

    dateLabel:
      event.dateLabel ||
      "",

    startDate:
      event.startDate ||
      null,

    endDate:
      event.endDate ||
      null,

    image:
      event.image ||
      "",

    poster: {
      a:
        event.poster?.a ||
        "#31458f",

      b:
        event.poster?.b ||
        "#141a49",

      ink:
        event.poster?.ink ||
        "#f4ebda"
    },

    defaultPasses:
      (
        event.defaultPasses ||
        []
      )
      .map(
        normalizePass
      ),

    passesByDate:
      Object.fromEntries(

        Object.entries(
          event.passesByDate ||
          {}
        )
        .map(
          (
            [
              date,
              passes
            ]
          ) => [

            date,

            (
              passes ||
              []
            )
            .map(
              normalizePass
            )

          ]
        )
      ),

    visible:
      event.visible !==
      false,

    adminNotes:
      event.adminNotes ||
      "",

    createdAt:
      event.createdAt ||
      Date.now(),

    updatedAt:
      event.updatedAt ||
      Date.now()

  };

}


function normalizePass(
  pass
) {

  return {

    id:
      pass.id ||
      slugify(
        pass.name ||
        "pass"
      ),

    name:
      pass.name ||
      "Regular",

    note:
      pass.note ||
      "",

    price:
      pass.price ===
      null ||
      pass.price ===
      undefined ||
      pass.price ===
      ""
      ?
      null
      :
      Number(
        pass.price
      )

  };

}


/* =========================================================
   GENERAL HELPERS
========================================================= */

function uid() {

  return (
    Date.now()
      .toString(36) +
    Math.random()
      .toString(36)
      .slice(
        2,
        8
      )
  );

}


function slugify(
  value
) {

  return String(
    value ||
    ""
  )
  .trim()
  .toLowerCase()
  .replace(
    /[^a-z0-9]+/g,
    "-"
  )
  .replace(
    /^-+|-+$/g,
    ""
  );

}


function escapeHTML(
  value
) {

  return String(
    value ??
    ""
  )
  .replace(
    /[&<>"']/g,

    character =>
      ({

        "&":
          "&amp;",

        "<":
          "&lt;",

        ">":
          "&gt;",

        '"':
          "&quot;",

        "'":
          "&#39;"

      }[
        character
      ])
  );

}


function money(
  amount
) {

  if (
    amount ===
    null ||
    amount ===
    undefined
  ) {

    return "TBA";

  }


  return (
    "₹" +
    Number(
      amount
    )
    .toLocaleString(
      "en-IN"
    )
  );

}


function formatDateTime(
  timestamp
) {

  if (
    !timestamp
  ) {

    return "—";

  }


  return new Date(
    timestamp
  )
  .toLocaleString(
    "en-IN",
    {
      day:
        "2-digit",

      month:
        "short",

      hour:
        "2-digit",

      minute:
        "2-digit"
    }
  );

}


function toast(
  message
) {

  const element =
    $("#toast");


  element.textContent =
    message;


  element.classList.add(
    "show"
  );


  clearTimeout(
    toast.timer
  );


  toast.timer =
    setTimeout(
      () => {

        element.classList.remove(
          "show"
        );

      },
      2200
    );

}


/* =========================================================
   ACTIVITY
========================================================= */

function addActivity(
  text,
  type = "admin"
) {

  database.activity.unshift({

    id:
      uid(),

    type,

    text,

    createdAt:
      Date.now()

  });


  database.activity =
    database.activity.slice(
      0,
      100
    );

}


/* =========================================================
   EVENT ANALYTICS
========================================================= */

function leadsForEvent(
  eventId
) {

  return database.leads.filter(
    lead =>
      lead.eventId ===
      eventId
  );

}


function eventClicks(
  eventId
) {

  return leadsForEvent(
    eventId
  ).length;

}


function eventConversions(
  eventId
) {

  return leadsForEvent(
    eventId
  )
  .filter(
    lead =>
      lead.status ===
      "Converted"
  )
  .length;

}


function eventRevenue(
  eventId
) {

  return leadsForEvent(
    eventId
  )
  .filter(
    lead =>
      lead.status ===
      "Converted"
  )
  .reduce(
    (
      total,
      lead
    ) =>
      total +
      Number(
        lead.revenue ||
        0
      ),
    0
  );

}


function minEventPrice(
  event
) {

  const prices =
    [];


  (
    event.defaultPasses ||
    []
  )
  .forEach(
    pass => {

      if (
        pass.price !==
        null
      ) {

        prices.push(
          Number(
            pass.price
          )
        );

      }

    }
  );


  Object.values(
    event.passesByDate ||
    {}
  )
  .flat()
  .forEach(
    pass => {

      if (
        pass.price !==
        null
      ) {

        prices.push(
          Number(
            pass.price
          )
        );

      }

    }
  );


  return prices.length
  ?
  Math.min(
    ...prices
  )
  :
  null;

}


function customNightCount(
  event
) {

  return Object.keys(
    event.passesByDate ||
    {}
  ).length;

}


