/*
   User cache is intentionally separate from Admin cache.
   This keeps the UI instant without letting one screen
   overwrite the other's local state.
*/

const SCENEZY_USER_CACHE_KEY =
  "scenezy.user.cache.v2";


const SCENEZY_LEGACY_SHARED_KEY =
  "scenezy.shared.v1";


const SCENEZY_DEVICE_KEY =
  "scenezy.device.id.v1";


const SCENEZY_LEAD_OUTBOX_KEY =
  "scenezy.lead.outbox.v1";


let EVENTS = [];

let TOTAL = 0;

let publicRealtimeChannel = null;

let remoteRefreshTimer = null;


/* ---------------------------------------------------------
   SMALL LOCAL CACHE
--------------------------------------------------------- */

function readScenezyCache() {

  try {

    const raw =
      localStorage.getItem(
        SCENEZY_USER_CACHE_KEY
      ) ||
      localStorage.getItem(
        SCENEZY_LEGACY_SHARED_KEY
      );


    if (!raw) {
      return null;
    }


    const data =
      JSON.parse(raw);


    if (
      !data ||
      !Array.isArray(
        data.events
      )
    ) {
      return null;
    }


    return data;

  } catch (error) {

    console.warn(
      "Scenezy cache read failed",
      error
    );


    return null;
  }
}


function writeScenezyCache(
  data
) {

  try {

    data.updatedAt =
      Date.now();


    localStorage.setItem(
      SCENEZY_USER_CACHE_KEY,
      JSON.stringify(data)
    );


    return true;

  } catch (error) {

    console.warn(
      "Scenezy cache write failed",
      error
    );


    return false;
  }
}


function createInitialScenezyCache() {

  const now =
    Date.now();


  const database = {

    version: 2,

    settings: {
      whatsapp: SCENEZY.whatsapp,
      city: SCENEZY.city,
      season: SCENEZY.season
    },

    events:
      SCENEZY.events.map(
        event => ({
          ...event,
          visible:
            event.visible !== false,
          mapUrl:
            event.mapUrl || "",
          adminNotes:
            event.adminNotes || "",
          createdAt:
            event.createdAt || now,
          updatedAt:
            event.updatedAt || now
        })
      ),

    updatedAt:
      now

  };


  writeScenezyCache(
    database
  );


  return database;
}


function getScenezyCache() {

  return (
    readScenezyCache() ||
    createInitialScenezyCache()
  );
}


/* ---------------------------------------------------------
   APPLY DATA TO THE LOCKED UI
--------------------------------------------------------- */

function applyScenezyPublicData(
  database
) {

  const settings =
    database.settings ||
    {};


  const cachedWhatsapp =
    String(settings.whatsapp || "")
      .replace(/\D/g, "");


  if (
    cachedWhatsapp &&
    cachedWhatsapp !== "919999999999"
  ) {

    SCENEZY.whatsapp =
      cachedWhatsapp;

  }


  SCENEZY.city =
    settings.city ||
    SCENEZY.city;


  SCENEZY.season =
    settings.season ||
    SCENEZY.season;


  EVENTS =
    (
      database.events ||
      []
    )
    .filter(
      event =>
        event &&
        event.visible !==
        false
    );


  TOTAL =
    EVENTS.length;


  return database;
}


function loadEventsFromLocalStorage() {

  return applyScenezyPublicData(
    getScenezyCache()
  );
}


/* ---------------------------------------------------------
   SUPABASE ROW → SCENEZY EVENT
--------------------------------------------------------- */

function scenezyEventFromRow(
  row
) {

  const source =
    row?.data &&
    typeof row.data ===
    "object"
    ?
    row.data
    :
    {};


  return {

    ...source,

    id:
      String(
        row.id ||
        source.id ||
        ""
      ),

    visible:
      row.visible !==
      false,

    mapUrl:
      source.mapUrl ||
      "",

    createdAt:
      row.created_at
      ?
      Date.parse(
        row.created_at
      )
      :
      Date.now(),

    updatedAt:
      row.updated_at
      ?
      Date.parse(
        row.updated_at
      )
      :
      Date.now()

  };
}


