.cardSave .ic {
  width: 16px;
  height: 16px;
}

.cardSave:active {
  transform: scale(.88);
}

.cardSave.on {
  color: var(--blue);

  background:
    rgba(49,87,237,.09);

  border-color:
    rgba(49,87,237,.25);
}

/* =========================================================
   TICKET PERFORATION
========================================================= */

.perf {
  position: relative;

  flex: none;

  margin:
    0
    -9px;

  border-top:
    1.5px dashed
    rgba(43,37,29,.27);
}

.perf i {
  position: absolute;

  top: -8px;

  width: 15px;
  height: 15px;

  border-radius: 50%;

  background: var(--panel);
}

.perf i:first-child {
  left: -7px;
}

.perf i:last-child {
  right: -7px;
}

/* =========================================================
   CARD STUB
========================================================= */

.cardStub {
  flex: none;

  display: grid;

  grid-template-columns:
    1fr auto;

  align-items: end;

  gap: 8px;

  padding:
    10px
    7px
    0;
}

.stubLabel {
  display: block;

  color: var(--paper-dim);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .16em;

  text-transform: uppercase;
}

.stubDate {
  display: block;

  margin-top: 3px;

  font:
    italic 500
    15px
    var(--serif);
}

.stubPrice {
  text-align: right;
}

.stubPrice strong {
  display: block;

  margin-top: 3px;

  color: var(--blue);

  font-size: 15px;
  font-weight: 800;
}

.stubPrice strong.tba {
  color: var(--paper-ink);

  font-size: 11px;
}

.barcodeMini {
  grid-column:
    1 / -1;

  width: 100%;
  height: 11px;

  margin-top: 5px;

  fill: var(--paper-ink);

  opacity: .84;
}

/* =========================================================
   DECK CONTROLS
========================================================= */

.swipeHint {
  position: absolute;

  left: 50%;
  bottom: 58px;

  z-index: 50;

  transform:
    translateX(-50%);

  display: flex;
  align-items: center;

  gap: 7px;

  white-space: nowrap;

  color: #fff;

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .17em;

  text-transform: uppercase;

  transition:
    opacity .4s,
    transform .4s;
}

.swipeHint.hide {
  opacity: 0;

  transform:
    translateX(-50%)
    translateY(5px);
}

.deckControls {
  position: absolute;

  left: 0;
  right: 0;
  bottom: 3px;

  z-index: 55;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 14px;
}

.deckArrow {
  width: 41px;
  height: 41px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  color: var(--dim);

  background:
    rgba(17,17,23,.76);

  border:
    1px solid
    var(--line2);

  backdrop-filter: blur(14px);
}

.deckArrow:active {
  transform: scale(.91);
}

.deckDots {
  display: flex;
  align-items: center;

  gap: 5px;
}

.deckDots button {
  width: 5px;
  height: 5px;

  border-radius: 999px;

  background: var(--faint);

  transition:
    width .26s,
    background .26s;
}

.deckDots button.on {
  width: 18px;

  background: var(--blue);
}

/* =========================================================
   TAB BAR
========================================================= */

.tabbar {
  position: absolute;

  left: 50%;
  bottom:
    calc(13px + var(--safe-bottom));

  z-index: 200;

  transform:
    translateX(-50%);

  display: flex;

  gap: 4px;

  padding: 5px;

  border-radius: 999px;

  border:
    1px solid
    var(--line2);

  background:
    rgba(24,24,31,.91);

  backdrop-filter: blur(18px);

  box-shadow:
    0 11px 32px
    rgba(0,0,0,.38);
}

.tab {
  position: relative;

  width: 52px;
  height: 43px;

  display: grid;
  place-items: center;

  border-radius: 999px;

  color: var(--dim);

  transition:
    background .25s,
    color .25s,
    transform .16s;
}

.tab.on {
  color: white;

  background:
    linear-gradient(
      145deg,
      #3d62f1,
      #2949ce
    );
}

.tab:active {
  transform: scale(.91);
}

.tabBadge {
  position: absolute;

  right: 5px;
  top: 4px;

  display: none;
  place-items: center;

  min-width: 14px;
  height: 14px;

  padding:
    0
    3px;

  border-radius: 999px;

  color: #171208;

  background: var(--gold);

  font-size: 8px;
  font-weight: 800;
}

.tabBadge.show {
  display: grid;
}

/* =========================================================
   SCREENS
========================================================= */

.screen {
  position: absolute;
  inset: 0;

  z-index: 140;

  display: flex;
  flex-direction: column;

  visibility: hidden;

  pointer-events: none;

  opacity: 0;

  transform:
    translateY(13px);

  background:
    linear-gradient(
      rgba(16,16,21,.94),
      rgba(16,16,21,.99)
    );

  transition:
    opacity .35s,
    transform .4s cubic-bezier(.2,.8,.2,1),
    visibility 0s .4s;
}

.screen.open {
  visibility: visible;

  pointer-events: auto;

  opacity: 1;

  transform: none;

  transition:
    opacity .35s,
    transform .4s cubic-bezier(.2,.8,.2,1),
    visibility 0s;
}

.screenHeader {
  display: flex;
  align-items: center;

  gap: 10px;

  padding:
    calc(15px + var(--safe-top))
    16px
    10px;
}

.screenTitle {
  font:
    italic 500
    18px
    var(--serif);

  color: var(--dim);
}

/* =========================================================
   SEARCH
========================================================= */

.searchBar {
  flex: 1;
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 8px;

  padding:
    11px
    14px;

  border-radius: 999px;

  background: var(--panel2);

  border:
    1px solid
    var(--line2);
}

.searchBar input {
  width: 100%;

  border: 0;
  outline: 0;

  background: none;

  color: var(--ink);
}

.searchBar input::placeholder {
  color: var(--faint);
}

.searchContent {
  flex: 1;

  overflow-y: auto;

  padding:
    5px
    16px
    105px;

  scrollbar-width: none;
}

.searchContent::-webkit-scrollbar {
  display: none;
}

.searchLabel {
  margin:
    8px
    3px
    10px;

  color: var(--faint);

  font-size: 9px;
  font-weight: 700;

  letter-spacing: .2em;

  text-transform: uppercase;
}

.result {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 12px;

  padding:
    12px
    3px;

  text-align: left;

  border-bottom:
    1px solid
    var(--line);
}

.resultThumb {
  width: 52px;
  height: 58px;

  flex: none;

  overflow: hidden;

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      var(--a),
      var(--b)
    );
}

.resultThumb img {
  width: 100%;
  height: 100%;

  object-fit: cover;
}

.resultMain {
  flex: 1;
  min-width: 0;
}

.resultMain strong {
  display: block;

  font:
    italic 500
    17px
    var(--serif);

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.resultMain span {
  display: block;

  margin-top: 3px;

  color: var(--dim);

  font-size: 11px;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.resultPrice {
  flex: none;

  text-align: right;

  color: var(--dim);

  font-size: 9px;
}

.resultPrice strong {
  display: block;

  margin-top: 2px;

  color: var(--ink);

  font-size: 12px;
}

/* =========================================================
   MY PASSES = SAVED EVENTS
========================================================= */

.passWallet {
  flex: 1;

  display: flex;
  flex-direction: column;

  overflow: hidden;
}

.passTrack {
  flex: 1;

  display: flex;
  align-items: center;

  gap: 17px;

  overflow-x: auto;
  overflow-y: hidden;

  scroll-snap-type:
    x mandatory;

  padding:
    20px
    9%
    15px;

  scrollbar-width: none;
}

.passTrack::-webkit-scrollbar {
  display: none;
}

.savedPass {
  flex:
    0 0
    84%;

  width: 84%;
  max-width: 84%;
  min-width: 0;

  box-sizing: border-box;
  overflow: hidden;

  scroll-snap-align:
    center;

  padding: 0;

  background: none;

  text-align: left;

  filter:
    drop-shadow(
      0 20px 29px
      rgba(0,0,0,.46)
    );

  transition:
    transform .22s;
}

.savedPass:active {
  transform:
    scale(.985);
}

.savedPassPaper {
  display: block;

  width: 100%;
  max-width: 100%;
  min-width: 0;

  box-sizing: border-box;

  overflow: hidden;

  border-radius:
    22px
    22px
    0
    0;

  background: var(--paper);

  color: var(--paper-ink);
}

.savedPassArt {
  position: relative;

  display: block;

  height: 154px;

  overflow: hidden;
}

.savedPassArt
.posterBottom {
  display: none;
}

.savedPassArt
.mandala {
  width: 145px;
  height: 145px;
}

.savedPassBody {
  display: block;

  padding:
    14px
    16px
    15px;
}

.savedPassBrand {
  display: flex;
  align-items: center;

  gap: 6px;

  color: var(--paper-dim);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .2em;

  text-transform: uppercase;
}

.savedPassBrand img {
  width: 17px;
  height: 17px;

  object-fit: contain;

  opacity: .65;
}

.savedPassName {
  display: -webkit-box;

  min-height: 50px;

  margin-top: 7px;

  overflow: hidden;

  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;

  font:
    italic 500
    23px/1.07
    var(--serif);

  letter-spacing: -.025em;

  text-wrap: balance;
}

.savedPassVenue {
  display: block;

  width: 100%;
  max-width: 100%;
  min-width: 0;

  box-sizing: border-box;

  margin-top: 5px;

  color: var(--paper-dim);

  font-size: 9px;
  font-weight: 600;

  letter-spacing: .07em;

  text-transform: uppercase;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.savedPassGrid {
  display: grid;

  grid-template-columns:
    1.2fr
    1fr;

  gap: 10px;

  margin-top: 14px;

  padding-top: 12px;

  border-top:
    1px solid
    rgba(43,37,29,.14);
}

.savedPassGrid small {
  display: block;

  color: var(--paper-dim);

  font-size: 7.5px;
  font-weight: 700;

  letter-spacing: .15em;

  text-transform: uppercase;
}

.savedPassGrid strong {
  display: block;

  margin-top: 4px;

  font-size: 11px;
  line-height: 1.35;
  font-weight: 600;
}

.savedPassGrid .price {
  color: var(--blue);

  font-size: 12px;
}

.savedPassPerf {
  position: relative;

  display: block;

  border-top:
    2px dashed
    rgba(43,37,29,.29);
}

.savedPassPerf i {
  position: absolute;

  top: -9px;

  width: 18px;
  height: 18px;

  border-radius: 50%;

  background: var(--panel);
}

.savedPassPerf i:first-child {
  left: -9px;
}

.savedPassPerf i:last-child {
  right: -9px;
}

.savedPassStub {
  display: block;

  padding:
    13px
    16px
    15px;
}

.savedPassStub svg {
  width: 100%;
  height: 32px;

  fill: var(--paper-ink);

  opacity: .9;
}

.savedPassCode {
  display: block;

  margin-top: 7px;

  color: var(--paper-dim);

  text-align: center;

  font-size: 9px;
  font-weight: 600;

  letter-spacing: .22em;
}

.savedPassTear {
  display: block;

  height: 10px;

  background:
    conic-gradient(
      from 45deg at 50% 0,
      var(--paper) 90deg,
      transparent 0
    )
    50% 0 /
    14px 10px
    repeat-x;
}

.passDots {
  min-height: 88px;

  display: flex;
  justify-content: center;

  gap: 6px;

  padding-top: 8px;
}

.passDots i {
  width: 5px;
  height: 5px;

  border-radius: 999px;

  background: var(--faint);

  transition:
    width .25s,
    background .25s;
}

.passDots i.on {
  width: 18px;

  background: var(--blue);
}

.passEmpty {
  flex: 1;

  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  padding: 30px;

  text-align: center;

  color: var(--dim);
}

.passEmptyIcon {
  width: 61px;
  height: 61px;

  display: grid;
  place-items: center;

  margin-bottom: 15px;

  border-radius: 19px;

  color: var(--faint);

  background: var(--panel2);

  border:
    1px solid
    var(--line2);
}

.passEmpty h3 {
  color: var(--ink);

  font:
    italic 500
    22px
    var(--serif);
}

.passEmpty p {
  max-width: 270px;

  margin-top: 7px;

  font-size: 11px;
  line-height: 1.55;
}

/* =========================================================
   DETAIL
========================================================= */

.detail {
  position: absolute;
  inset: 0;

  width: 100%;
  max-width: 100%;
  min-width: 0;

  overflow: hidden;

  z-index: 250;

  display: flex;
  flex-direction: column;

  visibility: hidden;

  transform:
    translateY(103%);

  background: var(--panel);

  transition:
    transform .55s cubic-bezier(.22,.9,.24,1),
    visibility 0s .55s;
}

.detail.open {
  visibility: visible;

  transform: none;

  transition:
    transform .55s cubic-bezier(.22,.9,.24,1),
    visibility 0s;
}

.detailButtons {
  position: absolute;

  left: 0;
  right: 0;
  top: 0;

  z-index: 70;

  display: flex;
  justify-content: space-between;

  padding:
    calc(14px + var(--safe-top))
    15px;

  pointer-events: none;
}

.detailButtons button {
  pointer-events: auto;
}

/* dark back button */

.detailBackBtn {
  color: white;

  border:
    1px solid
    rgba(255,255,255,.20);

  background:
    rgba(12,12,16,.62);

  box-shadow:
    0 6px 20px
    rgba(0,0,0,.20);
}

/*
   Share is intentionally white so it's clearly
   visible on dark / bright event posters.
*/

.shareBtn {
  color: #17171d;

  border:
    1px solid
    rgba(255,255,255,.65);

  background:
    rgba(255,255,255,.92);

  box-shadow:
    0 7px 24px
    rgba(0,0,0,.24);

  backdrop-filter:
    blur(12px);
}

.shareBtn .ic {
  width: 19px;
  height: 19px;

  stroke-width: 1.9;
}

.detailBody {
  flex: 1;

  overflow-y: auto;
  overflow-x: hidden;

  scrollbar-width: none;
}

.detailBody::-webkit-scrollbar {
  display: none;
}

.detailPoster {
  position: relative;

  height: 345px;

  overflow: hidden;
}

.detailPoster
.poster {
  position: absolute;
  inset: 0;
}

.detailPoster
.mandala {
  width: 255px;
  height: 255px;
}

.detailPoster
.posterBottom {
  display: none;
}

.detailPoster::after {
  content: "";

  position: absolute;

  left: 0;
  right: 0;
  bottom: -1px;

  z-index: 20;

  height: 145px;

  background:
    linear-gradient(
      transparent,
      var(--panel)
    );
}

.detailContent {
  position: relative;

  z-index: 25;

  margin-top: -43px;

  padding:
    0
    14px
    135px;
}

.detailEyebrow {
  display: flex;
  align-items: center;

  gap: 8px;

  color: var(--faint);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .21em;

  text-transform: uppercase;
}

.detailEyebrow::before {
  content: "";

  width: 20px;
  height: 1px;

  background: var(--gold);
}

.detailTitle {
  margin-top: 8px;

  color: var(--ink2);

  font:
    italic 500
    clamp(31px,9vw,37px)/1
    var(--serif);

  letter-spacing: -.035em;

  text-wrap: balance;
}

.detailTagline {
  margin-top: 7px;

  color: var(--dim);

  font-size: 12px;
  line-height: 1.5;
}

/* =========================================================
   FACTS
========================================================= */

.facts {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 8px;

  margin-top: 20px;
}

.fact {
  min-height: 86px;

  padding: 13px;

  border-radius: 17px;

  background:
    rgba(26,26,33,.9);

  border:
    1px solid
    var(--line);
}

.fact.full {
  grid-column:
    1 / -1;

  min-height: 0;
}

.fact .ic {
  width: 15px;
  height: 15px;

  color: var(--faint);
}

.fact small {
  display: block;

  margin-top: 11px;

  color: var(--faint);

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .17em;

  text-transform: uppercase;
}

.fact strong {
  display: block;

  width: 100%;
  max-width: 100%;
  min-width: 0;

  margin-top: 4px;

  font-size: 11.5px;
  line-height: 1.38;

  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.fact.price strong {
  color: #8298ff;

  font-size: 16px;
}

/* =========================================================
   SECTION TITLE
========================================================= */

.sectionLabel {
  display: flex;
  align-items: center;

  gap: 10px;

  margin:
    24px
    0
    10px;

  color: var(--faint);

  font-size: 8.5px;
  font-weight: 700;

  letter-spacing: .22em;

  text-transform: uppercase;
}

.sectionLabel::after {
  content: "";

  flex: 1;

  height: 1px;

  background: var(--line);
}

/* =========================================================
   NIGHTS
========================================================= */

.nightScroller {
  display: flex;

  gap: 9px;

  margin:
    0
    -14px;

  padding:
    4px
    24px
    10px;

  scroll-padding-inline:
    24px;

  overflow-x: auto;

  scroll-snap-type:
    x mandatory;

  scrollbar-width: none;
}

.nightScroller::-webkit-scrollbar {
  display: none;
}

.nightChip {
  flex:
    0 0
    86px;

  scroll-snap-align:
    center;

  padding:
    11px
    10px;

  border-radius: 15px;

  border:
    1px solid
    var(--line2);

  background:
    rgba(25,25,32,.87);

  text-align: left;

  transition:
    transform .16s,
    background .22s;
}

.nightChip:active {
  transform: scale(.96);
}

.nightChip small {
  display: block;

  color: var(--faint);

  font-size: 7.5px;
  font-weight: 700;

  letter-spacing: .14em;

  text-transform: uppercase;
}

.nightChip strong {
  display: block;

  margin-top: 5px;

  font-size: 12px;
}

.nightChip span {
  display: block;

  margin-top: 3px;

  color: var(--dim);

  font-size: 10px;
}

.nightChip.on {
  color: white;

  border-color: transparent;

  background:
    linear-gradient(
      145deg,
      #4165f3,
      #2949d1
    );

  box-shadow:
    0 9px 24px
    rgba(49,87,237,.23);
}

.nightChip.on small,
.nightChip.on span {
  color:
    rgba(255,255,255,.70);
}

.selectedNight {
  display: flex;
  align-items: center;

  gap: 10px;

  margin-top: 8px;

  padding:
    12px
    13px;

  border-radius: 16px;

  border:
    1px solid
    rgba(68,96,222,.21);

  background:
    rgba(49,87,237,.075);
}

.selectedNightIcon {
  width: 34px;
  height: 34px;

  flex: none;

  display: grid;
  place-items: center;

  border-radius: 50%;

  color: #8298ff;

  background:
    rgba(49,87,237,.15);
}

.selectedNightIcon .ic {
  width: 15px;
  height: 15px;
}

.selectedNightCopy {
  flex: 1;
}

.selectedNightCopy small {
  display: block;

  color: var(--faint);

  font-size: 7.5px;
  font-weight: 700;

  letter-spacing: .16em;

  text-transform: uppercase;
}

.selectedNightCopy strong {
  display: block;

  margin-top: 3px;

  font-size: 11px;
}

.selectedNightPrice {
  font:
    italic 500
    16px
    var(--serif);
}

.tbaBox {
  padding: 15px;

  border-radius: 16px;

  color: var(--dim);

  border:
    1px dashed
    var(--line2);

  background: var(--panel2);

  font-size: 11px;
  line-height: 1.5;
}

/* =========================================================
   PASS TYPES
========================================================= */

.passList {
  display: flex;
  flex-direction: column;

  gap: 8px;
}

.passOption {
  width: 100%;

  display: flex;
  align-items: center;

  gap: 11px;

  padding:
    12px
    13px;

  border-radius: 16px;

  border:
    1px solid
    var(--line2);

  background:
    rgba(25,25,32,.84);

  text-align: left;
}

.passOption:active {
  transform: scale(.985);
}

.passRadio {
  position: relative;

  width: 18px;
  height: 18px;

  flex: none;

