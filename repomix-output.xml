/* =========================================================
   SHARED LOCAL STORAGE
   ADMIN + USER SAME TEST DATABASE
========================================================= */

const SCENEZY_SHARED_KEY =
  "scenezy.shared.v1";


let EVENTS = [];

let TOTAL = 0;


function readScenezyShared() {

  try {

    const raw =
      localStorage.getItem(
        SCENEZY_SHARED_KEY
      );


    if (!raw) {
      return null;
    }


    const data =
      JSON.parse(raw);


    if (
      !data ||
      !Array.isArray(data.events)
    ) {
      return null;
    }


    return data;

  } catch (error) {

    console.error(
      "Scenezy shared storage read failed",
      error
    );


    return null;
  }
}


function writeScenezyShared(
  data
) {

  try {

    data.updatedAt =
      Date.now();


    localStorage.setItem(
      SCENEZY_SHARED_KEY,
      JSON.stringify(data)
    );


    return true;

  } catch (error) {

    console.error(
      "Scenezy shared storage write failed",
      error
    );


    return false;
  }
}


function createInitialScenezyShared() {

  const now =
    Date.now();


  const database = {

    version: 1,

    settings: {
      whatsapp: SCENEZY.whatsapp,
      city: SCENEZY.city,
      season: SCENEZY.season
    },

    events:
      SCENEZY.events.map(
        event => ({
          ...event,
          visible:
            event.visible !== false,
          mapUrl:
            event.mapUrl || "",
          adminNotes:
            event.adminNotes || "",
          createdAt:
            event.createdAt || now,
          updatedAt:
            event.updatedAt || now
        })
      ),

    leads: [],

    activity: [
      {
        id:
          "system_" + now,
        type:
          "system",
        text:
          "Scenezy local testing initialized",
        createdAt:
          now
      }
    ],

    updatedAt:
      now
  };


  writeScenezyShared(
    database
  );


  return database;
}


function getScenezyShared() {

  return (
    readScenezyShared() ||
    createInitialScenezyShared()
  );
}


function loadEventsFromLocalStorage() {

  const database =
    getScenezyShared();


  const settings =
    database.settings || {};


  SCENEZY.whatsapp =
    settings.whatsapp ||
    SCENEZY.whatsapp;


  SCENEZY.city =
    settings.city ||
    SCENEZY.city;


  SCENEZY.season =
