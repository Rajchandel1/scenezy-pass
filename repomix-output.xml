  align-items: center;

  gap: 6px;
}

.revenue-editor span {
  color: var(--muted);

  font-size: 8px;
}

.revenue-editor input {
  width: 90px;
  min-height: 34px;

  padding:
    0 9px;

  border-radius: 9px;

  font-size: 9px;
