                      event.visible
                      ?
                      "Live"
                      :
                      "Hidden"
                    }

                  </span>

                </div>


                <div class="event-place">

                  ${escapeHTML(event.venue)}

                  ${
                    event.area
                    ?
                    ` · ${escapeHTML(event.area)}`
                    :
                    ""
                  }

                </div>


                <div class="event-date">
                  ${escapeHTML(event.dateLabel || "Date TBA")}
                </div>


                <div class="mini-metrics">

                  <span class="mini-metric">
                    ${
                      price === null
                      ?
                      "Price TBA"
                      :
                      `From ${money(price)}`
                    }
                  </span>

                  <span class="mini-metric">
                    ${passCount} default pass${passCount !== 1 ? "es" : ""}
                  </span>

                  <span class="mini-metric">
                    ${custom} custom night${custom !== 1 ? "s" : ""}
                  </span>

                  <span class="mini-metric">
                    ${eventClicks(event.id)} clicks
                  </span>

                  <span class="mini-metric">
                    ${eventConversions(event.id)} converted
                  </span>

                  <span class="mini-metric">
                    ${money(eventRevenue(event.id))} revenue
                  </span>

