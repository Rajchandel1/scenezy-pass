function renderLeads() {

  const query =
    $("#leadSearch")
    ?.value
    .trim()
    .toLowerCase() ||
    "";


  let leads =
    [
      ...database.leads
    ];


  if (
    leadFilter !==
    "all"
  ) {

    leads =
      leads.filter(
        lead =>
          lead.status ===
          leadFilter
      );

  }


  if (
    query
  ) {

    leads =
      leads.filter(
        lead =>
          [
            lead.eventName,
            lead.ref,
            lead.night,
            lead.passName
          ]
          .join(" ")
          .toLowerCase()
          .includes(
            query
          )
      );

  }


  leads.sort(
    (
      a,
      b
    ) =>
      Number(
        b.clickedAt
      ) -
      Number(
        a.clickedAt
      )
  );


  if (
    !leads.length
  ) {

    $("#leadList")
      .innerHTML =
      emptyHTML(
        "No WhatsApp leads yet",
        "Once click tracking is connected to the backend, every booking-button click will appear here automatically."
      );


    return;

  }


  $("#leadList")
    .innerHTML =
    leads.map(
      (
        lead,
        index
      ) => `

        <article
          class="lead-card"
          data-lead="${lead.id}"
        >

          <div class="lead-head">

            <div class="lead-number">
              ${index + 1}
            </div>


            <div class="lead-main">

              <b>
                ${escapeHTML(lead.eventName)}
              </b>

              <span class="lead-ref">
                ${escapeHTML(lead.ref || "No booking ref")}
              </span>

            </div>


            <div class="lead-status">

              <select
                data-lead-status="${lead.id}"
              >

                ${leadStatusOptions(lead.status)}

              </select>

            </div>

          </div>


          <div class="lead-details">

            ${
              lead.night
              ?
              `
                <span class="lead-tag">
                  ${escapeHTML(lead.night)}
                </span>
              `
              :
              ""
            }

            ${
              lead.passName
              ?
              `
                <span class="lead-tag">
                  ${escapeHTML(lead.passName)}
                </span>
              `
              :
              ""
            }

            ${
              lead.quantity
              ?
              `
                <span class="lead-tag">
                  Qty ${lead.quantity}
                </span>
              `
              :
              ""
            }

            <span class="lead-tag">
              Expected ${money(lead.expectedAmount)}
            </span>

            <span class="lead-tag">
              ${escapeHTML(lead.source || "WhatsApp CTA")}
            </span>

          </div>


          <div class="lead-footer">

            <span class="lead-time">

              Clicked
              ${formatDateTime(lead.clickedAt)}

              ${
                lead.convertedAt
                ?
                ` · Converted ${formatDateTime(lead.convertedAt)}`
                :
                ""
              }

            </span>


            ${
              lead.status ===
              "Converted"
              ?
              `

                <div class="revenue-editor">

                  <span>
                    Revenue
                  </span>

                  <input
                    type="number"
                    min="0"

                    value="${
                      lead.revenue ??
                      lead.expectedAmount ??
                      0
                    }"

                    data-lead-revenue="${lead.id}"
                  >

                </div>

              `
              :
              ""
            }

          </div>

        </article>

      `
    )
    .join("");


  bindLeadActions();

}


function leadStatusOptions(
  current
) {

  return [
    "New",
    "Contacted",
    "Converted",
    "Lost"
  ]
  .map(
    status => `

      <option
        value="${status}"

        ${
          status ===
          current
          ?
          "selected"
          :
          ""
        }
      >
        ${status}
      </option>

    `
  )
  .join("");

}


function bindLeadActions() {

  $$("[data-lead-status]")
    .forEach(
      select => {

        select.onchange =
          () => {

            updateLeadStatus(
              select.dataset.leadStatus,
              select.value
            );

          };

      }
    );


  $$("[data-lead-revenue]")
    .forEach(
      input => {

        input.onchange =
          () => {

            const lead =
              database.leads.find(
                item =>
                  item.id ===
                  input.dataset.leadRevenue
              );


            if (
              !lead
            ) {

              return;

            }


            lead.revenue =
              Math.max(
                0,
                Number(
                  input.value ||
                  0
                )
              );


            addActivity(
              `Revenue updated for ${lead.eventName}`
            );


            saveDatabase();


            toast(
              "Revenue updated"
            );

          };

      }
    );

}


function updateLeadStatus(
  id,
  status
) {

  const lead =
    database.leads.find(
      item =>
        item.id ===
        id
    );


  if (
    !lead
  ) {

    return;

  }


  lead.status =
    status;


  if (
    status ===
    "Converted"
  ) {

    lead.convertedAt ??=
      Date.now();


    if (
      lead.revenue ===
      null ||
      lead.revenue ===
      undefined
    ) {

      lead.revenue =
        Number(
          lead.expectedAmount ||
          0
        );

    }

  } else {

    lead.convertedAt =
      null;

  }


  addActivity(
    `${lead.eventName} lead → ${status}`
  );


  saveDatabase();


  toast(
    `Lead marked ${status}`
  );

}


