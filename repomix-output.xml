/* =========================================================
   EVENTS
========================================================= */

function renderEvents() {

  const query =
    $("#eventSearch")
    ?.value
    .trim()
    .toLowerCase() ||
    "";


  let events =
    [
      ...database.events
    ];


  if (
    eventFilter ===
    "live"
  ) {

    events =
      events.filter(
        event =>
          event.visible
      );

  }


  if (
    eventFilter ===
    "hidden"
  ) {

    events =
      events.filter(
        event =>
          !event.visible
      );

  }


  if (
    query
  ) {

    events =
      events.filter(
        event =>
          [
            event.name,
            event.venue,
            event.area,
            event.address
          ]
          .join(" ")
          .toLowerCase()
          .includes(
            query
          )
      );

  }


  events.sort(
    (
      a,
      b
    ) =>
      Number(
        b.updatedAt
      ) -
      Number(
        a.updatedAt
      )
  );


  if (
    !events.length
  ) {

    $("#eventList")
      .innerHTML =
      emptyHTML(
