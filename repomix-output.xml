========================================================= */

.toast {
  position: fixed;

  left: 50%;
  bottom:
    calc(86px + var(--safe-bottom));

  z-index: 2000;

  max-width:
    calc(100% - 30px);

  padding:
    10px 14px;

  border:
    1px solid
    var(--line-2);

  border-radius: 999px;

  color: var(--ink);

  background:
    rgba(40,42,53,.97);

  box-shadow:
    0 10px 30px
    rgba(0,0,0,.3);

  font-size: 9px;

  opacity: 0;

  pointer-events: none;

  transform:
    translate(-50%,12px);

  transition:
    opacity .22s ease,
    transform .22s ease;
}

.toast.show {
  opacity: 1;

  transform:
    translate(-50%,0);
}


