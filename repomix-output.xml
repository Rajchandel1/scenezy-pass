function mod(
  number,
  length
) {

  return (
    (
      number %
      length
    ) +
    length
  ) %
  length;

}


function escapeHTML(
  value
) {

  return String(
    value ?? ""
  )
  .replace(
    /[&<>"']/g,

    character =>
      ({

        "&": "&amp;",

        "<": "&lt;",

        ">": "&gt;",

        '"': "&quot;",

        "'": "&#39;"

      }[
        character
      ])
  );

}


function priceText(
  price
) {

  if (
    price === null ||
    price === undefined
  ) {

    return "Price TBA";

  }


  return (
    "₹" +
    Number(price)
      .toLocaleString(
        "en-IN"
      )
  );

}


function eventBasePrice(
  event
) {

  const prices =
    (event.defaultPasses || [])
      .map(
        pass =>
          pass.price
      )
      .filter(
        value =>
          value !== null &&
          value !== undefined
      );


  if (
    !prices.length
  ) {

    return null;

  }


  return Math.min(
    ...prices
  );

}


