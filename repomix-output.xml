function toggleEventVisibility(
  id
) {

  const event =
    database.events.find(
      item =>
        item.id ===
        id
    );


  if (
    !event
  ) {

    return;

  }


  event.visible =
    !event.visible;


  event.updatedAt =
    Date.now();


  addActivity(
    `${event.name} ${
      event.visible
      ?
      "shown"
      :
      "hidden"
    }`
  );


  saveDatabase();


  toast(
    event.visible
    ?
    "Event is now live"
    :
    "Event hidden from public"
  );

}


function duplicateEvent(
  id
) {

  const source =
    database.events.find(
      event =>
        event.id ===
        id
    );


  if (
    !source
  ) {

    return;

  }


  const duplicate =
    structuredCloneSafe(
      source
    );


  duplicate.id =
    uniqueEventId(
      `${source.id}-copy`
    );


  duplicate.name =
    `${source.name} Copy`;


  duplicate.visible =
    false;


  duplicate.createdAt =
    Date.now();


  duplicate.updatedAt =
    Date.now();


  database.events.unshift(
    duplicate
  );


  addActivity(
    `Duplicated ${source.name}`
  );


  saveDatabase();


  toast(
    "Event duplicated as hidden"
  );


  openEventEditor(
    duplicate.id
  );

}


function askDeleteEvent(
  id
) {

  const event =
    database.events.find(
      item =>
        item.id ===
        id
    );


  if (
    !event
  ) {

    return;

  }


  showConfirm({

    title:
      `Delete ${event.name}?`,

    text:
      "The event will be removed from the admin database. Existing lead records will be preserved.",

    yes:
      "Delete",

    onConfirm:
      () => {

        database.events =
          database.events.filter(
            item =>
              item.id !==
              id
          );


        addActivity(
          `Deleted ${event.name}`
        );


        saveDatabase();


        toast(
          "Event deleted"
        );

      }

  });

}


