function openEventEditor(
  id = null
) {

  editingEventId =
    id;


  if (
    id
  ) {

    const event =
      database.events.find(
        item =>
          item.id ===
          id
      );


    if (
      !event
    ) {

      return;

    }


    eventDraft =
      structuredCloneSafe(
        event
      );


    $("#editorMode")
      .textContent =
      "Editing Event";


    $("#editorTitle")
      .textContent =
      event.name;


    $("#editorDuplicate")
      .hidden =
      false;

  } else {

    eventDraft =
      emptyEvent();


    /* New event should always restore automatic ID generation. */
    delete $("#fId").dataset.manual;


