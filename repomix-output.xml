/* =========================================================
   CLOUD IMAGE UPLOAD
========================================================= */

function compressScenezyImageBlob(
  file,
  maxDimension = 1200,
  quality = .82
) {

  return new Promise(
    (
      resolve,
      reject
    ) => {

      const reader =
        new FileReader();


      reader.onload =
        () => {

          const image =
            new Image();


          image.onload =
            () => {

              let width =
                image.naturalWidth ||
                image.width;


              let height =
                image.naturalHeight ||
                image.height;


              if (
                width >
                maxDimension ||
                height >
                maxDimension
              ) {

                const scale =
                  Math.min(

                    maxDimension /
                    width,

                    maxDimension /
                    height

                  );


                width =
                  Math.round(
                    width *
                    scale
                  );


                height =
                  Math.round(
                    height *
                    scale
                  );

              }


              const canvas =
                document.createElement(
                  "canvas"
                );


              canvas.width =
                width;


              canvas.height =
                height;


              const context =
                canvas.getContext(
                  "2d"
                );


              context.drawImage(

                image,

                0,
                0,

                width,
                height

              );


              canvas.toBlob(
                blob => {

                  if (
                    blob
                  ) {

                    resolve(
                      blob
                    );

                  } else {

                    reject(
                      new Error(
                        "Image compression failed"
                      )
                    );

                  }

                },
                "image/webp",
                quality
              );

            };


          image.onerror =
            () =>
              reject(
                new Error(
                  "Could not read image"
                )
              );


          image.src =
            reader.result;

        };


      reader.onerror =
        () =>
          reject(
            new Error(
              "Could not read image"
            )
          );


      reader.readAsDataURL(
        file
      );

    }
  );

}


function blobToDataURL(
  blob
) {

  return new Promise(
    (
      resolve,
      reject
    ) => {

      const reader =
        new FileReader();


      reader.onload =
        () =>
          resolve(
            reader.result
          );


      reader.onerror =
        reject;


      reader.readAsDataURL(
        blob
      );

    }
  );

}


function installScenezyImageUploader() {

  if (
    $("#scenezyCloudImageUpload")
  ) {
    return;
  }


  const imageInput =
    $("#fImage");


  if (
    !imageInput
  ) {
    return;
  }


  const imageField =
    imageInput.closest(
      ".field"
    );


  if (
    !imageField
  ) {
    return;
  }


  const uploadField =
    document.createElement(
      "div"
    );


  uploadField.className =
    "field";


  uploadField.innerHTML =
    `

      <label>
        Upload Event Image
      </label>

      <input
        id="scenezyCloudImageUpload"
        type="file"
        accept="image/jpeg,image/png,image/webp,image/*"
      >

      <small id="scenezyUploadStatus">
        Image is compressed to WebP and uploaded to Scenezy cloud storage.
      </small>

    `;


  imageField.insertAdjacentElement(
    "afterend",
    uploadField
  );


  $("#scenezyCloudImageUpload")
    .addEventListener(
      "change",
      async event => {

        const input =
          event.currentTarget;


        const file =
          input.files?.[
            0
          ];


        if (
          !file
        ) {
          return;
        }


        if (
          !file.type.startsWith(
            "image/"
          )
        ) {

          toast(
            "Please select an image"
          );


          input.value =
            "";


          return;
        }


        const status =
          $("#scenezyUploadStatus");


        input.disabled =
          true;


        status.textContent =
          "Optimising image…";


        try {

          const blob =
            await compressScenezyImageBlob(
              file
            );


          let imageURL;


          if (
            sbAdmin &&
            await currentAdminSession()
          ) {

            status.textContent =
              "Uploading to Supabase Storage…";


            const baseId =
              slugify(
                eventDraft?.id ||
                $("#fId")?.value ||
                $("#fName")?.value ||
                "event"
              ) ||
              "event";


            const path =
              `events/${baseId}/${Date.now()}-${Math.random()
                .toString(36)
                .slice(2,8)}.webp`;


            const {
              error:
                uploadError
            } =
              await sbAdmin
                .storage
                .from(
                  "event-images"
                )
                .upload(
                  path,
                  blob,
                  {
                    contentType:
                      "image/webp",

                    cacheControl:
                      "31536000",

                    upsert:
                      false
                  }
                );


            if (
              uploadError
            ) {
              throw uploadError;
            }


            const {
              data
            } =
              sbAdmin
                .storage
                .from(
                  "event-images"
                )
                .getPublicUrl(
                  path
                );


            imageURL =
              data.publicUrl;


            status.textContent =
              "Uploaded · save the event to publish it.";

          } else {

            /*
               Local fallback only when Supabase isn't configured.
            */

            imageURL =
              await blobToDataURL(
                blob
              );


            status.textContent =
              "Saved in local cache mode.";

          }


          $("#fImage")
            .value =
            imageURL;


          if (
            eventDraft
          ) {

            eventDraft.image =
              imageURL;

          }


          updateImagePreview();


          toast(
            "Image ready"
          );


        } catch (
          error
        ) {

          console.error(
            error
          );


          status.textContent =
            "Upload failed · choose the image again.";


          toast(
            error.message ||
            "Could not upload image"
          );

        } finally {

          input.disabled =
            false;


          input.value =
            "";

        }

      }
    );

}


/* =========================================================
   BOOT
========================================================= */

async function boot() {

  /*
     Paint cached data instantly.
  */

  renderAll();


  goPage(
    "dashboard"
  );


  installScenezyImageUploader();


  if (
    !SUPABASE_READY
  ) {

    setCloudStatus(
      "error",
      "Key missing"
    );


    hideAdminAuth();


    toast(
      "Supabase key missing · running local cache mode"
    );


    return;
  }


  setCloudStatus(
    "syncing",
    "Checking…"
  );


  try {

    const session =
      await currentAdminSession();


    if (
      !session
    ) {

      showAdminAuth();

      return;
    }


    hideAdminAuth();


    await seedSupabaseIfEmpty();

    await hydrateAdminFromSupabase();

    startAdminRealtime();


  } catch (
    error
  ) {

    console.error(
      error
    );


    setCloudStatus(
      "error",
      "Using cache"
    );


    toast(
      "Cloud unavailable · using local cache"
    );

  }

}


/*
   Retry queued local changes when the browser comes online.
*/

window.addEventListener(
  "online",
  () => {

    queueSupabaseSync();

    hydrateAdminFromSupabase({
      quiet: true
    });

  }
);


boot();

</script>

