  margin-top: 11px;

  overflow: auto;

  padding: 12px;

  border-radius: 13px;

  color: #bac6ff;

  background: #08090d;

  border:
    1px solid
    var(--line);

  font:
    9px/1.55
    monospace;

  white-space: pre-wrap;
