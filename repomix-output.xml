function closeLandingScreen() {
  $("#landingScreen")
    ?.classList
    .remove("open");
}


function navigateScenezy(
  path,
  {
    replace = false
  } = {}
) {

  const target =
    scenezyCanonicalPath(
      normalizedScenezyPath(path)
    );


  const method =
    replace
    ?
    "replaceState"
    :
    "pushState";


  history[method](
    {
      scenezyRoute: true
    },
    "",
    target
  );


  syncScenezyRoute();
}


function syncScenezyRoute({
  afterRemote = false
} = {}) {

  const rawPath =
    normalizedScenezyPath();


  const path =
    scenezyCanonicalPath(
      rawPath
    );


  if (
    rawPath !== path
  ) {
    history.replaceState(
      {
        scenezyRoute: true,
        aliasFrom: rawPath
      },
      "",
      path
    );
  }


  if (
    SCENEZY_LANDING_ROUTES[path]
  ) {
    return renderLandingPage(path);
  }


  const event =
    eventFromRoute(path);


  if (event) {

    closeLandingScreen();
    closeScreens();

    state.returnPath =
      history.state?.returnPath ||
      "/";

    openDetail(
      event,
      {
        syncUrl: false,
        hapticFeedback: false
      }
    );

    return true;
  }


  if (
    /^\/events\/[^/]+$/.test(path)
  ) {

    if (
      afterRemote
    ) {
      history.replaceState(
        {
          scenezyRoute: true
        },
        "",
        "/"
      );

      closeLandingScreen();

      $("#detail")
        ?.classList
        .remove("open");

      state.current = null;

      restoreScenezyHomeSEO();

      toast(
        "That event is not live on Scenezy"
      );
    }

    return false;
  }


  if (
    path === "/"
  ) {

    closeLandingScreen();

    $("#detail")
      ?.classList
      .remove("open");

    state.current = null;

    restoreScenezyHomeSEO();

    return true;
  }


  if (
    afterRemote
  ) {
    history.replaceState(
      {
        scenezyRoute: true
      },
      "",
      "/"
    );

    closeLandingScreen();
    restoreScenezyHomeSEO();
  }


  return false;
}



