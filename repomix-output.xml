/* =========================================================
   DECK
========================================================= */

const stage =
  $("#stage");


const deck =
  $("#deck");


const cardElements = [];


function buildDeck() {

  deck.innerHTML = "";

  $("#deckDots")
    .innerHTML =
    "";


  cardElements.length = 0;


  EVENTS.forEach(
    (
      event,
      index
    ) => {

      const card =
        document.createElement(
          "article"
        );


      card.className =
        "eventCard";


      card.dataset.index =
        index;


      card.innerHTML =
        homeCardHTML(
          event
        );


      card
        .querySelector(
          ".cardSave"
        )
        .onclick =
        clickEvent => {

          clickEvent.stopPropagation();

          toggleSaved(
            event
          );

        };


      deck.appendChild(
        card
      );


      cardElements.push(
        card
      );


      const dot =
        document.createElement(
          "button"
        );


      dot.onclick =
        () =>
          settleDeck(
            index
          );


      $("#deckDots")
        .appendChild(
          dot
        );

    }
  );


  resizeDeck();

  renderDeck(
    state.position
  );

  syncHome(
    true
  );

}


function resizeDeck() {

  const width =
    stage.clientWidth;


  const height =
    stage.clientHeight;


  let cardHeight =
    Math.min(
      425,
      height -
      47
    );


  let cardWidth =
    cardHeight *
    .715;


  if (
    cardWidth >
    width *
    .80
  ) {

    cardWidth =
      width *
      .80;


    cardHeight =
      cardWidth /
      .715;

  }


  cardWidth =
    Math.max(
      244,
      cardWidth
    );


  cardHeight =
    Math.max(
      346,
      cardHeight
    );


  cardElements.forEach(
    card => {

      card.style.setProperty(
        "--cw",
        `${cardWidth}px`
      );


      card.style.setProperty(
        "--ch",
        `${cardHeight}px`
      );

    }
  );

}


function renderDeck(
  position,
  dragX = 0,
  dragY = 0
) {

  const half =
    TOTAL /
    2;


  cardElements.forEach(
    (
      card,
      index
    ) => {

      const offset =
        mod(
          index -
          position +
          half,
          TOTAL
        ) -
        half;


      const absolute =
        Math.abs(
          offset
        );


      const influence =
        Math.max(
          0,
          1 -
          absolute *
          1.4
        );


      const x =
        offset *
        106;


      const y =
        absolute *
        5 +
        offset *
        -2 +
        dragY *
        .08 *
        influence;


      const rotation =
        offset *
        5 +
        dragX *
        .021 *
        influence;


      const scale =
        1 -
        Math.min(
          absolute,
          1.7
        ) *
        .13;


      const opacity =
        absolute <=
        1
        ?
        1 -
        absolute *
        .27
        :
        Math.max(
          0,
          .73 -
          (
            absolute -
            1
          ) *
          .55
        );


      const blur =
        Math.max(
          0,
          absolute -
          .5
        ) *
        1.2;


      const brightness =
        1 -
        Math.min(
          absolute,
          1.7
        ) *
        .17;


      card.style.zIndex =
        String(
          80 -
          Math.round(
            absolute *
            10
          )
        );


      card.style.opacity =
        opacity;


      card.style.filter =
        `
          blur(${blur}px)
          brightness(${brightness})
        `;


      card.style.pointerEvents =
        absolute <
        1.55
        ?
        "auto"
        :
        "none";


      card.style.transform =
        `
          translate(
            calc(-50% + ${x}%),
            calc(-50% + ${y}px)
          )

          rotate(${rotation}deg)

          scale(${scale})
        `;

    }
  );

}


